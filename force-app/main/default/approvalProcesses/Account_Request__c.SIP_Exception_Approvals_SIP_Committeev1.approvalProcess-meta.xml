<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>Sales_Performance_Team</submitter>
        <type>group</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Type__c</field>
        <field>Number_of_Accounts_impacted__c</field>
        <field>Financial_Impact__c</field>
        <field>Justification__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>SIP_Status_Processing_Sales_Performance</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIPApproval_Status_Aproved_SIP_Committee</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>SIP_Committee_Head_of_S_D</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>SIP Exception - Sales Performance Approval SIP Committee Approval</description>
        <entryCriteria>
            <booleanFilter>1 OR (2 AND 3)</booleanFilter>
            <criteriaItems>
                <field>Account_Request__c.Number_of_Accounts_impacted__c</field>
                <operation>greaterOrEqual</operation>
                <value>5</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account_Request__c.Number_of_Accounts_impacted__c</field>
                <operation>lessThan</operation>
                <value>5</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account_Request__c.Financial_Impact__c</field>
                <operation>greaterOrEqual</operation>
                <value>&quot;AUD 5,000&quot;</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>SIP Exception - Sales Performance Approval SIP Committee Approval</label>
        <name>SIP_Exception_Sales_Performance_Approval_SIP_Committee_Approval</name>
        <rejectionActions>
            <action>
                <name>SIP_Approval_Status_as_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_as_Closed_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>SIP_Approval_Status_Approved_Head_of</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_Processing_Sales_Performance</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Head_of_Sales</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Head of approval - If Number of Accounts impacted? &lt; 5 &amp;&amp; Financial Impact &lt; 5,000</description>
        <entryCriteria>
            <criteriaItems>
                <field>Account_Request__c.Number_of_Accounts_impacted__c</field>
                <operation>lessThan</operation>
                <value>5</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account_Request__c.Financial_Impact__c</field>
                <operation>lessThan</operation>
                <value>&quot;AUD 5,000&quot;</value>
            </criteriaItems>
        </entryCriteria>
        <label>SIP Exception - Sales Performance Approval Head of Approval</label>
        <name>SIP_Exception_Sales_Performance_Approval_Head_of_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>SIP_Approval_Status_as_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_as_Closed_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>SIP Exception - Sales Performance Approval SIP Committee,Head Of Approval</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Account_Request__c.RecordType</field>
            <operation>equals</operation>
            <value>SIP Exception</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Request__c.Status__c</field>
            <operation>equals</operation>
            <value>Assigned to Sales Performance</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>SIP_Status_as_In_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>SIP Exception - Approvals SIP Committee</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
