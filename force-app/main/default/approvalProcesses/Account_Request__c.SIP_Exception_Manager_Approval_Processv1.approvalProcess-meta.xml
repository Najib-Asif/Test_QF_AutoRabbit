<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Type__c</field>
        <field>Number_of_Accounts_impacted__c</field>
        <field>Financial_Impact__c</field>
        <field>Justification__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>SIP_Approval_Status_Approved_NAM_SNAM</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_Assigned_to_Sales_Performance</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>SIP Exception - Manager Approval New Business</description>
        <entryCriteria>
            <criteriaItems>
                <field>User.Level__c</field>
                <operation>contains</operation>
                <value>SIP1</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>SIP Exception - Manager Approval New Business</label>
        <name>SIP_Exception_Manager_Approval_New_Business</name>
        <rejectionActions>
            <action>
                <name>SIP_Approval_Status_as_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_as_Closed_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>SIP_Approval_Status_Approved_NAM_SNAM</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_Assigned_to_Sales_Performance</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Manager_s_Manager__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>SIP Exception - Manager Approval (BD,B&amp;G)</description>
        <entryCriteria>
            <criteriaItems>
                <field>User.Level__c</field>
                <operation>contains</operation>
                <value>SIP2</value>
            </criteriaItems>
        </entryCriteria>
        <label>SIP Exception - Manager Approval (BD,B&amp;G)</label>
        <name>SIP_Exception_Manager_Approval_BD_B_G</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>SIP_Approval_Status_as_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>SIP_Status_as_Closed_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>SIP Exception -Manager Approval Process</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Account_Request__c.RecordType</field>
            <operation>equals</operation>
            <value>SIP Exception</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Request__c.Approval_Status__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Request__c.Status__c</field>
            <operation>equals</operation>
            <value>New</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>SIP_Status_as_In_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>SIP Exception -Manager Approval Process</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
