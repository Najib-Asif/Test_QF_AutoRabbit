<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Team leads do not need Team lead approval, it goes directly to NAM/Manager SBD approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>User.Manager_s_Role_ID__c</field>
                <operation>notEqual</operation>
                <value>00E90000001P7ax,00E90000001P6Kb,00E90000001P7am,00E90000001P6Lo,00E90000001P6Lj</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval by Team Lead</label>
        <name>Approval_by_Team_Lead</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Approval needs to go to NAM or Manager SBD</description>
        <entryCriteria>
            <criteriaItems>
                <field>User.UserRole</field>
                <operation>notEqual</operation>
                <value>QF-DOM-Sales-SME-QIS-Sr Manager,QF-DOM-Sales-B&amp;G-New Business VIC,QF-DOM-Sales-B&amp;G-New Business WA,QF-DOM-Sales-B&amp;G-New Business QLD,QF-DOM-Sales-B&amp;G-New Business NSW</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval by NAM/Manager SBD</label>
        <name>Approval_by_NAM_Manager_SBD</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Assign_to_Deal_Support_Queue</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>NAM_Approved_is_Ticked</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Status_update</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Approval by Head of QIS (for QIS users only)</description>
        <entryCriteria>
            <formula>CONTAINS( $UserRole.Name , &quot;QIS&quot;)</formula>
        </entryCriteria>
        <label>Approval by Head of QIS</label>
        <name>Approval_by_Head_of_QIS</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>This approval process is used for the deal support cases with type equal to deal extension or deal termination (US users)</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5</booleanFilter>
        <criteriaItems>
            <field>Case.NAM_s_Approval__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Type</field>
            <operation>equals</operation>
            <value>Deal Extension,Deal Termination</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Manager_s_Role_ID__c</field>
            <operation>notEqual</operation>
            <value>00E90000001P6J4,00E90000000b2Jz,00E90000000b2KO</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Deal Support Request</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Country</field>
            <operation>equals</operation>
            <value>US</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_asApproved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Assign_to_Deal_Support_Queue</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>NAM_Approved_is_Ticked</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_update</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_as_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_as_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Approval for Deal Ext and Term Case US</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Approval_Status_Change</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
