<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>Freight_AWB_Number__c</field>
        <field>Total_Adjustment_Due__c</field>
        <field>Justification__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Account_Owner__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Account Managers to approve anything under $ 250.00</description>
        <label>Account Manager Approval</label>
        <name>Account_Manager_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Regional_Manager_US</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Regional Managers to approve anything above $ 250.00</description>
        <entryCriteria>
            <booleanFilter>1 OR 2 OR  3 OR  4</booleanFilter>
            <criteriaItems>
                <field>Case.Total_Adjustment_Due__c</field>
                <operation>lessOrEqual</operation>
                <value>USD -251</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Total_Adjustment_Due__c</field>
                <operation>greaterOrEqual</operation>
                <value>USD 251</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Total_Adjustment_Due__c</field>
                <operation>lessOrEqual</operation>
                <value>CAD -251</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Total_Adjustment_Due__c</field>
                <operation>greaterOrEqual</operation>
                <value>CAD 251</value>
            </criteriaItems>
        </entryCriteria>
        <label>Approval from Regional Manager</label>
        <name>Approval_from_Regional_Manager</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Freight Cargo Billing Discrepancies related approval process for US</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND (3 OR 4 OR 7) AND 5 AND 6 AND 8 AND 9</booleanFilter>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>In Progress</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approved__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.CurrencyIsoCode</field>
            <operation>equals</operation>
            <value>USD</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.CurrencyIsoCode</field>
            <operation>equals</operation>
            <value>CAD</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Freight Invoicing</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Owner</field>
            <operation>notEqual</operation>
            <value>Freight Sales Support AU Queue</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Reject</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Type</field>
            <operation>equals</operation>
            <value>Billing Discrepancy</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Freight_Shipment__c</field>
            <operation>equals</operation>
            <value>Domestic</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Check_the_Approved_checkbox</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_to_QF_Rate_Audit</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_as_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Status_as_Waiting_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Cargo Billing - 2 Level Approvals - US</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Case_Status_to_In_progress</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
