<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>Type</field>
        <field>Sub_Type__c</field>
        <field>Justification__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Owner</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>For CSU0</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Approval_steps__c</field>
                <operation>equals</operation>
                <value>0</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.AWB_Refunded_Amount__c</field>
                <operation>greaterThan</operation>
                <value>AUD 200</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Auto Approval from submitter</label>
        <name>Auto_Approval_from_submitter</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Freight_Claims_Coordinator_approvals</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>For CSU1</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.AWB_Refunded_Amount__c</field>
                <operation>lessOrEqual</operation>
                <value>AUD 500</value>
            </criteriaItems>
        </entryCriteria>
        <label>Approval from Coordinators</label>
        <name>Approval_from_Coordinators</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>For approvals between 200 and 500</description>
    <emailTemplate>All_email_templates_LD/Freight_Claims_refund</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND 7 AND 8</booleanFilter>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Freight Claims,Qantas Freight</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approved__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>Assigned</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Created_by_Level__c</field>
            <operation>contains</operation>
            <value>CSU0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approval_steps__c</field>
            <operation>equals</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Claim_Stage__c</field>
            <operation>equals</operation>
            <value>Investigation</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.AWB_Refunded_Amount__c</field>
            <operation>greaterThan</operation>
            <value>AUD 200</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.AWB_Refunded_Amount__c</field>
            <operation>lessOrEqual</operation>
            <value>AUD 500</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Step_Increment</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Check_the_Approved_checkbox</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Freight_Claim_Approval_action</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approval_Step_reversal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Freight_Claim_Rejection_action</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Freight_Claim_approval_submission</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Freight Claim CSU1</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>33</processOrder>
    <recallActions>
        <action>
            <name>Approval_Step_reversal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Freight_Claim_Recall_action</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
