<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Groups_TLs</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Condition_Met__c</field>
                <operation>equals</operation>
                <value>No</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approval Needed if Within BART = No</label>
        <name>Approval_Needed_if_Within_BART_No</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Groups_Supervisors_Team</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Approvals for SAU, Excess Baggage, Lounge Access</description>
        <entryCriteria>
            <booleanFilter>1 OR 2 OR 3</booleanFilter>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>FOC Request,Lounge Access - Qantas Club,Lounge Access - Qantas First Lounge,Lounge Access - Qantas Domestic Business Lounge,Lounge Access - Qantas International Business Lounge,Excess Baggage</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Space Available Upgrade - Economy to Premium Economy,Space Available Upgrade - Economy to Business,Space Available Upgrade - Economy to First</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Space Available Upgrade - Premium Economy to Business,Space Available Upgrade - Premium Economy to First,Space Available Upgrade - Business to First</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Approvals for SAU, Excess Baggage, Lounge Access Level1</label>
        <name>Approvals_for_SAU_Excess_Baggage_Lounge_Access</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>kristinechippendale@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 OR 2 OR 3</booleanFilter>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Excess Baggage,FOC Request,Lounge Access - Qantas Club,Lounge Access - Qantas Domestic Business Lounge,Lounge Access - Qantas First Lounge,Lounge Access - Qantas International Business Lounge</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Space Available Upgrade - Business to First,Space Available Upgrade - Economy to Business,Space Available Upgrade - Economy to First</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Space Available Upgrade - Economy to Premium Economy,Space Available Upgrade - Premium Economy to Business,Space Available Upgrade - Premium Economy to First</value>
            </criteriaItems>
        </entryCriteria>
        <label>Approvals for SAU, Excess Baggage, Lounge Access Level2</label>
        <name>Approvals_for_SAU_Excess_Baggage_Lounge_Access_Level2</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Approval for Group Waiver SBT</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4</booleanFilter>
        <criteriaItems>
            <field>Case.Approval_Status__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Service Request</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Type</field>
            <operation>equals</operation>
            <value>Group Waivers,SBT</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account.BillingCountry</field>
            <operation>equals</operation>
            <value>AU</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_asApproved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Case_Status_to_In_progress</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Authority_Status_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_as_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>SR Approval Process for groups</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>user__c</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>6</processOrder>
    <recallActions>
        <action>
            <name>Approval_Status_Change</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
