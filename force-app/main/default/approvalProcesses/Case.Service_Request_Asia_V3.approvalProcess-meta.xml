<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>Account</field>
        <field>Problem_Type__c</field>
        <field>Description</field>
        <field>Cost_of_Sale__c</field>
        <field>CreatedDate</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ssmith@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Service Request  - Asia excl SG</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Account_Country__c</field>
                <operation>equals</operation>
                <value>ID,TH,KH,VN,MY,IN,Pakistan,PK,LK,JP</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Service Requests - Asia Majority</label>
        <name>Service_Requests_Asia_Majority</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>anthony.penney@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Service Request - PNG and Solomon</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Account_Country__c</field>
                <operation>equals</operation>
                <value>SB,PG</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Service Request - PNG and Solomon</label>
        <name>Service_Request_PNG_and_Solomon</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>lteo@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Service Request - Singapore</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Account_Country__c</field>
                <operation>equals</operation>
                <value>SG</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Service Request - Singapore</label>
        <name>Service_Request_Singapore</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>alanchang@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Service Request - South East Asia excl Korea</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Account_Country__c</field>
                <operation>equals</operation>
                <value>CN,HK,PH,TW</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Service Request - South East Asia excl Korea</label>
        <name>Service_Request_South_East_Asia_excl_Korea</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ryuta.nakayama@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Service Request - Korea</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Account_Country__c</field>
                <operation>equals</operation>
                <value>KR,KP</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Service Requests - Korea</label>
        <name>Service_Requests_Korea</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>sylviedimaio@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Service Request - French Polynesia</description>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Account_Country__c</field>
                <operation>equals</operation>
                <value>NC,FJ,PF,VU</value>
            </criteriaItems>
        </entryCriteria>
        <label>Service Request - French Polynesia</label>
        <name>Service_Request_French_Polynesia</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Service Request Approvals for countries in Asia excluding the Middle East. Ref CRM-6757, CRM-7621 for Japan CRM10288
CRM-11087</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Service Request</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approval_Status__c</field>
            <operation>notEqual</operation>
            <value>Approved,Pending</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Account_Country__c</field>
            <operation>equals</operation>
            <value>ID,KP,TH,KH,VN,MY,IN,SB,PG,SG,CN,HK,PH,TW,KR,NC,FJ,PF,VU,JP,Pakistan,PK,LK</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Profile_Name__c</field>
            <operation>equals</operation>
            <value>QL GSA,QL_Qantas_Sales,QL Qantas No Access,QL_Sales</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_asApproved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Authority_Status_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_as_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_as_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Service Request -Asia V3</label>
    <processOrder>14</processOrder>
    <recallActions>
        <action>
            <name>Approval_Status_Change</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
