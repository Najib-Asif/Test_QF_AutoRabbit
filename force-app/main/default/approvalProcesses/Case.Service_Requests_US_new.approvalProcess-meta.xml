<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>Account</field>
        <field>Problem_Type__c</field>
        <field>CreatedDate</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Last_Approved_By_update</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Recent_Approval_Date_Time</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>davidthomas@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>((1 OR 2 OR 3) AND 4) OR (5 OR (4 AND 6))</booleanFilter>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Space Available Upgrade - Economy to Premium Economy,Space Available Upgrade - Economy to Business,Space Available Upgrade - Economy to First</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Space Available Upgrade - Premium Economy to Business,Space Available Upgrade - Premium Economy to First,Space Available Upgrade - Business to First</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Lounge Access - Qantas First Lounge,Group/Family Qantas First Lounge Access,Group/Family Qantas Club Access,Excess Baggage,Lounge Access - Qantas Club</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Type</field>
                <operation>equals</operation>
                <value>Service Request</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Type</field>
                <operation>equals</operation>
                <value>Commercial Waiver (BART),Commercial Waiver (non BART),Operational Waiver</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Problem_Type__c</field>
                <operation>equals</operation>
                <value>Advance Seat Selection,Agent Discount Travel,Change of TMC,Prizewinner,Lounge Access - Qantas International Business Lounge</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>RGM North America Approval</label>
        <name>RGM_North_America_Approval</name>
    </approvalStep>
    <description>Approval process for all Service Requests raised by users based in America, Canada, Mexico and South America. Ref: CRM-6753</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Service Request</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Approval_Status__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Account.BillingCountry</field>
            <operation>equals</operation>
            <value>AG,AR,BO,BR,BS,BZ,CA,CL,CO,CU,DM,DO,EC,GD,GT,GY,HN,HT,JM,KN,LC,MX,NI,PE,PY,SR,TT,US,UY,VC,VE</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_asApproved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Assign_to_US_Sales_Support_Queue</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Assigned_to_US_Sales_Support</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_as_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_as_Pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_status_to_Waiting_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Service Request Approvals - Americas</label>
    <processOrder>13</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
