<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>QF_DOM</submitter>
        <type>roleSubordinatesInternal</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approval_Status_asApproved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Assign_to_QIC_Sales_Support_Queue</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Pending_with_Sales_Solutions</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Compliance_Queue</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Compliance Team</label>
        <name>Compliance_Team</name>
        <rejectionActions>
            <action>
                <name>Assign_to_QIC_Sales_Support_Queue</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>New_User_Rep_Acc_Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Rejected_by_AM</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>CRM-4609 - Based on the Risk chosen on the Case approvals will be flown
If Risk is low and  its rejected  - Approvals will be automatically submitted via Process Builder &quot;Case_Close_status_to_Chatter&quot; to Compliance Queue Team</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 3) AND 2</booleanFilter>
        <criteriaItems>
            <field>Case.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Ticketing Rejected</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>Ticketing Authority</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Risk__c</field>
            <operation>equals</operation>
            <value>High</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Assign_case_to_COmpliance_Queue</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Status_as_Waiting_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Ticketing Authority Compliance Team</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>40</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
