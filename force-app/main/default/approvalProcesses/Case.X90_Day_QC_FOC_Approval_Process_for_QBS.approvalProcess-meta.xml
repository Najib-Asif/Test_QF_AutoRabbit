<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>kate.younger@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case.Presence_of_Frequent_Flyer_Information__c</field>
                <operation>lessOrEqual</operation>
                <value>4</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 1 Approval</label>
        <name>Level_1_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>kate.younger@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>(1 AND 2) OR 3</booleanFilter>
            <criteriaItems>
                <field>Case.Presence_of_Frequent_Flyer_Information__c</field>
                <operation>greaterOrEqual</operation>
                <value>5</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Presence_of_Frequent_Flyer_Information__c</field>
                <operation>lessOrEqual</operation>
                <value>8</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.Presence_of_Frequent_Flyer_Information__c</field>
                <operation>lessOrEqual</operation>
                <value>4</value>
            </criteriaItems>
        </entryCriteria>
        <label>Level 2 Approval</label>
        <name>Level_2_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Approval process for Sales Offer Case with Sub Type - 90 Days QC FOC under Type = Adhoc.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND (5 OR 6)</booleanFilter>
        <criteriaItems>
            <field>Case.Sub_Type__c</field>
            <operation>equals</operation>
            <value>90 Days QC FOC,Gold Accelerate + 90 Days QC,Platinum Status acceleration + 90 day Qantas Club access</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Presence_of_Frequent_Flyer_Information__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Presence_of_Frequent_Flyer_Information__c</field>
            <operation>lessThan</operation>
            <value>9</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Type</field>
            <operation>equals</operation>
            <value>Adhoc</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Level__c</field>
            <operation>contains</operation>
            <value>SO(SME)</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Level__c</field>
            <operation>contains</operation>
            <value>SO(SPS)</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Status_asApproved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Assign_to_Sales_Solution_Queue</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Check_the_Approved_checkbox</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Last_Approved_By_update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Pending_with_Sales_Solutions</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Recent_Approval_Date_Time</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_as_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_as_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>90 Day QC FOC Approval Process for QBS</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Approval_Status_Change</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
