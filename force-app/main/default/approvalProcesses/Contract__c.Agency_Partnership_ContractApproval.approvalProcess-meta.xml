<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Account_Legal_Name__c</field>
        <field>Opportunity__c</field>
        <field>Active__c</field>
        <field>Contract_Start_Date__c</field>
        <field>Contract_End_Date__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Approval_status_approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <label>Submit to first level approval</label>
        <name>Submit_to_first_level_approval</name>
        <rejectionActions>
            <action>
                <name>Update_approval_status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_status_to_rejected_internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>contract_status_on_legal_status_clear</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>robharrison@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Submit to second level approval</label>
        <name>Submit_to_second_level_approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_status_to_rejected_internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval process for approving contract for Agency partnership Opportunity.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>ISPICKVAL(Opportunity__r.Type,&apos;Agency Partnerships&apos;) &amp;&amp;  OR(ISPICKVAL( Status__c , &apos;Draft&apos;),ISPICKVAL( Status__c , &apos;Rejected - Internal&apos;))</formula>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_approval_status_to_pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_to_approval_required_internal</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Agency Partnership Contract Approval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Update_approval_status_to_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
