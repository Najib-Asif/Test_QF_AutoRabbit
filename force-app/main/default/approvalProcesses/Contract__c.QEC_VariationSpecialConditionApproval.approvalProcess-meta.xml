<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Proposal__c</field>
        <field>Opportunity__c</field>
        <field>Domestic_Annual_Share__c</field>
        <field>International_Annual_Share__c</field>
        <field>Qantas_Annual_Expenditure__c</field>
        <field>Eligible_for_EK_ticket_stock__c</field>
        <field>Group_Booking__c</field>
        <field>Approval_Submission_Date__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>jamieli@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 OR 2 OR 3 OR 4</booleanFilter>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>JQ Inclusion</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Incentive Fare</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Route Deal</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.Eligible_for_EK_ticket_stock__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Special Conditions Approval - Deal Optimization</label>
        <name>Special_Conditions_Approval_Deal_Optimization</name>
        <rejectionActions>
            <action>
                <name>Update_status_to_rejected_internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>jamieli@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <booleanFilter>1 OR 2 OR 3 OR 4 OR 5 OR 6</booleanFilter>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Excess Baggage</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Penalties</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Advance Res/Ticketing</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Block Fare</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.QEC_Approval_Condition__c</field>
                <operation>contains</operation>
                <value>Fixed Fare</value>
            </criteriaItems>
            <criteriaItems>
                <field>Contract__c.Group_Booking__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <label>Special Condition Approval - Revenue Management</label>
        <name>Special_Condition_Approval_Revenue_Management</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_status_to_rejected_internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval process for contract special condition variation</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Contract__c.QEC_Approval_Required__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>contract_status_on_legal_status_clear</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_approval_status_to_pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_to_approval_required_internal</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>QEC_VariationSpecialConditionApproval</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>QEC_Update_Contract_Status_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_approval_status_to_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
