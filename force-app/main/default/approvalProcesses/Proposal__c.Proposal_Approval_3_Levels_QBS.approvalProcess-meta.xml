<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Opportunity__c</field>
        <field>Account__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Proposal_Approved_TeamLead</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_SBD_Approval_Required</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Team Lead</label>
        <name>Team_Lead</name>
        <rejectionActions>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_SBD_Approval_Required</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_TeamLead_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Proposal_SBD_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_SBD_Approved1</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.Approval_Required_Manager_SBD__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Manager, SBD Approval</label>
        <name>Escalated_to_Manager_SBD</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Proposal_QIS_Approved1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_SBD_Approved1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_SBD_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Proposal_QIS_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_QIS_Approved1</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.Escalate_To_Manager_QIS__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
            <criteriaItems>
                <field>Proposal__c.Status__c</field>
                <operation>equals</operation>
                <value>Approval Required - Internal</value>
            </criteriaItems>
        </entryCriteria>
        <label>Escalated to Manager, QIS</label>
        <name>Escalated_to_Manager_QIS</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Proposal_QIS_Approved1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_QIS_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>All_email_templates_LD/Proposal_Approval_required_for_additional_discount_on_discount</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Proposal__c.Type__c</field>
            <operation>equals</operation>
            <value>Qantas Business Savings</value>
        </criteriaItems>
        <criteriaItems>
            <field>Proposal__c.Approval_Required_Team_Lead__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Proposal__c.Active__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Proposal__c.Status__c</field>
            <operation>equals</operation>
            <value>Approval Required - Internal</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Proposal_Approval_Response_to_Submitter_Approved</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Proposal_Approval_Response_to_Submitter_Rejected</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Proposal Approval 3 Levels(QBS)</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
