<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Opportunity__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Proposal_NAM_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_NAM_Approved1</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Level 1 Approval - NAM/Manager-QIS Approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.Approval_Required_NAM__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 1 Approval</label>
        <name>Level_1_Approval</name>
        <rejectionActions>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Rejected_NAM</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Proposal_DO_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>amyxie@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>jamieli@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>reece.griffiths@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Level 2 Approval - DO Approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.Approval_Required_Deal_Optimization__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 2 Approval</label>
        <name>Level_2_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Proposal_Rejected_DO</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Proposal_Pricing_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Pricing_Approved1</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>amyxie@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>jamieli@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>reece.griffiths@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Level 3 - Pricing Approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.Approval_Required_Pricing__c</field>
                <operation>equals</operation>
                <value>True</value>
            </criteriaItems>
        </entryCriteria>
        <label>Level 3 Approval</label>
        <name>Level_3_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Rejected_Pricing</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Proposal Approval Process based on Level 3  i.e Approval&apos;s will go to NAM,DO,Pricing</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(ISPICKVAL(Status__c , &apos;Approval Required - Internal&apos;) , Active__c = True,  CONTAINS(CreatedBy.Level__c, &apos;P3&apos;))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Proposal_Approval_Response_to_Submitter_Approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Proposal_Status_Update_AR_Customer</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Proposal_Approval_Response_to_Submitter_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Proposal_Rejected_Internal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>true</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Proposal_Status_Update_AR_Internal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Proposal_Submission_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_Approved_by_SBD_c</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_DO_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_NAM_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_Pricing_Approved1</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_SBD_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Uncheck_Team_Lead_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>UncheckTeamLead_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Proposal Approval Process Level 3</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>true</useApproverFieldOfRecordOwner>
        <userHierarchyField>user__c</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Set_Approval_Status_to_Not_Required</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
