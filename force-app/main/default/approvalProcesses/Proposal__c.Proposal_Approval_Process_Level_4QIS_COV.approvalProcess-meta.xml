    <description>Single level Approval process for Domestic Tariff Changes - CRM 4468</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(OR(
AND(ISPICKVAL(Status__c , &apos;Draft&apos;) , Active__c = True, CONTAINS(CreatedBy.Level__c, &apos;P4(QIS)&apos;),ISPICKVAL( Type__c,&apos;Qantas Business Savings&apos;),Mandate_Business_Case__c = False),

AND(ISPICKVAL(Status__c , &apos;Draft&apos;) , Active__c = True, CONTAINS(CreatedBy.Level__c, &apos;P4(QIS)&apos;),ISPICKVAL(Travel_Fund__c,&apos;No&apos;),ISPICKVAL( Type__c,&apos;Corporate Airfares&apos;),Mandate_Business_Case__c = False),

AND(ISPICKVAL(Status__c , &apos;Draft&apos;) , Active__c = True, CONTAINS(CreatedBy.Level__c, &apos;P4(QIS)&apos;),ISPICKVAL( Type__c,&apos;Corporate Airfares&apos;),
AND(ISPICKVAL(Travel_Fund__c,&apos;Yes&apos;),
OR(NOT(No_of_Cps__c &gt; 1), NOT(ISNULL(No_of_Cps__c)))),Mandate_Business_Case__c = False)
)
,Opportunity__r.Owner.Country = &apos;AU&apos;)</formula>
    </entryCriteria>
