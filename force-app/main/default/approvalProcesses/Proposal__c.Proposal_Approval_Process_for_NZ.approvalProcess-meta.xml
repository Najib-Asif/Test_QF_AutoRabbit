    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Opportunity__c</field>
        <field>Domestic_Annual_Share__c</field>
        <field>International_Annual_Share__c</field>
        <field>Qantas_Annual_Expenditure__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_by_SBD</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Level_1_Approver</name>
                <type>FieldUpdate</type>
