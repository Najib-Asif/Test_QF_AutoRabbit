                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_NAM_Approved1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Pricing_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Pricing_Approved1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Team_Lead_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>david.cant@qantas.com.au.inactive</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.Type__c</field>
                <operation>equals</operation>
                <value>Corporate Airfares</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 1 Approval</label>
        <name>Level_1_Approval</name>
        <rejectionActions>
            <action>
                <name>Proposal_Rejected_Internal</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Level_1_Approver</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Level_1_Approver_DateTime</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_Approved_TeamLead</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Proposal_DO_Approved</name>
                <type>FieldUpdate</type>
            </action>
