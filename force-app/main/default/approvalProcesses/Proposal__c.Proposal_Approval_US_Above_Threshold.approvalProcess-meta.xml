<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Account__c</field>
        <field>Qantas_Annual_Expenditure__c</field>
        <field>International_Annual_Share__c</field>
        <field>Forecast_Flight_Share_US__c</field>
        <field>Reason_for_Discount__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>tomtaylor@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Level 1 approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>Proposal__c.CreatedBy</field>
                <operation>notEqual</operation>
                <value>Tom Taylor</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 1 Approval</label>
        <name>Level_1_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>seanwaters@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Level 3 Approval</description>
        <label>Level 3 Approval</label>
        <name>Level_3_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Above threshold approval for US based proposals</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(Opportunity__r.Owner.Country = &apos;US&apos;, Active__c, ISPICKVAL(Exceeds_Threshold__c , &apos;Yes&apos;))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approval_Completion_Date_TIme</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Proposal_Approval_Response_to_Submitter_Approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Proposal_Status_Update_AR_Customer</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Recalled_to_Not_Recalled</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Approval_Completion_Date_TIme</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Proposal_Approval_Response_to_Submitter_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Proposal_Rejected_Internal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Recalled_to_Not_Recalled</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Proposal_Status_Update_AR_Internal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Submitted</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Proposal_Submission_Date</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Proposal Approval US Above Threshold</label>
    <processOrder>9</processOrder>
    <recallActions>
        <action>
            <name>Set_Approval_Recalled_to_Recalled</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Approval_Status_to_Not_Required</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Proposal_status_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Record_Type_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
