<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Amount__c</field>
        <field>Freight_Category__c</field>
        <field>Description</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>colinchin@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>dalebaxter@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>emmybendezu@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>peterngo@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>smclellan@qantas.com.au</name>
                <type>user</type>
            </approver>
            <approver>
                <name>sonnysinpraseuth@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval from Pricing Team</label>
        <name>Approval_from_Pricing_Team</name>
    </approvalStep>
    <description>Approval from Freight Pricing Team</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Quote.Approval_Required__c</field>
            <operation>equals</operation>
            <value>Approval Level - 3</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Status</field>
            <operation>equals</operation>
            <value>Draft</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Category__c</field>
            <operation>equals</operation>
            <value>RB - Limited Availability Lanes,RB - Special Lane Pricing,RB - New Accounts Tier Assignment,RB - Change in Tier Assignment,RB - Spot Rates,RB - Partner Rates</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Approval_Step__c</field>
            <operation>notEqual</operation>
            <value>Approved</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_Approval_outcome</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Quote_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Quote_Approval_outcome</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Quote_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_submission</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Needs_Review</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Freight Quote Approval Level 3</label>
    <processOrder>3</processOrder>
    <recallActions>
        <action>
            <name>approval_submission_to_blank</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_back_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
