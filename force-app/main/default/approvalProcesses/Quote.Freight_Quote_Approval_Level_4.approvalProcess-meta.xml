<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Amount__c</field>
        <field>Freight_Category__c</field>
        <field>Description</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>jonathon.kerr@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval from Atlas Freighter Team</label>
        <name>Approval_from_Atlas_Freighter_Team</name>
    </approvalStep>
    <description>Approval from Freighter team</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5</booleanFilter>
        <criteriaItems>
            <field>Quote.Approval_Required__c</field>
            <operation>equals</operation>
            <value>Approval Level - 4</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Status</field>
            <operation>equals</operation>
            <value>Draft</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Category__c</field>
            <operation>equals</operation>
            <value>Freighter,Freighter - Spot Rates,Freighter - SLP</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Approval_Step__c</field>
            <operation>notEqual</operation>
            <value>Approved</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote.Specs_template_attached__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_Approval_outcome</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Quote_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Quote_Approval_outcome</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Quote_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Approval_submission</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Needs_Review</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_Value</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Freight Quote Approval Level 4</label>
    <processOrder>4</processOrder>
    <recallActions>
        <action>
            <name>approval_submission_to_blank</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_back_to_Draft</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
