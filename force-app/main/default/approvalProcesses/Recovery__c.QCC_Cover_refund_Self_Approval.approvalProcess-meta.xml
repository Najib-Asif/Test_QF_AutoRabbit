<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_Status_to_New</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <formula>0=1</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Auto Approval</label>
        <name>Auto_Approval</name>
    </approvalStep>
    <emailTemplate>QCC_Email_Templates/QCC_Approval_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND (3 AND 4)</booleanFilter>
        <criteriaItems>
            <field>Recovery__c.Type__c</field>
            <operation>equals</operation>
            <value>Cover Refund</value>
        </criteriaItems>
        <criteriaItems>
            <field>Recovery__c.RecordType</field>
            <operation>equals</operation>
            <value>Other Recovery</value>
        </criteriaItems>
        <criteriaItems>
            <field>Recovery__c.Monetary_Value__c</field>
            <operation>greaterOrEqual</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Recovery__c.Monetary_Value__c</field>
            <operation>lessOrEqual</operation>
            <value>99.99</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Approved_By_on_Recovery</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Process_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Process_Status_to_Finalised</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Recvy_Status_to_Approved_CvrRef</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_RecvyStatus_to_Finalised</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Update_Process_Status_ActionReq</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>QCC Cover refund Self Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>5</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
