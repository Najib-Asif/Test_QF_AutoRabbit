<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Status__c</field>
        <field>Type__c</field>
        <field>Value__c</field>
        <field>Amount__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_previous_approvers_ID</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_TL_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Recovery__c.Monetary_Value__c</field>
                <operation>greaterOrEqual</operation>
                <value>100</value>
            </criteriaItems>
            <criteriaItems>
                <field>Recovery__c.Monetary_Value__c</field>
                <operation>lessOrEqual</operation>
                <value>500</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 1 Approval $100-$500</label>
        <name>Level_1_Approval_100_500</name>
        <rejectionActions>
            <action>
                <name>Update_TL_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Update_OM_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Recovery__c.Monetary_Value__c</field>
                <operation>greaterOrEqual</operation>
                <value>500.01</value>
            </criteriaItems>
            <criteriaItems>
                <field>Recovery__c.Monetary_Value__c</field>
                <operation>lessOrEqual</operation>
                <value>5000.00</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Level 2 Approval $500.01 - $5000.00</label>
        <name>Level_2_Approval_500_01_5000_00</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Update_OM_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>tez.ali@qantas.com.au</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Recovery__c.Monetary_Value__c</field>
                <operation>greaterOrEqual</operation>
                <value>5000.01</value>
            </criteriaItems>
        </entryCriteria>
        <label>Leve 3 Approval $5000.01+</label>
        <name>Leve_3_Approval_5000_01</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>CRM - 4821 - Cover Refund Approvals</description>
    <emailTemplate>QCC_Email_Templates/QCC_Approval_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Recovery__c.Type__c</field>
            <operation>equals</operation>
            <value>Cover Refund</value>
        </criteriaItems>
        <criteriaItems>
            <field>Recovery__c.RecordType</field>
            <operation>equals</operation>
            <value>Other Recovery</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Update_Approved_By_on_Recovery</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Process_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Set_Retrigger_Approval_Flag</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Process_Status_ActionReq</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>QCC cover refund Approvals</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>4</processOrder>
    <recallActions>
        <action>
            <name>Set_Retrigger_Approval_Flag</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_OM_Approved_Recall</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Process_Status_to_New</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_TL_Approved_Recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
