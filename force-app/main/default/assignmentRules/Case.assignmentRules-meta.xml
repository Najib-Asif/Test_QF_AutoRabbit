    <assignmentRule>
        <fullName>Auto Assign to Escalation Queue</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>QCC_QANTAS_VIP_Pre_Flight_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>( 				( 								( 												OR( 																ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Platinum One&quot;), 																ISPICKVAL(Contact.Frequent_Flyer_Tier__c,&quot;Chairman&apos;s Lounge Platinum One&quot;), 																ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairman&apos;s Lounge&quot;), 																ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairmans Lounge Platinum One&quot;), 																ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairmans Lounge&quot;) 												)  												|| Contact.SSU__c = TRUE 												|| 												OR( 																TEXT(Contact.QCC_Effective_Tier__c)= &quot;FFLP&quot;, 																TEXT(Contact.QCC_Effective_Tier__c)= &quot;CLPP&quot; )  								)   								&amp;&amp; 								OR( 												ISPICKVAL(Type, &quot;Review Complimentary Upgrade - Meal&quot;), 												ISPICKVAL(Type, &quot;Review Complimentary Upgrade - Special Assistance&quot;), 												ISPICKVAL(Type, &quot;Review Complimentary Upgrade - Watchlist&quot;), 												ISPICKVAL(Type, &quot;Pre-Flight Watchlist Check&quot;), 												ISPICKVAL(Type, &quot;Watch list is Expiring&quot;) 								) 				)  				|| 				OR( 								ISPICKVAL(Type,&quot;Qantas Host Always Call&quot; ), 								ISPICKVAL(Type, &quot;Qantas Host Call&quot;), 								ISPICKVAL(Type, &quot;Qantas First Spa Lounge&quot;), 								ISPICKVAL(Type, &quot;PNR Health Check&quot;), 								ISPICKVAL(Type, &quot;PNR Health Check - Watchlist&quot;) 				) ) &amp;&amp; RecordType.DeveloperName = &quot;QCC_Elite_Process&quot;</formula>
        </ruleEntry>
        <ruleEntry>
            <formula>AND( ISNEW(),     OR(RecordType.DeveloperName = &apos;Freight_Claims&apos;, RecordType.DeveloperName = &apos;Freight_Email_to_Case&apos;, RecordType.DeveloperName = &apos;Freight_Feedback&apos;,  RecordType.DeveloperName = &apos;Freight_Invoicing&apos;, RecordType.DeveloperName = &apos;Freight_Query&apos;, RecordType.DeveloperName = &apos;Freight_Shipment&apos;,   RecordType.DeveloperName = &apos;Freight_Track_Trace_Exceptions&apos;, RecordType.DeveloperName = &apos;Qantas_Freight&apos;),    ISPICKVAL(Origin, &apos;FRT Phone&apos;),  AND(Created_By_Name__c != &apos;System Admin Updates&apos;, Created_By_Name__c != &apos;Freight Integration User&apos;, Created_By_Name__c != &apos;Freight Customer Feedback User&apos;)     )</formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>QCC_QANTAS_VIP_Milestone_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>( 				OR( 							ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Platinum One&quot;), 							ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairman&apos;s Lounge Platinum One&quot;), 							ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairman&apos;s Lounge&quot;), 							ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairmans Lounge Platinum One&quot;), 							ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairmans Lounge&quot;) 						) 						|| Contact.SSU__c = TRUE 						|| OR( 								TEXT(Contact.QCC_Effective_Tier__c)= &quot;FFLP&quot;, 								TEXT(Contact.QCC_Effective_Tier__c)= &quot;CLPP&quot; ) 					) 					&amp;&amp;  						OR( 							ISPICKVAL(Type,&quot;Welcome to Platinum One&quot; ), 							ISPICKVAL(Type,&quot;Retain Platinum One&quot;), 							ISPICKVAL(Type,&quot;Welcome to SSU&quot;), 							ISPICKVAL(Type,&quot;Welcome to Life Time Platinum&quot;) 						) 					&amp;&amp;  					RecordType.DeveloperName = &quot;QCC_Elite_Process&quot;</formula>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>QCC_QANTAS_VIP_General_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>AND( 				OR( 					OR( 						ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Platinum One&quot;), 						ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairman&apos;s Lounge Platinum One&quot;), 						ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairman&apos;s Lounge&quot;), 						ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairmans Lounge Platinum One&quot;), 						ISPICKVAL(Contact.Frequent_Flyer_Tier__c, &quot;Chairmans Lounge&quot;) 						), 					Contact.SSU__c  = TRUE 					|| OR( 							TEXT(Contact.QCC_Effective_Tier__c)= &quot;FFLP&quot;, 							TEXT(Contact.QCC_Effective_Tier__c)= &quot;CLPP&quot;)			 	 					), 				OR( 					ISPICKVAL(Type,&quot;Potential Downgrade&quot; ), 					ISPICKVAL(Type,&quot;Quarterly Health Check Call&quot; ), 					ISPICKVAL(Type,&quot;No Flight Health Check&quot; ) 					), 					 				RecordType.DeveloperName = &quot;QCC_Elite_Process&quot; 				)</formula>
