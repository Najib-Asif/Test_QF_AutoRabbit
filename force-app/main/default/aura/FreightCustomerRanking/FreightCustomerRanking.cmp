<aura:component controller="FreightCustomerRankingController" implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId" >
    
    <aura:attribute name="recordId" type="Id" />
    
    <!-- Handler to run from JS Controller -->	
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    <aura:attribute name="acc" type="Account"/>
    <aura:attribute name="recName" type="String"/>
    
    <article class="slds-card">
        
        <aura:if isTrue="{!v.recName == 'Freight'}">
            
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__figure">
                        <span class="slds-icon_container slds-icon-standard-contact" title="Account">
                            <lightning:icon iconName="standard:account" size="small"/>
                        </span>
                    </div>
                    <div class="slds-media__body">
                        <h2>
                            <a href="{!'/' + v.acc.Id}" class="slds-card__header-link slds-truncate" title="Account Ranking Details">
                                <span class="slds-text-heading_small">Account Ranking Details</span>
                            </a>
                        </h2>
                    </div>
                </header>
            </div>
            
            <div class="slds-card__body">
                <div class="slds-card__body--inner">
                    <div class="slds-tile">
                        <div class="slds-tile__detail slds-text-body--small">
                            <div class="slds-form slds-form_compound">
                                
                                <fieldset class="slds-form-element">
                                    <div class="slds-form-element__group">
                                        <div class="slds-form-element__row">
                                            <div class="slds-form-element slds-size_1-of-1">
                                                <span class="slds-form-element__label">Customer Rank:</span>
                                                <div class="slds-form-element__control slds-has-divider--bottom">
                                                    <span class="slds-form-element__static">
                                                        <ui:outputRichText value="{!v.acc.Customer_Rank__c}" />
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                                
                                <fieldset class="slds-form-element">
                                    <div class="slds-form-element__group">
                                        <div class="slds-form-element__row">
                                            <div class="slds-form-element slds-size_1-of-1">
                                                <span class="slds-form-element__label">Sentiment Indicator:</span>
                                                <div class="slds-form-element__control">
                                                    <span class="slds-form-element__static">
                                                        <ui:outputRichText value="{!v.acc.Sentiment2__c}" />
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <aura:set attribute="else">
                
                <div class="slds-card__header slds-grid">
                    <header class="slds-media slds-media_center slds-has-flexi-truncate">
                        <div class="slds-media__figure">
                            <span class="slds-icon_container slds-icon-standard-contact" title="Account">
                                <lightning:icon iconName="standard:account" size="small"/>
                            </span>
                        </div>
                        <div class="slds-media__body">
                            <h2>
                                <a href="{!'/' + v.acc.Id}" class="slds-card__header-link slds-truncate" title="Customer Value">
                                    <span class="slds-text-heading_small">Travel Agency</span>
                                </a>
                            </h2>
                        </div>
                    </header>
                </div>
                
                <div class="slds-card__body">
                    <div class="slds-card__body--inner">
                        <div class="slds-tile">
                            <div class="slds-tile__detail slds-text-body--small">
                                <div class="slds-form slds-form_compound">
                                    
                                    <fieldset class="slds-form-element">
                                        <div class="slds-form-element__group">
                                            <div class="slds-form-element__row">
                                                <div class="slds-form-element slds-size_1-of-2">
                                                    <span class="slds-form-element__label">QIC ID</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static" style="font-size:23px;font-weight:bold;">
                                                            {!v.acc.Qantas_Industry_Centre_ID__c}
                                                        </span>                                           
                                                    </div>
                                                </div>
                                                <div class="slds-form-element slds-size_1-of-2">
                                                    <span class="slds-form-element__label">Tier</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static">
                                                            <ui:outputRichText value="{!v.acc.Customer_Account_Tier_f__c}" />
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                    <fieldset class="slds-form-element">
                                        <div class="slds-form-element__group">
                                            <div class="slds-form-element__row">
                                                <div class="slds-form-element slds-size_1-of-1">
                                                    <span class="slds-form-element__label">Account Name</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static" >
                                                            {!v.acc.Name}
                                                        </span>                                           
                                                    </div>
                                                </div>   
                                            </div>
                                        </div>
                                    </fieldset>
                                    <fieldset class="slds-form-element">
                                        <div class="slds-form-element__group">
                                            <div class="slds-form-element__row">
                                                <div class="slds-form-element slds-size_1-of-1">
                                                    <span class="slds-form-element__label">Country</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static">
                                                            <!-- <ui:outputRichText value="{!v.acc.BillingCountry}" /> -->
                                                            {!v.acc.BillingCountry}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </aura:set>
        </aura:if>
        
    </article>    
</aura:component>