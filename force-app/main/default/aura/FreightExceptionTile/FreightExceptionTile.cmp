<aura:component controller="FreightExceptionTileController" implements="flexipage:availableForAllPageTypes,force:hasRecordId">

    <aura:attribute name="messageError" type="Boolean" default="false"/>
    <aura:attribute name="message" type="String"/>
    <aura:attribute name="recordId" type="String"/>
	<aura:handler name="init" action="{!c.doInit}" value="{!this}" />
    <aura:attribute name="Exceptioncase" type="Case"/>
	
    <article class="slds-card">
        
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-contact" title="Case">
                        <lightning:icon iconName="standard:case" size="small"/>
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2>
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="Case Details">
                            <span class="slds-text-heading_small">Exception Details</span>
                        </a>
                    </h2>
                </div>
            </header>
        </div>
        
        <aura:if isTrue="{!v.messageError}">
            <!-- Load error -->
            <div class="userCreateError">
                <ui:message title="Error" severity="error" closable="true">
                    <ui:outputText value="{!v.message}"/>
                </ui:message>
            </div>
        </aura:if>
		<aura:if  isTrue="{!v.Exceptioncase.Sub_Type_1__c =='Unmanifested ULD'}" >
        
        <div class="slds-card__body">
            <div class="slds-card__body--inner">
                <div class="slds-tile">
                    <div class="slds-tile__detail slds-text-body--small">
                        
                        <div class="slds-form slds-form_compound">
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">ULD # </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_ULD_Number__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">AWBs # </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_AWB_s__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Customer Name </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Customer_Name__c}</span>
                                            </div>
                                        </div>  
                                    </div>
                                </div>
                            </fieldset>
							<fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Customer No </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Customer_No__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight No </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Booked_Flight_No__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight No </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Arrival_Flight_No__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight Date Time </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static"><ui:outputDateTime value= "{!flight.Freight_Booked_Flight_Date_Time__c}"/></span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight Date Time </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static"><ui:outputDateTime value= "{!flight.Freight_Arrival_Flight_Date_Time__c}"/></span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight Origin </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Booked_Flight_Origin__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight Origin </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Arrival_Flight_Origin__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight Destination </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Booked_Flight_Destination__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight Destination </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Arrival_Flight_Destination__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned By </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Scanned_By__c}</span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned Location </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Scanning_Location__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned Date Time</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static"><ui:outputDateTime value= "{!v.Exceptioncase.Freight_Scanned_Time__c}"/></span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Port </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Port__r.Name}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned before </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Scanned_Before__c}</span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned before time</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static"><ui:outputDateTime value= "{!v.Exceptioncase.Freight_Scanned_before_time__c}"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </aura:if>
        
        <aura:if  isTrue="{!or(v.Exceptioncase.Sub_Type_1__c =='Found AWB (from Unmanifested ULD)', v.Exceptioncase.Sub_Type_1__c =='Found AWB')}" >
        
        <div class="slds-card__body">
            <div class="slds-card__body--inner">
                <div class="slds-tile">
                    <div class="slds-tile__detail slds-text-body--small">
                        
                        <div class="slds-form slds-form_compound">
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">ULD # </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_ULD_Number__c}</span>
                                            </div>
                                        </div>
										<div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">AWB #</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_AWB_Number__c}</span>
                                            </div>
                                        </div>
                                        
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Customer Name </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Customer_Name__c}</span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Customer No </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Customer_No__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight No </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Booked_Flight_No__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight No </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Arrival_Flight_No__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight Date Time </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static"><ui:outputDateTime value= "{!flight.Freight_Booked_Flight_Date_Time__c}"/></span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight Date Time </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static"><ui:outputDateTime value= "{!flight.Freight_Arrival_Flight_Date_Time__c}"/></span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight Origin </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Booked_Flight_Origin__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight Origin </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Arrival_Flight_Origin__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Booked Flight Destination </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Booked_Flight_Destination__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Arrival Flight Destination </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <aura:iteration items="{!v.Exceptioncase.Flights__r}" var="flight">
                                                    <span class="slds-form-element__static">{!flight.Freight_Arrival_Flight_Destination__c}</span>
                                                </aura:iteration>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Origin </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Origin__c}</span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Destination </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Destination__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                             <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Weight </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                   <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Weight__c}</span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Stated Pieces </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Stated_Pieces__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned By </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Scanned_By__c}</span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned Location </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Scanning_Location__c}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Scanned Date Time</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static"><ui:outputDateTime value= "{!v.Exceptioncase.Freight_Scanned_Time__c}"/></span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Port </span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">{!v.Exceptioncase.Freight_Port__r.Name}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </aura:if>

        <aura:if  isTrue="{!v.Exceptioncase.Sub_Type_1__c =='Missing ULD'}" >
        
        <div class="slds-card__body">
            <div class="slds-card__body--inner">
                <div class="slds-tile">
                    <div class="slds-tile__detail slds-text-body--small">
                        
                        <div class="slds-form slds-form_compound">
                            
