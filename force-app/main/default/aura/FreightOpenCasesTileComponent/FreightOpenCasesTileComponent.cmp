<aura:component controller="FreightOpenCasesController" implements="flexipage:availableForAllPageTypes,force:hasRecordId">
    <aura:handler name="init" action="{!c.doInit}" value="{!this}" />
    <aura:attribute name="AllOpenCases" type="Case[]" />
    
    <article class="slds-card">
        
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-contact" title="case">
                        <lightning:icon iconName="standard:case" size="small"/>
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2>
                        <a href="#" class="slds-card__header-link slds-truncate" title="Open Cases">
                            <span class="slds-text-heading_small">Open Cases</span>
                        </a>
                    </h2>
                </div>
                
            </header>
        </div>
        
        <div class="slds-card__body">
            <div class="slds-card__body--inner">
                <div class="slds-tile">
                    <ul class="slds-has-dividers_around-space">
                        <aura:iteration items="{!v.AllOpenCases}" var="cases">
                            <li class="slds-item">
                                <article class="slds-tile slds-tile_board">
                                    <h3 class="slds-truncate" title="{!cases.CaseNumber}"><a href="{!'/' + cases.Id}">{!cases.CaseNumber}</a></h3>
                                    <div class="slds-tile__detail slds-text-body_small">
                                        
                                        <dl class="slds-list--horizontal slds-wrap">
                                            <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Type">
                                                Type:
                                            </dt>
                                            
                                            <dd class="slds-item--detail slds-truncate" title="{!cases.Type}">
                                                {!cases.Type}
                                            </dd>       
                                        </dl>
                                        
                                        <dl class="slds-list--horizontal slds-wrap">
                                            <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Sub Type 1">
                                                Sub Type 1:
                                            </dt>
                                            
                                            <dd class="slds-item--detail slds-truncate" title="{!cases.Sub_Type_1__c}">
                                                {!cases.Sub_Type_1__c}
                                            </dd>       
                                        </dl>
                                        
                                        <dl class="slds-list--horizontal slds-wrap">
                                            <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Sub Type 2">
                                                Sub Type 2:
                                            </dt>
                                            
                                            <dd class="slds-item--detail slds-truncate" title="{!cases.Sub_Type_2__c}">
                                                {!cases.Sub_Type_2__c}
                                            </dd>       
                                        </dl>
                                        
                                        <label class="slds-form-element__label" for="subject">Subject: </label>
                                        <p class="slds-truncate" aura:id="subject" title="Subject">{!cases.Subject}</p>
                                        
                                        <span class="slds-icon_container slds-tile_board__icon" title="Case Flag">
                                            <aura:unescapedHtml value="{!cases.Freight_Case_Status_Flag__c}" />
                                            <span class="slds-assistive-text">Flag</span>
                                        </span>
                                        
                                    </div>
                                </article>
                            </li>
                        </aura:iteration>
                    </ul>
                </div>
            </div>
        </div>		
    </article>
</aura:component>