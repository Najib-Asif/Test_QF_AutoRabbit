<aura:component Controller="FreightexceptionAWBdetailsController" Implements="flexipage:availableForRecordHome,force:hasRecordId">
    
    <aura:attribute name="messageError" type="Boolean" default="false"/>
    <aura:attribute name="message" type="String"/>
    <!-- init aura:handler action[doInit] auto call on component load -->  
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="Exceptioncase" type="Case"/>
    <aura:attribute name="recordId" type="String"/>
    
    <article class="slds-card">
        
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-contact" title="Case">
                        <lightning:icon iconName="standard:case" size="small"/>
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2>
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="Case Details">
                            <span class="slds-text-heading_small">List of AWB's associated with this Case</span>
                        </a>
                    </h2>
                </div>
            </header>
        </div>
        
        <aura:if isTrue="{!v.messageError}">
            <!-- Load error -->
            <div class="userCreateError">
                <ui:message title="Error" severity="error" closable="true">
                    <ui:outputText value="{!v.message}"/>
                </ui:message>
            </div>
        </aura:if>
		<aura:if  isTrue="{!v.Exceptioncase.Sub_Type_1__c =='ULD wrong location'}">
            
            <div class="slds-m-around--x-small">
                <table class="slds-table slds-table--bordered slds-table--striped slds-table--cell-buffer slds-table--fixed-layout">
                    <thead>
                        <tr class="slds-text-heading--label">
                            <th scope="col">
                                <div class="slds-truncate" title="AWB">AWB</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="Handling code">Handling code</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="Pieces">Pieces</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration items="{!v.Exceptioncase.Cases}" var="rec" indexVar="index">
                            <tr>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_AWB_Number__c}"><a onclick="{!c.navigateToRecord}" style="width:100%;" data-index="{!index}">{!rec.Freight_AWB_Number__c}</a></div>
                                </td>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_AWB_Handling_Code__c}">{!rec.Freight_AWB_Handling_Code__c}</div>
                                </td>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_AWB_Pieces__c}">{!rec.Freight_AWB_Pieces__c}</div>
                                </td>
                            </tr>
                        </aura:iteration>
                    </tbody>
                </table>
            </div>
        </aura:if>
        
        <aura:if  isTrue="{!or(v.Exceptioncase.Sub_Type_1__c =='Unmanifested ULD', v.Exceptioncase.Sub_Type_1__c =='Missing ULD')}" >
            
            <div class="slds-m-around--x-small">
                <table class="slds-table slds-table--bordered slds-table--striped slds-table--cell-buffer slds-table--fixed-layout">
				    <thead>
                        <tr class="slds-text-heading--label">
                            <th scope="col">
                                <div class="slds-truncate" title="AWB">AWB</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="Customer Name">Customer Name</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration items="{!v.Exceptioncase.Cases}" var="rec" indexVar="index">
                            <tr>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_AWB_Number__c}"><a onclick="{!c.navigateToRecord}" style="width:100%;" data-index="{!index}">{!rec.Freight_AWB_Number__c}</a></div>
                                </td>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_Customer_Name__c}">{!rec.Freight_Customer_Name__c}</div>
                                </td>
                            </tr>
                        </aura:iteration>
                    </tbody> 
                </table>
            </div>
        </aura:if>
		<aura:if  isTrue="{!v.Exceptioncase.Sub_Type_1__c =='Unable to locate ULD in warehouse'}">
            
            <div class="slds-m-around--x-small">
                <table class="slds-table slds-table--bordered slds-table--striped slds-table--cell-buffer slds-table--fixed-layout">
				    <thead>
                        <tr class="slds-text-heading--label">
                            <th scope="col">
                                <div class="slds-truncate" title="AWB">AWB</div>
                            </th>
                            <th scope="col">
                                <div class="slds-truncate" title="Customer Name">Customer Name</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration items="{!v.Exceptioncase.Cases}" var="rec" indexVar="index">
                            <tr>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_AWB_Number__c}"><a onclick="{!c.navigateToRecord}" style="width:100%;" data-index="{!index}">{!rec.Freight_AWB_Number__c}</a></div>
                                </td>
                                <td>
                                    <div class="slds-truncate" title="{!rec.Freight_Customer_Name__c}">{!rec.Freight_Customer_Name__c}</div>
                                </td>
                            </tr>
                        </aura:iteration>
                    </tbody> 
                </table>
            </div>
        </aura:if>
    </article>
</aura:component>