<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" controller="KMNavigationalMenuController" access="global">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="items" type="Object"/>
    <aura:attribute name="topicName" type="string"/>
      <div>
          <div class="slds-text-title_bold">  
                 <lightning:tree items="{!v.items}" onselect ="{!c.handleClick}"/> 
            </div>
       </div>
</aura:component>