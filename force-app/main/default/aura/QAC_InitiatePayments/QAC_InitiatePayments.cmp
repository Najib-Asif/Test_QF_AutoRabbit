<aura:component controller="QAC_InitiatePaymentsController" implements="flexipage:availableForAllPageTypes,force:hasRecordId,force:lightningQuickActionWithoutHeader">
    
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="menuSwitch" type="Boolean" default="false" />
    <aura:attribute name="existingSP" type="Service_Payment__c"/>
    <aura:handler name="init" action="{!c.doInit}" value="{!this}" />
    <aura:handler event="force:refreshView" action="{!c.doInit}" />
    <aura:attribute name="editFields" type="Boolean" default="false" />
    
    <article class="slds-card">
        
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-contact" title="Payments">
                        <lightning:icon iconName="custom:custom17" size="small"/>
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2>
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="Payment Process">
                            <span class="slds-text-heading_small">Payment</span>
                        </a>
                    </h2>
                </div>
                
                <ul class="slds-button-group-row">
                    <li class="slds-button-group-item">
                        <div class="slds-no-flex" >
                            <button  onclick="{!c.editValue}" class="slds-button editButton slds-button_icon slds-button_icon-border-filled slds-button_icon-x-small" disabled="{!v.existingSP.Payment_Status__c == 'Pending' ? 'false' : 'true'}" title="Edit">
                                <lightning:icon iconName="utility:edit" size="xx-small" />
                            </button>
                        </div>    
                    </li>
                    <li class="slds-button-group-item">
                        <!-- Refresh Icon --> 
                        <div class="slds-no-flex">
                            <button onclick="{!c.refresh}" class="slds-button refreshButton" title="Refresh">
                                <img src="{!$Resource.QACResources +'/QAC_RefreshIcon.png'}" height="18" width="18"/>	
                            </button>
                        </div>
                    </li>
                    <li class="slds-button-group-item">
                        <!-- we need to add that drop down for Initiate Payments -->
                        <div class="slds-no-flex slds-dropdown-trigger slds-dropdown-trigger_click slds-is-open" onclick="{!c.toggleMenu}">
                            
                            <button class="slds-button slds-button_icon slds-button_icon-border-filled slds-button_icon-x-small" aria-haspopup="true" title="Actions">
                                <lightning:icon iconName="utility:down" size="x-small"/> 
                                <span class="slds-assistive-text">Initiate Payments</span>
                            </button>
                            
                            <aura:if isTrue="{!v.menuSwitch}">
                                <div class="slds-dropdown slds-dropdown_right slds-dropdown_actions">
                                    <ul class="slds-dropdown__list" role="menu" aria-label="Show More">
                                        
                                        <li class="slds-dropdown__item" role="presentation">
                                            <a role="menuitem" tabindex="0" onclick="{!c.doPay}">
                                                <span class="slds-truncate" title="Initiate Payment">
                                                    <!-- <lightning:icon iconName="custom:custom17" size="x-small"/> -->
                                                    Initiate Payment
                                                </span>
                                            </a>
                                        </li>
                                        
                                    </ul>
                                </div>
                            </aura:if>
                        </div>
                    </li>
                </ul>
                
            </header>
        </div>
        
        <div class="slds-card__body">
            <div class="slds-card__body--inner">
                <div class="slds-tile">
                    <div class="slds-tile__detail slds-text-body--small">
                        <div class="slds-form slds-form_compound">
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Work Order</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <a href="{!'/' + v.existingSP.Work_Order__c}" title="Click to view Work Order">
                                                    <span style="color: rgb(0, 109, 204);" class="slds-form-element__static">
                                                        {!v.existingSP.Work_Order__r.WorkOrderNumber}
                                                    </span>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Payment Number</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <a href="{!'/' + v.existingSP.Id}" title="Click to view Service Payments">
                                                    <span style="color: rgb(0, 109, 204);" class="slds-form-element__static">
                                                        {!v.existingSP.Name}
                                                    </span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Total Amount</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">
                                                    {!v.existingSP.Total_Amount_with_Currency__c}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Total Payable credits</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">
                                                    {!v.existingSP.Total_Payable_credits__c}
                                                </span>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <aura:if isTrue="{!v.editFields}">
                                            <div class="slds-form-element slds-size_1-of-2">
                                                <!--Payment If Type-->
                                                <lightning:recordEditForm aura:id="editFormPT" objectApiName="Service_Payment__c">
                                                    <lightning:layout>
                                                        <lightning:layoutitem>
                                                            <lightning:inputfield aura:id="editFormPtValue" fieldName="Payment_Type__c" value=""/>    
                                                        </lightning:layoutitem>
                                                    </lightning:layout>
                                                </lightning:recordEditForm>            
                                            </div>
                                            <aura:set attribute = "else">
                                                <div class="slds-form-element slds-size_1-of-2">
                                                    <span class="slds-form-element__label">Payment Type</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static">
                                                            {!v.existingSP.Payment_Type__c}
                                                        </span>
                                                    </div>
                                                </div> 
                                            </aura:set>
                                        </aura:if>
                                        <div class="slds-form-element slds-size_1-of-2">
                                            <span class="slds-form-element__label">Payment Status</span>
                                            <div class="slds-form-element__control slds-has-divider--bottom">
                                                <span class="slds-form-element__static">
                                                    <strong>{!v.existingSP.Payment_Status__c}</strong>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <aura:if isTrue="{!v.editFields}">
                                            <div class="slds-form-element slds-size_1-of-2">
                                                <!--Payment If Type-->
                                                <lightning:recordEditForm aura:id="editFormEN" objectApiName="Service_Payment__c">
                                                    <lightning:layout>
                                                        <lightning:layoutitem>
                                                            <lightning:inputfield aura:id="editFormEnValue" fieldName="EMD_Number__c" />    
                                                        </lightning:layoutitem>
                                                    </lightning:layout>
                                                </lightning:recordEditForm>            
                                            </div>
                                            <aura:set attribute = "else">
                                                <div class="slds-form-element slds-size_1-of-2">
                                                    <span class="slds-form-element__label">EMD Number</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static">
                                                            {!v.existingSP.EMD_Number__c}
                                                        </span>
                                                    </div>
                                                </div>
                                            </aura:set>
                                        </aura:if> 
                                        <aura:if isTrue="{!v.existingSP.Payment_Status__c == 'Paid' ? 'True' : 'false'}">
                                            <div class="slds-form-element slds-size_1-of-2">
                                                <span class="slds-form-element__label">Payment Date</span>
                                                <div class="slds-form-element__control slds-has-divider--bottom">
                                                    <span class="slds-form-element__static">
                                                        <ui:outputDateTime value="{!v.existingSP.Payment_Timestamp__c}" format="DD-MM-YYYY HH:mm"/>
                                                    </span>
                                                </div>
                                            </div>
                                            <aura:set attribute = "else">
                                                <div class="slds-form-element slds-size_1-of-2">
                                                    <span class="slds-form-element__label">Payment Due Date</span>
                                                    <div class="slds-form-element__control slds-has-divider--bottom">
                                                        <span class="slds-form-element__static">
                                                            <ui:outputDateTime value="{!v.existingSP.Payment_Due_Date__c}" format="DD-MM-YYYY HH:mm"/>
                                                        </span>
                                                    </div>
                                                </div>
                                            </aura:set>    
                                        </aura:if>     
                                    </div>
                                </div>
                            </fieldset>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="slds-card__footer">
            <footer class="slds-media slds-media_center slds-has-flexi-truncate">
                <aura:if isTrue="{!v.editFields}">
                    <ul class="slds-button-group-row">
                        <li class="slds-button-group-item">
                            <div class="slds-no-flex" >  
                                <button onclick="{!c.updateValue}" class="slds-button slds-button_neutral slds-button_stretch" disabled="{!v.existingSP.Payment_Status__c == 'Pending' ? 'false' : 'true'}" title="Finalize Payment">Finalize Payment</button>
                            </div>    
                        </li>
                    </ul>
                </aura:if>
            </footer>
        </div>    
    </article>
    
</aura:component>