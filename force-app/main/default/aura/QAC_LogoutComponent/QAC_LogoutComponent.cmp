<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome"
                access="global" controller="QAC_LogoutController">
    
    <lightning:utilityBarAPI aura:id="utilitybar" />    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="showSpinner" type="boolean" default="false"/>
	<aura:attribute name="baseUrl" type="String"/>

    <aura:if isTrue="{!v.showSpinner}">
        <div class="slds-spinner_container">
            <lightning:spinner aura:id="spinner" variant="brand" size="medium"/>
        </div>
    </aura:if>    
    
    <article class="slds-card"> 
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">                
                <div class="slds-media__body">
                    <h2>
                        Are you sure you want to sign-out?
                    </h2>
                </div>
            </header>
        </div>
        <footer class="slds-card__footer">
            <lightning:button class="slds-button slds-button_destructive" label="Sign out" onclick="{!c.logOut}"/>
            <lightning:button class="slds-button slds-button--neutral" label="Cancel" onclick="{!c.closeModal}"/>
        </footer>
    </article>    

</aura:component>