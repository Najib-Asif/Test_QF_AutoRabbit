<aura:component controller="QAC_localPNRCases" 
                implements="flexipage:availableForAllPageTypes,force:hasRecordId">
    
    <!-- <aura:handler name="init" action="{!c.doInit}" value="{!this}" /> -->
    <aura:attribute name="AllPNRCases" type="Case[]" />
    <aura:attribute name="currentRecord" type="Object"/>
    <aura:attribute name="recordError" type="String"/>
    <aura:attribute name="numberOfRecordsVisible" type="Integer" default="3"/>
    <aura:attribute name="totalRecords" type="Integer" default="0"/>
    <aura:attribute name="toggleCount" type="Integer" default="3"/>
    <aura:attribute name="buttonstate" type="Boolean" default="false"/>    
    
    <force:recordData aura:id="recordLoader"
                      mode="VIEW"
                      fields="CaseNumber,PNR_number__c,Status"
                      recordId="{!v.recordId}"
                      targetFields="{!v.currentRecord}"
                      targetError="{!v.recordError}"
                      recordUpdated="{!c.handleRecordLoaded}"
                      />
    
    <aura:if isTrue="{!(v.AllPNRCases.length > 0)}">
        <article class="slds-card">
            
            <div class="slds-card__header slds-grid">
                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                    <div class="slds-media__figure">
                        <span class="slds-icon_container slds-icon-standard-case" title="case">
                            <lightning:icon iconName="standard:case" size="small"/>
                        </span>
                    </div>
                    <div class="slds-media__body">
                        <h2>
                            <a href="{!'/' + v.recordId}" class="slds-card__header-link slds-truncate" title="PNR Cases">
                                <span class="slds-text-heading_small">Similar Cases</span>
                            </a>
                        </h2>
                    </div>
                </header>
            </div>
            
            <div class="slds-card__body">
                <div class="slds-card__body--inner">
                    
                    <!-- Display Lightning Data Service errors, if any -->
                    <aura:if isTrue="{!not(empty(v.recordError))}">
                        <div class="recordError">{!v.recordError}</div>
                    </aura:if>   
                    
                    <div class="slds-tile">
                        <ul aura:id="pnrCASES" class="slds-has-dividers_around-space">
                            <aura:iteration items="{!v.AllPNRCases}" var="cases" indexVar="idx" end="{!v.toggleCount}">
                                <li class="slds-item">
                                    <article class="slds-tile slds-tile_board">
                                        <h3 class="slds-truncate" title="{!cases.CaseNumber}"><a href="{!'/' + cases.Id}">{!cases.CaseNumber}</a></h3>
                                        <div class="slds-tile__detail slds-text-body_small">
                                            
                                            <dl class="slds-list--horizontal slds-wrap">
                                                <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Waiver Type">
                                                    Waiver Type:
                                                </dt>
                                                
                                                <dd class="slds-item--detail slds-truncate" title="{!cases.Problem_Type__c}">
                                                    {!cases.Problem_Type__c}
                                                </dd>       
                                            </dl>
                                            
                                            <dl class="slds-list--horizontal slds-wrap">
                                                <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Waiver Sub Type">
                                                    Waiver Sub Type:
                                                </dt>
                                                
                                                <dd class="slds-item--detail slds-truncate" title="{!cases.Waiver_Sub_Type__c}">
                                                    {!cases.Waiver_Sub_Type__c}
                                                </dd>       
                                            </dl>
                                            
                                            <dl class="slds-list--horizontal slds-wrap">
                                                <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Status">
                                                    Status:
                                                </dt>
                                                
                                                <dd class="slds-item--detail slds-truncate" title="{!cases.Status}">
                                                    {!cases.Status}
                                                </dd>       
                                            </dl>
                                            
                                            <dl class="slds-list--horizontal slds-wrap">
                                                <dt class="slds-item--label slds-text-color--weak slds-truncate" title="Created Date">
                                                    Created Date:
                                                </dt>
                                                
                                                <dd class="slds-item--detail slds-truncate" title="{!cases.CreatedDate}">
                                                    <!--<ui:outputDate value="{!cases.CreatedDate}"/>-->
                                                    <ui:outputDateTime value="{!cases.CreatedDate}" format="DD-MMM-YYYY HH:mm"/>
                                                </dd>       
                                            </dl>
                                            
                                        </div>
                                    </article>
                                </li>
                            </aura:iteration>
                        </ul>
                        
                    </div>
                    
                    <aura:if isTrue="{!(v.AllPNRCases.length > v.numberOfRecordsVisible)}">
                        
                        <lightning:buttonStateful labelWhenOff="Show More"
                                                  labelWhenOn="Show Less"
                                                  labelWhenHover=""
                                                  iconNameWhenOff="utility:chevrondown"
                                                  iconNameWhenOn="utility:chevronup"
                                                  iconNameWhenHover=""
                                                  state="{!v.buttonstate}"
                                                  onclick="{!c.toggleTable}"
                                                  class="stateClass slds-align_absolute-center slds-button__icon_right"
                                                  />                    
                    </aura:if>
                    
                </div>
            </div>		
        </article>
    </aura:if>
    
</aura:component>