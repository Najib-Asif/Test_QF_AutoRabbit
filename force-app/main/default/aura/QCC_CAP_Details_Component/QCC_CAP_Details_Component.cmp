<!---
**********************************************************************************************
Author:        LMancill
Company:       Capgemini
Description:   Component used to display CAP contact details in a contact page
                                         
************************************************************************************************
  History
************************************************************************************************
   01-Nov-2017      LMancill               POC
   03-Nov-2017      Praveen S              Linking with CAP and Adding Details to the page
 **********************************************************************************************
             -->
<aura:component controller="QCC_CAP_DetailController" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" >
    <aura:attribute name="recordId" type="Id" /> 
    <aura:attribute name="lstAddRess" type="Object[]"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" /> 
    <aura:handler event="force:refreshView" action="{!c.checkSelected}" />
    <lightning:card iconName="standard:address">
        <aura:set attribute="title">
            <div class="slds-media__body">
                <h2>
                    <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="Primary Contact information">
                        <span class="slds-text-heading_small">Primary Contact information</span>
                    </a>
                </h2>
            </div>
        </aura:set>
        <p class="slds-p-horizontal--large"> 
            <div class="c-container slds-list_horizontal">
                <lightning:layout horizontalAlign="spread" multipleRows="true" >
                    <aura:renderIf isTrue="{!!empty(v.lstAddRess)}">
                        <aura:iteration items="{!v.lstAddRess}" var="item">
                            <lightning:layoutItem class="{!item.IsPreferred? 'preferred' : ''}" flexibility="auto" padding="around-small">
                                <h3 class="slds-section__title">
                                    <span class="slds-truncate" >
                                        <aura:renderIf isTrue="{!(item.TypeCode == 'B' || item.TypeCode == 'H')}">
                                            <aura:renderIf isTrue="{!item.TypeCode == 'B' }">
                                                Business 
                                                <aura:set attribute="else">
                                                    Home 
                                                </aura:set>
                                            </aura:renderIf>
                                            <aura:set attribute="else">
                                                Other 
                                            </aura:set>
                                        </aura:renderIf>
                                    </span>
                                </h3>
                                <dl class="slds-list_horizontal slds-wrap"> 
                                    <dt class="slds-item_label slds-text-color_weak">
                                        Phone
                                    </dt>
                                    <dd class="slds-item_detail slds-truncate" title="{!item.Phone}">{!item.Phone}</dd>
                                    <dt class="slds-item_label slds-text-color_weak">
                                        Email
                                    </dt>
                                    <dd class="slds-item_detail slds-truncate" title="{!item.Email}">{!item.Email}</dd>
                                    <dt class="slds-item_label slds-text-color_weak">
                                        Address
                                    </dt>
                                    <dd class="slds-item_detail" title="{!item.Address}">{!item.Address}</dd>
                                </dl> 
                            </lightning:layoutItem>                        
                        </aura:iteration>
                        <aura:set attribute="else">
                           <!-- <ui:message severity="info" closable="true">
                                No CAP data available for this customer
                            </ui:message>-->
                            <div class=" slds-text-color_error slds-text-align_center">{!$Label.c.QCC_No_AddressMsg}</div>
                        </aura:set>
                    </aura:renderIf>
                </lightning:layout>
            </div>
        </p>
        <div class="slds-spinner_container slds-hide" aura:id="spinner">
            <div class="slds-spinner--brand slds-spinner slds-spinner--medium" aria-hidden="false" role="alert">
                <div class="slds-spinner__dot-a"></div>
                <div class="slds-spinner__dot-b"></div>
            </div>
        </div>
    </lightning:card>  
    
</aura:component>