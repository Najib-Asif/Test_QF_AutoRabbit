<design:component label="One Header and Three Column with Centre Large">
    <flexipage:template >
        <flexipage:region name="top" defaultWidth="Xlarge" />
        <flexipage:region name="left" defaultWidth="Small" />
        <flexipage:region name="middle" defaultWidth="Medium" />
        <flexipage:region name="right" defaultWidth="Small" />
    </flexipage:template>
</design:component>