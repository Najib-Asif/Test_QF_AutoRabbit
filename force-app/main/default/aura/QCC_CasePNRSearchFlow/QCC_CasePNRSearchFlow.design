<design:component >
    <design:attribute name="pnr"  label="PNR Number" description="PNR NUmber for the booking detail realting to the case"/>
    <design:attribute name="lastName"  label="Last Name" description="Contact's Last Name for which the PNR Search is completed."/>
    <design:attribute name="contact"  label="Contact Record" description="Contact record to which the case will be attached"/>
    <design:attribute name="caseDetails"  label="Case Details" description="Case record (Unsaved) with relvant update from PNR Search"/>
    <design:attribute name="inputCaseDetails"  label="Input Case Details" description="Input case record details"/>
</design:component>