<aura:component implements="flexipage:availableForAllPageTypes" access="global" controller="QCC_CaseSearchResultController">
    <aura:attribute name="cases" type="Case[]"/>
    <aura:attribute name="currentList" type="Case[]"/>
    <aura:attribute name="mycolumns" type="List"/>
    <aura:attribute name="showToProfiles" type="Boolean" default="true"/>
    <aura:attribute name="pageNumber" type="Integer" default="1" />
    <aura:attribute name="maxPage" type="Integer" default="1" />
    <aura:attribute name="searchCompleted" type="Boolean" default="false"/>
    <aura:attribute name="flowModalEnabled" type="Boolean" default="false"/>
    <aura:attribute name="noCasesFound" type="Boolean" default="false"/>
    <aura:attribute name="isLivePerson" type="Boolean" default="false"/>
    <aura:attribute name="isHideCheckbox" type="Boolean" default="true"/>
    <aura:handler name="change" value="{!v.pageNumber}" action="{!c.renderPage}" />
    <aura:handler name="init" value="{! this}" action="{! c.doInit}"/>
    <aura:handler event="c:QCC_ShowCasesEvent" action="{! c.getCases}"/>
    <aura:handler event="c:QCC_ResetEvent" action="{! c.doReset}"/>
    <aura:registerEvent name="QCC_CaseSelect_LiveEngage" type="c:QCC_CaseSelect_LiveEngage" />
    <aura:registerEvent name="createRecordEvent" type="c:QCC_CreateRecordEvent"/>

    <aura:if isTrue="{! v.searchCompleted}">
        <lightning:card class="slds-clearfix">
            <aura:set attribute="title">
                <div class="slds-media__body">
                    <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="{! $Label.c.QCC_CaseSearchResultHoverText}">
                        <span class="slds-text-heading_small">{! $Label.c.QCC_SearchResultsAndSameCasesHeading} with Flow</span>
                    </a>
                </div>
            </aura:set>
            <aura:renderIf isTrue="{! !empty(v.currentList)}">
                <lightning:datatable aura:id="searchResults" data="{! v.currentList}" 
                                     columns="{! v.mycolumns}" 
                                     keyField="Id"
                                     resizeColumnDisabled="true"
                                     onrowaction="{! c.handleRowAction }"
                                     hideCheckboxColumn="{!v.isHideCheckbox}"
                                     class="myStyle"/>
                <br/>
                <c:QCC_Pagination currentPageNumber="{!v.pageNumber}" maxPageNumber="{!v.maxPage}" />
                <br/><br/>
                <div class="slds-p-around_small slds-float_right">
                    <aura:if isTrue="{!v.showToProfiles}">    
                    	<lightning:button label="Create Case" variant="brand" onclick="{! c.createCase}"/>
                    </aura:if>
                </div>
                <aura:set attribute="else">
                    <div class=" slds-text-color_error slds-text-align_center">{! $Label.c.NoCaseFound}</div>
                    <div class="slds-p-around_small slds-float_right">
                        
                    <aura:if isTrue="{!v.showToProfiles}">
                            <lightning:button label="Create Case" variant="brand" onclick="{! c.createCase}" />                        
					</aura:if>
                        
                    </div>
                </aura:set>
            </aura:renderIf>
            <aura:if isTrue="{! v.flowModalEnabled}">
                <div class="slds-modal slds-fade-in-open">
                    <div class="slds-modal__container" >
                        <div class="slds-modal__content slds-p-around--medium">
                            <div>
                                <lightning:flow aura:id="flowCreateCase" />  
                            </div>
                        </div>                                                                   
                    </div>
                </div>
                <div class="slds-backdrop slds-backdrop--open" id="backGroundSectionId"></div>           
            </aura:if>
        </lightning:card>
    </aura:if>
    <div aura:id="overlayLib"/>
</aura:component>