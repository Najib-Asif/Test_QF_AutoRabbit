<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId">
	 <ltng:require styles="{!$Resource.multilineToastCSS}" />
    <aura:attribute name="record" type="Recovery__c"/>
    <aura:attribute name="simpleRecord" type="Recovery__c"/>
    <aura:attribute name="recordError" type="String"/>
    <aura:attribute name="space" type="String" default = " "/>
    <aura:attribute name="currencyLeft3" type="String" default = ""/>
    <aura:attribute name="monetaryValue" type="String" default = ""/>
    <aura:attribute name="Spinner" type="boolean" default="false"/>
    <aura:attribute name="submitted" type="boolean" default="false"/>

    <!--loading spinner start-->
    <aura:if isTrue="{!v.Spinner}">
        <div aura:id="spinnerId" class="slds-spinner_container">
        <div class="slds-spinner--brand  slds-spinner slds-spinner--medium slds-is-relative" role="alert">
            <span class="slds-assistive-text">Loading</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
        </div>
        </div>
    </aura:if>
    <!-- Loading spinner end-->

	<force:recordData aura:id="recordHandler"
		recordId="{!v.recordId}"
		layoutType="FULL"
		fields="Status__c,Type__c,Amount__c,Monetary_Value__c,RecordType.Name,Original_Currency__c,Process_Status__c"
		targetRecord="{!v.record}"
		targetFields="{!v.simpleRecord}"
		targetError="{!v.recordError}"
        mode="EDIT"
		recordUpdated="{!c.handleRecordUpdate}"/>

        <aura:if isTrue="{!and(v.simpleRecord.Status__c == 'Open'||v.simpleRecord.Status__c == 'New',v.simpleRecord.Type__c != null)}">
            <div class="slds-card slds-section section-extra">
                
                <h3 class="slds-section__title title-margin">
                    <span class="slds-truncate" title="Section Title">{!$Label.c.Recovery_Confirm_Submitted_Header}</span>
                </h3>

                <div class="slds-grid">
                    <div class="slds-col ">
                        <aura:if isTrue="{!and(v.simpleRecord.Amount__c != null, v.simpleRecord.Monetary_Value__c == null)}">
                            <p class="slds-text-body--label">
                                {!format($Label.c.RecoveryOnlyAmountMessage,v.simpleRecord.Amount__c, v.simpleRecord.Type__c)}
                            </p>
                        </aura:if>
                        <aura:if isTrue="{!and(v.simpleRecord.Amount__c == null, v.simpleRecord.Monetary_Value__c != null)}">
                            <p class="slds-text-body--label">
                                {!format($Label.c.RecoveryOnlyMonetaryMessage, v.simpleRecord.Type__c, v.currencyLeft3, v.monetaryValue)}
                            </p>
                        </aura:if>
                        <aura:if isTrue="{!and(v.simpleRecord.Amount__c != null, v.simpleRecord.Monetary_Value__c != null)}">
                            <p class="slds-text-body--label">
                                {!format($Label.c.RecoveryBothAmountMonetaryMessage, v.simpleRecord.Amount__c, v.simpleRecord.Type__c, v.currencyLeft3, v.monetaryValue)}
                            </p>
                        </aura:if>
                        <aura:if isTrue="{!and(v.simpleRecord.Amount__c == null, v.simpleRecord.Monetary_Value__c == null)}">
                            <p class="slds-text-body--label">
                                {!format($Label.c.RecoveryNonAmountMonetaryMessage, v.simpleRecord.Type__c)}
                            </p>
                        </aura:if>
                        <br/>
                        <ui:outputText value="{!$Label.c.Recovery_Confirm_Submitted_Footer}"/>
                    </div>
                    <div class="slds-col cls-button-right">
                        <ui:button aura:id="btnSubmit" buttonTitle="Submit Recovery" class="slds-button_brand cls-submit-btn" label="Submit" press="{!c.submitRecord}" />
                    </div>
                </div>

            </div>
        </aura:if>

</aura:component>