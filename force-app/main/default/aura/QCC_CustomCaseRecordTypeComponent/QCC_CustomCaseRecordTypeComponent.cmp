<aura:component controller="QCC_CustomerDetailController" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
    <aura:attribute name="objCon" type="Object" />
    <aura:attribute name="pnr" type="String" />
    <aura:attribute name="createdDate" type="String" />
    <aura:attribute name="archivalData" type="String" />
    <aura:attribute name="contactId" type="String" />
    <aura:attribute name="objPassenger" type="Object" />
    <aura:attribute name="fromBooking" type="Boolean" default="false"/>
    <aura:attribute name="conDetails" type="String"/>
    <aura:attribute name="firstPassenger" type="Object"/>
    <aura:attribute name="selectedSSR" type="Object"/>
    <aura:attribute name="con" type="Contact"/>
    <aura:handler name="init" value="{!this}" action="{!c.callInit}" />
    <aura:attribute name="lstOfRecordType" type="String[]" access="public"/>
                
    <div class="slds-p-top--small slds-p-bottom--small" >
        <fieldset class="slds-form-element">
            <div class="slds-form-element__control">
                <aura:iteration items="{!v.lstOfRecordType}" var="casRecType">
                    <label class="slds-radio slds-p-top--small">
                        <tr>
                            <td>
                                <ui:inputRadio name="rtypes" change="{!c.onSelectVal}" text="{!casRecType.Id}" />
                                <span class="slds-radio--faux"></span>
                            </td>
                            <td>
                                <span class="slds-form-element__label">{!casRecType.Name}</span>
                            </td>
                        </tr>
                    </label>
                    
                </aura:iteration>
            </div>
        </fieldset>
    </div>
    
</aura:component>