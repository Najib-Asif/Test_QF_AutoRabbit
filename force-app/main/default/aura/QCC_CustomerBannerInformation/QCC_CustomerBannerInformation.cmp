<!---
    **********************************************************************************************
    Author:        Praveen Sampath
    Company:       Capgemini
    Description:   QCC CustomerDetailBanner Information Component on the Console layout 
         
    ************************************************************************************************
    History
    ************************************************************************************************
    01-Nov-2017      Praveen Sampath               Initial Design
    23-Nov-2017      Purushotham                   Added '`Recovery' Button
    24-Nov-2017      Anupam                        Added 'Escalate' Button
    24-Nov-2017      Abbas                         Added 'Email Customer' Button
    13-Sep-2019		 Raymart Tolentino			   GRAPHITE-113 Include the onContact and recordId attribute in QCC_CustomerInformation child component
    11-Nov-2019		 Lora Mae Dapulang			   GRAPHITE-1151 | Added 'Start Work' and 'Resolved Case' buttons
    13-Feb-2020      Lora Mae Dapulang             GRAPHITE-1748 | Switch for "Start Work" and "Resolve Case" buttons
    **********************************************************************************************
    -->
<aura:component controller="QCC_CustomerDetailController" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" >
    <aura:attribute name="objCon" type="Object"/>
    <aura:attribute name="showToProfiles" type="Boolean" default="true"/>
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="onContact" type="Boolean" default="false"/>
    <aura:attribute name="onCase" type="Boolean" default="false"/>
    <aura:attribute name="useFlow" type="Boolean" default="false"/>
    <aura:attribute name="isConsultant" type="Boolean" default="false"/>
    <aura:attribute name="isCaseClosed" type="Boolean" default="false"/>
    <aura:attribute name="isCaseInQueue" type="Boolean" default="false"/>
    <aura:attribute name="isContactPresent" type="Boolean" default="true"/>
    <aura:attribute name="isInsuranceLetterCase" type="Boolean" default="fase"/>
    <aura:attribute name="isBaggageCase" type="Boolean" default="fase"/>
    <aura:attribute name="displayStartandResolve" type="Boolean" default="true"/>
    <aura:attribute name="userId" type="Id" />
    <aura:attribute name="caseStatus" type="String"/>
    <aura:attribute name="flowCustomPermission" type="String" default="QCC_View_Case_Creation_Flow"/>

    <aura:attribute name="record" type="Object"/>
    <aura:attribute name="simpleRecord" type="Object"/>
    <aura:attribute name="recordError" type="String"/>
    
    <force:recordData aura:id="recordHandler"
                      recordId="{!v.recordId}"
                      layoutType="FULL"
                      targetRecord="{!v.record}"
                      targetFields="{!v.simpleRecord}"
                      targetError="{!v.recordError}"
                      mode="VIEW"
                      recordUpdated="{!c.handleRecordUpdate}"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler event="force:refreshView" action="{!c.doOnChange}" />
    <lightning:messages />

    <!--<aura:handler name="change" value="{!v.objCon}" action="{!c.sendDatatoChild}"/>-->
    <div class="c-container">
        <aura:renderIf isTrue="{!v.isContactPresent}">
            
            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="3" flexibility="auto" padding="around-small">
                    <!-- Customer Information -->
                    <c:QCC_CustomerInformation aura:id="customerComponet" onContact="{!v.onContact}"  contactId="{!v.recordId}"/>
                </lightning:layoutItem>
                
                <lightning:layoutItem size="6" flexibility="auto" padding="around-small">
                    <!--FrequentFlyer Information -->
                    <c:QCC_FrequentFlyerinformation aura:id="FFComponet" recordId="{!v.recordId}"/>
                 </lightning:layoutItem>
                <lightning:layoutItem size="3" flexibility="auto" padding="around-small">
                    <!--CaseSummary Information-->
                    <c:QCC_CaseSummary aura:id="CaseComponet" contactDetails="{!v.objCon}" recordId="{!v.recordId}"/>
                </lightning:layoutItem>
            </lightning:layout>
        </aura:renderIf>
        
        <lightning:layout>
            <lightning:layoutItem size="4">
            </lightning:layoutItem>
            <lightning:layoutItem size="4">
                <div class="slds-align_absolute-center">
                    <aura:If isTrue="{!and(v.onCase,v.displayStartandResolve)}">
                        <c:QCC_StartWorkAndResolveCase aura:id="qccStartWork" recordId="{!v.recordId}" caseStatus="{!v.caseStatus}"/>
                    </aura:If>
                </div>
            </lightning:layoutItem>
            <lightning:layoutItem alignmentBump="left">
                <lightning:buttonGroup >
                    <aura:renderIf isTrue="{!and(v.onContact,v.showToProfiles, v.simpleRecord.Frequent_Flyer_Number__c != null)}">
                        <aura:If isTrue="{!v.useFlow}">
                            <c:QCC_CreateCaseFlow objCon="{!v.objCon.objContact}" aura:id="CaseCreateComponetFlow"/>
                            <aura:set attribute="else">
                            <c:QCC_CreateCase aura:id="CaseCreateComponet"/>
                            </aura:set>
                        </aura:If>
            </aura:renderIf>                
                    <aura:renderIf isTrue="{!and(v.onCase, v.isConsultant)}">
                        <lightning:overlayLibrary aura:id="overlayLib"/>
                        <c:QCC_Escalate aura:id="qccEscalate" isValid="{!v.isContactPresent}" recordId="{!v.recordId}"/>
                    </aura:renderIf>
                    <!--aura:renderIf isTrue="{!and(v.onCase, v.howToProfiles, not(v.isCaseClosed))}"-->
                    <aura:renderIf isTrue="{!and(v.onCase, v.showToProfiles, v.caseStatus != 'Closed')}">
                        <lightning:overlayLibrary aura:id="overlayLib"/>
                        <!-- <c:QCC_Recovery aura:id="qccRecovery" isValid="{!v.isContactPresent}" recordId="{!v.recordId}"/> -->
                         <!--changes by Navya on 7th July 2024 for CDP2-342 -->
                        <!--<c:QCC_Recovery aura:id="qccRecovery" recordId="{!v.recordId}" caseStatus="{!v.caseStatus}" caseOwner="{!v.caseOwner}" />-->
                    </aura:renderIf>
                    <aura:renderIf isTrue="{!and(v.onCase, v.isBaggageCase, v.isContactPresent)}">
                        <!--<lightning:layoutItem flexibility="auto">-->
                        <lightning:overlayLibrary aura:id="overlayLib"/>
                        <c:QCC_EmailButton aura:id="qccEmailButton" recordId="{!v.recordId}" />
                        <!--</lightning:layoutItem>-->
                        <aura:set attribute="else">
                        </aura:set>
                    </aura:renderIf>
                   
                    <!--aura:renderIf isTrue="{!and(v.onCase, v.showToProfiles,v.isInsuranceLetterCase, not(v.isCaseClosed))}"-->
                    <aura:renderIf isTrue="{!and(v.onCase, v.showToProfiles, v.isInsuranceLetterCase, v.caseStatus != 'Closed')}">
                        <!--<lightning:layoutItem flexibility="auto">-->
                        <lightning:overlayLibrary aura:id="overlayPassenger"/>
                        <lightning:button variant="neutral" label="Add Passenger" onclick="{!c.displayPassenger}" disabled="{!v.isCaseClosed}"/>
                        <!--</lightning:layoutItem>-->
                        <aura:set attribute="else">
                        </aura:set>
                    </aura:renderIf>
                </lightning:buttonGroup>
            </lightning:layoutItem>
        </lightning:layout>
    </div>
</aura:component>