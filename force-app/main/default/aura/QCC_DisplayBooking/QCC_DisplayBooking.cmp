<!---
    **********************************************************************************************
    Author:        Praveen Sampath
    Company:       Capgemini
    Description:   QCC Display BookingComponent Information on the Console layout 
         
    ************************************************************************************************
    History
    ************************************************************************************************
    01-Nov-2017      Praveen Sampath               Initial Design
    **********************************************************************************************
    -->
<aura:component controller="QCC_DisplayBookingController" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
    <aura:attribute name="designHeight" type="String" />
    <aura:attribute name="lstBooking" type="Object[]" />
    <aura:attribute name="lstSetting" type="Object[]" />
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="hidePrev" type="Boolean" />
    <aura:attribute name="hideNext" type="Boolean" />
    <aura:attribute name="pageNumber" type="Integer" default="1" />
    <aura:attribute name="mapBooking" type="Map" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    
    
    <lightning:card iconName="standard:recent">
        <aura:set attribute="title">
            <div class="slds-media__body">
                <h2>
                    <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="[object Object]">
                        <span class="slds-text-heading_small">Bookings</span>
                    </a>
                </h2>
            </div>
        </aura:set>
        
        <aura:set attribute="footer">
            <lightning:button variant="brand" label="Previous" iconName="utility:left" iconPosition="left" onclick="{!c.Previous}" disabled="{!v.hidePrev}" />
            &nbsp;&nbsp;&nbsp;&nbsp; {!v.pageNumber} &nbsp;&nbsp;&nbsp;&nbsp;
            <lightning:button variant="brand" label="Next" iconName="utility:right" iconPosition="right" onclick="{!c.Next}" disabled="{!v.hideNext}"/>
        </aura:set>
        
        <p class="slds-p-horizontal--large"> 
            <lightning:layout horizontalAlign="space" pullToBoundary="small" multipleRows="true" >
                <aura:renderIf isTrue="{!v.mapBooking == null}">
                    <div class=" slds-text-color_error slds-text-align_center">No booking data available for this customer</div>
                    <aura:set attribute="else">
                        <aura:iteration items="{!v.lstBooking}" var="item">
                            <lightning:layoutItem padding="around-small" class="slds-border_bottom" flexibility="auto">
                              <dl class="slds-list_horizontal slds-wrap"> 
                                    <dd class="slds-item_label slds-text-color_weak slds-text-body_small" title="First Label">PNR:</dd>
                                    <dt class="slds-item_detail slds-truncate slds-text-body_small" title="Description for first label">{!item.pnr}</dt>
                                    <dd class="slds-item_label slds-text-color_weak slds-text-body_small" title="Second Label">DEPARTURE DATE:</dd>
                                    <dt class="slds-item_detail slds-truncate slds-text-body_small" title="Description for second label">{!item.departureSTR}</dt>
                                    <dd class="slds-item_label slds-text-color_weak slds-text-body_small" title="First Label">DEPARTURE CITY:</dd>
                                    <dt class="slds-item_detail slds-text-body_small" title="Description for first label">{!item.departurePort}</dt>
                                    <dd class="slds-item_label slds-text-color_weak slds-text-body_small" title="Second Label">ARRIVAL CITY:</dd>
                                    <dt class="slds-item_detail slds-truncate slds-text-body_small" title="Description for second label">{!item.arrivalPort}</dt>
                                </dl>
                            </lightning:layoutItem>                   
                        </aura:iteration>
                    </aura:set>
                </aura:renderIf>
            </lightning:layout>
            
        </p>
        <div class="slds-spinner_container slds-hide" aura:id="spinner">
            <div class="slds-spinner--brand slds-spinner slds-spinner--medium" aria-hidden="false" role="alert">
                <div class="slds-spinner__dot-a"></div>
                <div class="slds-spinner__dot-b"></div>
            </div>
        </div>
        
    </lightning:card>  
</aura:component>