<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global" 
	controller="QCC_DisplayPAXController">
	<aura:attribute name="passengerList" type="Object"/>
    <aura:attribute name="mycolumns" type="List"/>
    <aura:attribute name="selectedRows" type="List"/>
    <aura:attribute name="spinner" type="Boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{! c.doInit }"/>
    <div>
	<lightning:datatable data="{! v.passengerList }" 
        columns="{! v.mycolumns }" 
        keyField="passengerId"
        onrowselection="{! c.addRemovePassenger }"
        selectedRows="{!v.selectedRows}"
        isLoading="{!v.spinner}"
        showRowNumberColumn="true" 
        resizeColumnDisabled="true"/>   
        
    </div>
</aura:component>