<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global" controller="QCC_AffectPassengerFilterController">
    <aura:attribute name="options" type="List"/>
    <aura:attribute name="value" type="List"/>
    <aura:attribute name="recordId" type="Id" />
    
    <aura:handler name="init" value="{! this }" action="{! c.doInit }"/>
    
    <div class="c-container">
        <lightning:card title="">
            <aura:set attribute="title">
                <lightning:icon  iconName="custom:custom30" size="small"/>
                <b class="slds-p-left_medium">Filter Passenger Based on Failure - Screen </b>
            </aura:set>
            <lightning:layout horizontalAlign="spread" verticalAlign="spread" multipleRows="true" >
                
                <lightning:layoutItem flexibility="auto" padding="around-small" size="12" class="custom-box">
                    <lightning:checkboxGroup name="Faliure List"
                                             label="Event Failures"
                                             options="{! v.options }"
                                             value="{! v.value }"
                                             />
                </lightning:layoutItem>
                
                <lightning:layoutItem flexibility="auto" padding="around-small" size="12" class="custom-box">
                    <lightning:buttonGroup class="slds-clearfix slds-float_right">
                        <lightning:button  variant="destructive" label="View Affected Passenger" title="View Affected Passenger" onclick="{!c.handleClick}"/>
                    </lightning:buttonGroup>
                </lightning:layoutItem>
                
            </lightning:layout>
        </lightning:card>
    </div>
</aura:component>