<!--
                    Author:        Praveen Sampath
                    Company:       Capgemini
                    Description:   Customer Search using PNR
                    Inputs:
                    Test Class:     
                    ************************************************************************************************
                    History
                    ************************************************************************************************
                    03-AUG-2018      Praveen Sampath               Initial Design
                    -->
<aura:component implements="flexipage:availableForAllPageTypes" access="global" controller="QCC_PNRSearchController" >
    <aura:attribute name="pnr" type="String"/>
    <aura:attribute name="errMSG" type="String" default=""/>
    <aura:attribute name="lastName" type="String"/>
    <aura:attribute name="isLoading" type="Boolean" default="false"/>
    <aura:attribute name="showModal" type="Boolean" default="false"/>
    <aura:attribute name="recId" type="String" default=""/>
    
    <aura:registerEvent name="resetEvent" type="c:QCC_ResetEvent"/>
    <aura:registerEvent name="resetFormEvent" type="c:QCC_ResetFormEvent"/>
    
    <!--Handle reset PNR and last name-->
    <aura:handler event="c:QCC_ResetEvent" action="{! c.doReset}"/>
    
    <!-- Only Invoked from Case Search Page-->
    <aura:method name="casePNRSearch" action="{!c.onLoad}" description="To get Case from the parent Case Search Component"> 
        <aura:attribute name="caseId" type="String" /> 
    </aura:method>
    
    <aura:if isTrue="{! v.isLoading}">
        <lightning:spinner variant="brand" alternativeText="Searching..."/>
    </aura:if>
    <lightning:card class="slds-clearfix">
        <aura:set attribute="title">
            <b>Lookup PNR</b>
        </aura:set>        
        <div class="slds-p-around_small">
            <lightning:input aura:id="pnr" name="PNR" value="{!v.pnr}" label="* PNR" />
            <lightning:input aura:id="lastName" name="LastName" value="{!v.lastName}" label="* Last Name" />
        </div>
        
        <div class="slds-p-around_small slds-float_right">
            <lightning:button label="Lookup Customer" variant="brand" onclick="{! c.onClick}"/>
        </div>
        
    </lightning:card>
    <aura:renderIf isTrue="{!v.showModal}">
        <c:QCC_ShowModal showModal="{!v.showModal}" header="Error" content="{!v.errMSG}"/>
    </aura:renderIf>
    
    <div aura:id="overlayLib" />
    
</aura:component>