<aura:component controller="QEC_FareRulesController" implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global">
    <aura:attribute name="recordId" type="Id" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="netFareTable" type="List" />
    <aura:attribute name="privateFareTable" type="List" />
    <aura:attribute name="nonAUTable" type="List" />
    <aura:attribute name="AUregion" type="boolean"/>
    <aura:html tag="style">
        .slds-modal__container {
        max-width: 500rem !important;
        width:98% !important;
        }
    </aura:html>
    <div class="slds-align_absolute-center slds-m-around_small slds-text-heading_medium">
        Add Fare Rules
    </div> 
    <lightning:spinner aura:id="mySpinner" />
    
    <aura:if isTrue="{!v.AUregion}">
        <lightning:tabset selectedTabId="one">
            <lightning:tab label="DOMESTIC" id="one">
                <lightning:accordion aura:id="accordion" allowMultipleSectionsOpen="true">
                    <aura:iteration items="{!v.privateFareTable}" var ="item">
                        <lightning:accordionSection name="{!item.ruleName}" label="{!item.sequence +' - '+item.ruleName}">
                            <aura:set attribute="actions">
                                <lightning:input type="toggle" checked="{!item.recommended}" messageToggleActive="Included" messageToggleInActive="Excluded"/>
                            </aura:set>
                            <lightning:inputRichText value="{!item.textAreaData}"/>
                        </lightning:accordionSection>
                    </aura:iteration>
                </lightning:accordion>	
            </lightning:tab>
            <lightning:tab label="INTERNATIONAL" id="two">
                <lightning:accordion aura:id="accordion" allowMultipleSectionsOpen="true">
                    <aura:iteration items="{!v.netFareTable}" var ="item">
                        <lightning:accordionSection name="{!item.ruleName}" label="{!item.sequence +' - '+item.ruleName}">
                            <aura:set attribute="actions">
                                <lightning:input type="toggle" checked="{!item.recommended}" messageToggleActive="Included" messageToggleInActive="Excluded"/>
                            </aura:set>
                            <lightning:inputRichText value="{!item.textAreaData}"/>
                        </lightning:accordionSection>
                    </aura:iteration>
                </lightning:accordion>	
            </lightning:tab>
        </lightning:tabset>
    </aura:if>
    <aura:if isTrue="{!not(v.AUregion)}">
        <lightning:tabset selectedTabId="one">
            <lightning:tab label="US Fare Rules" id="one">
                <lightning:accordion aura:id="accordion" allowMultipleSectionsOpen="true">
                    <aura:iteration items="{!v.nonAUTable}" var ="item">
                        <lightning:accordionSection name="{!item.ruleName}" label="{!item.sequence +' - '+item.ruleName}">
                            <aura:set attribute="actions">
                                <lightning:input type="toggle" checked="{!item.recommended}" messageToggleActive="Included" messageToggleInActive="Excluded"/>
                            </aura:set>
                            <lightning:inputRichText value="{!item.textAreaData}"/>
                        </lightning:accordionSection>
                    </aura:iteration>
                </lightning:accordion>	
            </lightning:tab>
        </lightning:tabset>
        
    </aura:if>
    
    <div class="slds-align_absolute-center">
        <lightning:button variant="brand" label="Save Changes" title="Brand action" onclick="{!c.handleSave }" class="slds-m-around_small"/>
    </div>
    
</aura:component>