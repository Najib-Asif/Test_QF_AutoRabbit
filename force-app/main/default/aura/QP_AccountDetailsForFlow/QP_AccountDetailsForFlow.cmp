<!-- Created By : Ajay Bharathan | TCS | Cloud Developer 
 Purpose : To embed this component to FLOW - Qantas Payments Contract Creation
-->
<aura:component controller="QP_AccountFlowController" implements="lightning:availableForFlowScreens" access="global">
    
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="existingAccount" type="Account"/>
    <aura:attribute name="activeContract" type="Boolean"/>
    <aura:attribute name="accBillingCountry" type="String" />
    <aura:attribute name="accAddress" type="String" />
    <aura:attribute name="contractRTId" type="String" />
    <aura:attribute name="authorizedUser" type="Boolean" />
    <aura:attribute name="authorizedAccount" type="Boolean"/>
    
    
    <aura:handler name="init" action="{!c.doInit}" value="{!this}" />
    <aura:handler event="force:refreshView" action="{!c.doInit}" />
    
    <article class="slds-card">
        
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-contact" title="Account Details">
                        <lightning:icon iconName="standard:account" size="small"/>
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2>
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="Account Record">
                            <span class="slds-text-heading_small">Account</span>
                        </a>
                    </h2>
                </div>
            </header>
        </div>
        
        <div class="slds-card__body">
            <div class="slds-card__body--inner">
                <div class="slds-tile">
                    <div class="slds-tile__detail slds-text-body--small">
                        <div class="slds-form slds-form_compound">
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Account Name</span>
                                            <div class="slds-form-element__control">
                                                <a href="{!'/' + v.recordId}" title="Click to view Account">
                                                    <span style="color: rgb(0, 109, 204);" class="disabledBg slds-form-element__static">
                                                        {!v.existingAccount.Name}
                                                    </span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Account Legal Name</span>
                                            <div class="slds-form-element__control">
                                                <span class="disabledBg slds-form-element__static">
                                                    {!v.existingAccount.Legal_Name__c}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Account Type</span>
                                            <div class="slds-form-element__control">
                                                <span class="disabledBg slds-form-element__static">
                                                    {!v.existingAccount.Type}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Account Owner</span>
                                            <div class="slds-form-element__control">
                                                <a href="{!'/' + v.existingAccount.OwnerId}" title="Click to view Owner">
                                                    <span style="color: rgb(0, 109, 204);" class="disabledBg slds-form-element__static">
                                                        {!v.existingAccount.Owner.Name}
                                                    </span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Billing Address</span>
                                            <div class="slds-form-element__control">
                                                <span class="slds-form-element__static">
                                                    <lightning:textarea name="notes" value="{!v.accAddress}" disabled="true"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Active Account?</span>
                                            <div class="slds-form-element__control">
                                                <span class="disabledBg slds-form-element__static">
                                                    {!(v.existingAccount.Active__c) ? 'Yes' : 'No'}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                            <fieldset class="slds-form-element">
                                <div class="slds-form-element__group">
                                    <div class="slds-form-element__row">
                                        <div class="slds-form-element slds-size_1-of-1">
                                            <span class="slds-form-element__label">Active Channel Contract?</span>
                                            <div class="slds-form-element__control">
                                                <span class="disabledBg slds-form-element__static">
                                                    {!(v.activeContract) ? 'Yes' : 'No'}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>	
</aura:component>