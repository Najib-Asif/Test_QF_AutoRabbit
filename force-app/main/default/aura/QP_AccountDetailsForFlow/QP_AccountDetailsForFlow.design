<design:component label="QantasPayments_AccountFlow">

    <!-- This attributes takes value from FLOW and set it to Lightning attribute in Markup -->
    <design:attribute name="recordId" label="RecordId" />
    
    <!-- These attributes set to respective Variables in FLOW -->
    <design:attribute name="existingAccount" label="ExistingAccount" />
    <design:attribute name="activeContract" label="ActiveContract"/>
    <design:attribute name="accBillingCountry" label="AccBillingCountry"/>
    <design:attribute name="contractRTId" label="ContractRecordTypeId"/>
    <design:attribute name="authorizedUser" label="AuthorizedUser" />
    <design:attribute name="authorizedAccount" label="AuthorizedAccount"/>
</design:component>