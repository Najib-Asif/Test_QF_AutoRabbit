<design:component >
    <design:attribute name="pnr"  label="PNR Number" description="PNR NUmber for the booking detail realting to the case"/>
    <design:attribute name="lastName"  label="Last Name" description="Last Name for which the PNR Search is completed."/>
    <design:attribute name="componentId"  label="Record Id" description="Record Id for this case."/>
    <design:attribute name="creationDate"  label="Creation Date" description="PNR Creation Date"/>
    <design:attribute name="history" label="history" default="false" /> 
</design:component>