<![CDATA[<div align="center" style=""><div align="center" style="text-align: center;"><div align="center" style="text-align: start;"><div align="center" style="text-align: start;"><div align="center" style="text-align: start;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="750" data_liveedit_tagid="0000000013F5ACB0" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="0000000014960660"><tr data_liveedit_tagid="0000000014A46C60"><td data_liveedit_tagid="000000001404F280" style="line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="0000000013F94D50" style="background-color: rgb(255, 255, 255); text-align: center;"><tbody data_liveedit_tagid="0000000013F9F130"><tr data_liveedit_tagid="000000002FB4BA70"><td valign="top" data_liveedit_tagid="000000002FB4EFA0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000002FB4D690" style="background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="000000002FB48FD0"><tr width="680" data_liveedit_tagid="000000002FB4B240"><td align="center" data_liveedit_tagid="000000002FB518C0" style="font-variant-ligatures: none; font-size: 10px; color: rgb(102, 102, 102); line-height: 20px; text-align: center; height: 40px; width: 680px;"><div data_liveedit_tagid="000000002FB49100" style="height: 10px; line-height: 15px;"><font face="Arial, sans-serif">&nbsp;</font></div><div data_liveedit_tagid="000000002FB4C600" style="height: 10px; line-height: 15px;"><font face="Arial, sans-serif">&nbsp;</font></div></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000002FB4AB90" style="width: 680px;"><tbody data_liveedit_tagid="000000002FB4DF00"><tr data_liveedit_tagid="000000002FB44670"><td data_liveedit_tagid="000000002FB44430" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><a href="https://www.qantas.com/au/en.html" target="_blank" data_liveedit_tagid="000000002FB48430" style="color: rgb(102, 102, 102); text-decoration-line: none; border: 0px;"><font face="Arial, sans-serif"><img border="0" src="http://salesnews.qantas.com/imgproxy/img/2028492550/qantas-header+19+2+680x70.jpg" title="Qantas" style="width: 680px;"></font></a></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" id="main-content" width="600" data_liveedit_tagid="000000002FB4B6E0" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="0000000013F54D20"><tr data_liveedit_tagid="0000000014059780"><td align="center" valign="top" data_liveedit_tagid="0000000013F94890" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: left;"><table border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="000000001404A580"><tbody data_liveedit_tagid="000000002E4E5FE0"><tr data_liveedit_tagid="00000000108A7C20"><td valign="top" data_liveedit_tagid="0000000013FC2840" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 40px; height: 30px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000014954980"><td align="left" valign="top" data_liveedit_tagid="0000000014061930" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">Dear Agency Partner,</font></td></tr><tr data_liveedit_tagid="0000000013FC3680"><td valign="top" data_liveedit_tagid="000000002FB487A0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="000000002FB4E160"><td align="left" valign="top" data_liveedit_tagid="00000000108A6A50" style="line-height: 20px;"><font face="Arial, sans-serif" style=""><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">We wanted to let you know that Qantas will be making an adjustment to base fares across the entire domestic network.</span></font><br data_liveedit_tagid="000000002FB4B4A0"><br data_liveedit_tagid="000000002FB4ACC0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">The fare adjustments are:</span></font><br data_liveedit_tagid="000000002FB43E50"><br data_liveedit_tagid="000000002FB428B0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">•&nbsp;&nbsp;&nbsp;An increase of 4 per cent for Economy and Business fares.</span></font><br data_liveedit_tagid="000000002FB42410"><br data_liveedit_tagid="000000001029D9E0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">Adjusted fares will be effective for sale and travel from&nbsp;</span></font><strong data_liveedit_tagid="000000002FB4DCA0" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none;">Friday 1&nbsp;July 2022. Bookings at the current rates must be ticketed on or before Thursday 30&nbsp;June 2022</strong><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">.</span></font><br data_liveedit_tagid="00000000102A8A60"><br data_liveedit_tagid="0000000013F30EA0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">We want to sincerely thank you for your patience and understanding while we work through what has been a challenging restart for the industry globally. We continue to work closely with airports and our suppliers to improve the experience for you and your customers. If you require any further information or assistance, please feel free to contact me.</span></font><br data_liveedit_tagid="0000000014872110"><br data_liveedit_tagid="000000001404F4E0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">Kind regards,</span></font><br data_liveedit_tagid="000000001404CDB0"><br data_liveedit_tagid="000000001404D010"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none; background-color: rgb(255, 255, 102);">[AM Name]</span><br></font><br data_liveedit_tagid="000000001404C190"><em data_liveedit_tagid="000000002FB4E290" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none;">Qantas Airways Limited</em></font></td></tr><tr data_liveedit_tagid="000000002FB46D70"><td valign="top" data_liveedit_tagid="000000002FB46EA0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="000000002FB47370"><td valign="top" data_liveedit_tagid="000000002FB43990" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="000000002FB43210"><td data_liveedit_tagid="0000000014A4C0B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000002FB47240" style="width: 680px;"><tbody data_liveedit_tagid="0000000013F565B0"><tr data_liveedit_tagid="0000000013FA2AF0"><td align="center" valign="top" data_liveedit_tagid="0000000013FBEFA0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="0000000014A498F0" style="font-size: 10px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="0000000014051490"><tr data_liveedit_tagid="