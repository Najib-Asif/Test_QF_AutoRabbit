                    <strong>Global Customer Code (FCI)</strong>
                </p>
            </td>
            <td width="412" valign="top">
                <p>
                    {!Account.Freight_Corporate_Identifier__c}
                </p>
            </td>
        </tr>
        <tr>
            <td width="350" valign="top">
                <p>
                    <strong>Billing Country</strong>
                </p>
            </td>
