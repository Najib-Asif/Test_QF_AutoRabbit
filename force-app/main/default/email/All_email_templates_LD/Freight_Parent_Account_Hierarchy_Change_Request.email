            </td>
        </tr>
           <td width="350" valign="top">
                <p>
                    <strong>DOM/INT Account</strong>
                </p>
            </td>
            <td width="412" valign="top">
                <p>
                    {!Account.Freight_Revenue_Stream__c}
                </p>
            </td>
        </tr>
        <tr>
            <td width="350" valign="top">
                <p>
                    <strong>Customer Code DOM</strong>
                </p>
            </td>
            <td width="412" valign="top">
                <p>
                    {!Account.Freight_Location__c}
                </p>
            </td>
        </tr>
        <tr>
            <td width="350" valign="top">
                <p>
                    <strong>Customer Code INT</strong>
                </p>
            </td>
            <td width="412" valign="top">
                <p>
