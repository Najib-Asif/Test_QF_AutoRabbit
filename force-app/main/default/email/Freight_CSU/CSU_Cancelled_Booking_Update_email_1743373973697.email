<html>
<head>
	<title></title>
</head>
<body style="height: auto; min-height: auto;">
<table align="center" class="MsoTableGrid" style="border-collapse:collapse; border:none">
	
		<tr>
			<td colspan="2" style="border-bottom:1px solid white; width:601px; padding:0cm 7px 0cm 7px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black" valign="top">
			<div style="text-align: center;"><br />
			<img alt="QANTAS FREIGHT LOGO.jpg" src="" style="max-width: 704.9px" title="QANTAS FREIGHT LOGO.jpg" /></div>
			&nbsp;

			<div style="text-align: center;">&nbsp;</div>
			</td>
		</tr>
		<tr>
			<td colspan="2" style="border-bottom:1px solid black; width:601px; padding:0cm 7px 0cm 7px; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top">
			<div style="text-align: center;"><span style="font-size:16px;"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="line-height:normal"><b><u>CASE TYPE:&nbsp;{{{Case.Type}}}</u></b></span></span></span><br />
			CURRENT STATUS:&nbsp;{{{Case.Sub_Type_1__c}}}<br />
			OUTCOME:&nbsp;{{{Case.Sub_Type_2__c}}}</div>
			<br />
			<span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><span style="font-size:10.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;">Hi [Name],</span></span></span></span></span></span></span><br />
			<br />
			<span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal">This email is to inform you that the below booking has been <u>cancelled</u>.</span></span></span><br />
			<br />
			&nbsp;</td>
		</tr>
		<tr>
			<td style="border-bottom:1px solid black; width:123px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">CUSTOMER</span></b></span></span></span></td>
			<td style="border-bottom:1px solid black; width:478px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:none"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">{{{Case.Freight_Customer_Name__c}}}</span></b></span></span></span></td>
		</tr>
		<tr>
			<td style="border-bottom:1px solid black; width:123px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">AWB</span></b></span></span></span></td>
			<td style="border-bottom:1px solid black; width:478px; padding:0cm 7px 0cm 7px; border-top:none; border-right:1px solid black; border-left:none"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b>{{{Case.Freight_AWB_Number__c}}}</b></span></span></span></td>
		</tr>
		<tr>
			<td style="border-bottom:1px solid black; width:123px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">FLIGHT NUMBER</span></b></span></span></span></td>
			<td style="border-bottom:1px solid black; width:478px; padding:0cm 7px 0cm 7px; border-top:none; border-right:1px solid black; border-left:none">&nbsp;</td>
		</tr>
		<tr>
			<td style="border-bottom:1px solid black; width:123px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">PIECES</span></b></span></span></span></td>
			<td style="border-bottom:1px solid black; width:478px; padding:0cm 7px 0cm 7px; border-top:none; border-right:1px solid black; border-left:none"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;">{{{Case.Freight_AWB_Pieces__c}}}</span></span></td>
		</tr>
		<tr>
			<td style="border-bottom:1px solid black; width:123px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">WEIGHT</span></b></span></span></span></td>
			<td style="border-bottom:1px solid black; width:478px; padding:0cm 7px 0cm 7px; border-top:none; border-right:1px solid black; border-left:none"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;">{{{Case.Freight_Weight__c}}}</span></span></td>
		</tr>
		<tr>
			<td style="border-bottom:1px solid black; width:123px; padding:0cm 7px 0cm 7px; background-color:#c00000; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal"><b><span style="color:white">COMMODITY</span></b></span></span></span></td>
			<td style="border-bottom:1px solid black; width:478px; padding:0cm 7px 0cm 7px; border-top:none; border-right:1px solid black; border-left:none"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;">{{{Case.Commodity__c}}}</span></span></td>
		</tr>
		<tr>
			<td colspan="2" style="border-bottom:1px solid black; width:601px; padding:0cm 7px 0cm 7px; background-color:black; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top">&nbsp;</td>
		</tr>
		<tr>
			<td colspan="2" style="border-bottom:1px solid black; width:601px; padding:0cm 7px 0cm 7px; height:188px; border-top:none; border-right:1px solid black; border-left:1px solid black" valign="top"><br />
			<br />
			<span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:14px;"><span style="line-height:normal">Please let us know if you need any further assistance.&nbsp;<br />
			<br />
			<br />
			Kind Regards,<br />
			<br />
			<b>Qantas Freight</b><br />
			Customer Service Team</span></span></span><br />
			&nbsp;</td>
		</tr>
	
</table>
</body>
</html>