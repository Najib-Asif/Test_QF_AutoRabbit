			<div style="text-align: center;">&nbsp;</div>

			<div style="text-align: center;"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><b><u><span style="font-size:10.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><strong>ISSUE TYPE:&nbsp;{{{Case.Type}}}</strong></span></span></u></b></span></span></span></div>

			<div style="text-align: center;"><strong>AWB:&nbsp;<span style="font-size:14px;"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><b><span style="font-family:&quot;Arial&quot;,sans-serif">{{{Case.Freight_AWB_Number__c}}}</span></b></span></span></span></strong></div>
