						<td style="border-bottom:1px solid black; width:293px; padding:0cm 7px 0cm 7px; border-top:1px solid black; border-right:1px solid black; border-left:none" valign="top"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><b><span style="font-family:&quot;Calibri&quot;,sans-serif">Attributes</span></b></span></span></span></td>
