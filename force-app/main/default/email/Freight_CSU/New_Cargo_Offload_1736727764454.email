			<div style="text-align: center;"><span style="font-size:12px;"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><b><u><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="font-family:Arial Black,Arial,Helvetica,sans-serif;">ISSUE TYPE:</span>&nbsp; &nbsp;<span style="font-family:Arial Black,Arial,Helvetica,sans-serif;">{{{Case.Sub_Type_1__c}}}</span></span></u></b></span></span></span></div>
