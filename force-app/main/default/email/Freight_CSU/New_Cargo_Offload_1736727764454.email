			<br />
			<span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><b><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#c00000">INFORMATION REGARDING YOUR BOOKING</span></span></b></span></span></span></div>
			</td>
		</tr>
		<tr>
