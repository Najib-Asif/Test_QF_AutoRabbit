			<span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Aptos,sans-serif"><b><span style="font-size:10.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="font-size:12px;"><span style="font-family:Arial Black,Arial,Helvetica,sans-serif;">Hello&nbsp;(Name),</span></span><br />
			<br />
			<span style="font-family:Arial Black,Arial,Helvetica,sans-serif;"><span style="font-size:12px;">The following booking did not depart&nbsp;as it was originally planned, we have provided the new revised flight details.</span></span></span></span></b></span></span></span><br />
			<br />
			&nbsp;
			<table class="MsoTableGrid" style="border-collapse:collapse; border:none">
				
					<tr>
