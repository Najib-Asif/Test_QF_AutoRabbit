<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; text-align: center;"><font style="" size="2" face="Arial, sans-serif">&nbsp;</font></div><br><div style=""><div style=""><font size="2" face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Hi&nbsp;</font><font face="Arial, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Contact.FirstName}</font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Arial, sans-serif"><br></font></div><div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><p class="MsoNormal" style="margin: 0cm 0cm 0.0001pt; font-size: 11pt; font-family: Calibri, sans-serif;">Thank you for your time today.<br><br></p><p class="MsoNormal" style="margin: 0cm 0cm 0.0001pt; font-size: 11pt; font-family: Calibri, sans-serif;">Please feel free to contact me on the below details should you require assistance with sales related enquiries.</p></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="background-color: rgb(255, 255, 255);"><font size="2" face="Arial, sans-serif"><br></font></div></div><div style=""><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Arial, sans-serif">Kind regards,</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2">{!User.Name}</font></p><p style=""><font face="Arial, sans-serif" size="2">{!User.Title}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="color: rgb(0, 0, 0); font-family: Arial, sans-serif; font-size: small;">Qantas Freight</span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2" style="color: rgb(0, 0, 0);">A:&nbsp;</font><font face="Arial, sans-serif" size="2">{!User.Address}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2">P:&nbsp;{!User.Phone}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" size="2">E:&nbsp;{!User.Email}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><a href="http://www.qantas.com/" style="font-family: Calibri, sans-serif; font-size: 14.6667px;"><span lang="EN-US" style="font-size: 10pt; line-height: 20px; font-family: Arial, sans-serif; color: windowtext; text-decoration-line: none;">qantas.com</span></a><span style="font-family: Calibri, sans-serif; font-size: 14.6667px;"><span lang="EN-US" style="font-size: 10pt; line-height: 20px; font-family: Arial, sans-serif;">&nbsp; | &nbsp;</span></span><a href="http://www.facebook.com/Qantas" style="font-family: Calibri, sans-serif; font-size: 14.6667px;"><span lang="EN-US" style="font-size: 10pt; line-height: 20px; font-family: Arial, sans-serif; color: windowtext; text-decoration-line: none;">facebook.com/qantas</span></a><span style="font-family: Calibri, sans-serif; font-size: 14.6667px;"><span lang="EN-US" style="font-size: 10pt; line-height: 20px; font-family: Arial, sans-serif;">&nbsp;&nbsp;| &nbsp;</span></span><a href="http://www.twitter.com/qantas" style="font-family: Calibri, sans-serif; font-size: 14.6667px;"><span lang="EN-US" style="font-size: 10pt; line-height: 20px; font-family: Arial, sans-serif; color: windowtext; text-decoration-line: none;">twitter @qantas</span></a><span style="font-family: Calibri, sans-serif; font-size: 14.6667px;"><span lang="EN-US" style="font-size: 10pt; line-height: 20px; font-family: Arial, sans-serif;">&nbsp;&nbsp;| &nbsp;</span></span><span lang="EN-US" style="font-family: Arial, sans-serif; font-size: 10pt; line-height: 20px; color: windowtext; text-decoration-line: none;"><a href="http://www.youtube.com/qantas" style="font-family: Calibri, sans-serif; font-size: 14.6667px;">youtube.com/qantas</a>