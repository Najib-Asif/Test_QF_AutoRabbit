r data_liveedit_tagid="0000000014523EA0"><td valign="top" data_liveedit_tagid="0000000014523780" style="padding: 0mm;"><table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="600" data_liveedit_tagid="00000000145201C0" style="width: 450pt;"><tbody><tr data_liveedit_tagid="000000001451F840" style="height: 22.5pt;"><td valign="top" data_liveedit_tagid="0000000014A922E0" style="padding: 0mm; height: 22.5pt;"><p class="MsoNormal" data_liveedit_tagid="000000002244A790" style="margin: 0mm; font-size: 11pt; font-family: Calibri, sans-serif; line-height: 15pt;"><span data_liveedit_tagid="000000001B9F17A0" style="font-size: 10.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">&nbsp;</span></p><p class="MsoNormal" data_liveedit_tagid="0000000014520090" style="margin: 0mm; font-size: 11pt; font-family: Calibri, sans-serif; line-height: 15pt;"><span data_liveedit_tagid="0000000014A95330" style="font-size: 10.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">&nbsp;</span></p><p class="MsoNormal" data_liveedit_tagid="0000000025BCFDB0" style="margin: 0mm; font-family: Calibri, sans-serif; line-height: 15pt;"><span data_liveedit_tagid="0000000025BCEE40" style="font-size: 10.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">Dear Agency Partner,<br data_liveedit_tagid="000000002600D090"><br data_liveedit_tagid="000000001B9FA5B0">Thank you for contacting us via the NDC Technology Support Contact Us </span><span data_liveedit_tagid="0000000025BCEE40" style="font-family: Arial, sans-serif; color: rgb(102, 102, 102);">form</span><span data_liveedit_tagid="0000000025BCEE40" style="font-size: 10.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">.<br data_liveedit_tagid="000000002A45D1B0"><br data_liveedit_tagid="00000000263653F0">To allow us to continue investigating this issue, we require some additional information. Could you please provide screenshots of the NDC shopping process starting from the input screen and showing your selections&nbsp;</span></p><p class="MsoNormal" data_liveedit_tagid="0000000025BCFDB0" style="margin: 0mm; font-family: Calibri, sans-serif; line-height: 15pt;"><span data_liveedit_tagid="0000000025BCEE40" style="font-size: 10.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);">We will provide a further update once we assess this information with our technology team.&nbsp;</span></p><p class="MsoNormal" data_liveedit_tagid="0000000025BCFDB0" style="margin: 0mm; font-family: Calibri, sans-serif; line-height: 15pt;"><br></p><p class="MsoNormal" data_liveedit_tagid="0000000014524350" style="margin: 0mm; line-height: 15pt;"><font color="#666666"><span style="font-family: Arial, sans-serif; font-size: 14px;">For more information on Qantas NDC and frequently asked questions, please visit <a href="https://help.qantas.com/agencyconnect/s/topic/0TOMo000000MuMvOAK/qantas-ndc">NDC FAQs</a></span></font></p><p class="MsoNormal" data_liveedit_tagid="0000000014524350" style="margin: 0mm; line-height: 15pt;"><font color="#666666"><br></font></p><p class="MsoNormal" data_liveedit_tagid="0000000014524350" style="margin: 0mm; font-size: 11pt; font-family: Calibri, sans-serif; line-height: 15pt;"><span data_liveedit_tagid="00000000145279D0" style="font-size: 10.5pt; font-family: Arial, sans-serif; color: rgb(102, 102, 102);"></span></p><p class="MsoNormal" data_liveedit_tagid="0000000014524350" style="margin: 0mm; line-height: 15pt;"><font color="#666666"><span style="font-family: Arial, sans-serif; font-size: 14px;">Thank you for assistance, we appreciate your cooperation</span></font></p><div><font color="#666666"><span style="font-family: Arial, sans-serif; font-size: 14px;"><br></span></font></div><p class="MsoNormal" data_liveedit_tagid="0000000014524350" style="margin: 0mm; font-size: 11pt; font-family: Calibri, sans-serif; line-height: 15pt;"><span data_liveedit_tagid="00000000145279D0" style="font-size: 10.5pt; font-family: Arial, sans-serif