0" cellpadding="0" cellspacing="0" id="main-content" width="600" data_liveedit_tagid="0000000012EF34C0" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="0000000012EF3720"><tr data_liveedit_tagid="0000000012EF3980"><td align="center" valign="top" data_liveedit_tagid="0000000012EF3BE0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: left;"><table border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="0000000012EF4090"><tbody data_liveedit_tagid="0000000012EF42F0"><tr data_liveedit_tagid="0000000012EF4550"><td valign="top" data_liveedit_tagid="0000000012EF47B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 40px; height: 30px;">&nbsp;</td></tr><tr data_liveedit_tagid="0000000012EF4FE0"><td align="left" valign="top" data_liveedit_tagid="0000000012EF5240" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">Dear Agency Partner,</td></tr><tr data_liveedit_tagid="0000000012EF5700"><td valign="top" data_liveedit_tagid="0000000012EF5960" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="0000000012EF5E20"><td align="left" valign="top" data_liveedit_tagid="0000000012EF6080" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">We are following up on your enquiry,&nbsp;<span style="background-color: rgb(255, 255, 102);">[brief description of issue</span>] and we thank you for your patience while we investigate your query.&nbsp;<br><br>We have been unable to replicate the issue and would like to check if you have attempted the action again and if the same error message appears?<br data_liveedit_tagid="0000000012EF2B80"><br data_liveedit_tagid="0000000012EF6670">If so, could you please respond to this email and provide any additional information and screenshots that might assist the investigation. Could you please also advise your technology partner so they can update the case with the new information.&nbsp;<br data_liveedit_tagid="0000000012EF68B0"><br data_liveedit_tagid="0000000012EF69C0">For more information on Qantas NDC and frequently asked questions, please visit <a href="https://help.qantas.com/agencyconnect/s/topic/0TOMo000000MuMvOAK/qantas-ndc">NDC FAQs</a>.<br data_liveedit_tagid="0000000012EF6C00"><br data_liveedit_tagid="0000000012EF6D10">Kind regards,<br data_liveedit_tagid="0000000012EF6F50"><br data_liveedit_tagid="0000000012EF7060"><strong data_liveedit_tagid="0000000012EF72A0">Qantas NDC Escalation Support</strong><br data_liveedit_tagid="0000000012EF7500"><em data_liveedit_tagid="0000000012EF7740">Qantas Airways Limited</em></td></tr><tr data_liveedit_tagid="0000000012EF7D30"><td valign="top" data_liveedit_tagid="0000000012EF7F90" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="0000000012EF8450"><td valign="top" data_liveedit_tagid="0000000012EF86B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="0000000012EFA180"><td data_liveedit_tagid="0000000012EFA3E0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000012EFA640" style="width: 680px;"><tbody data_liveedit_tagid="0000000012EFA8A0"><tr data_liveedit_tagid="0000000012EFAB00"><td align="center" valign="top" data_liveedit_tagid="0000000012EFAD60" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cell