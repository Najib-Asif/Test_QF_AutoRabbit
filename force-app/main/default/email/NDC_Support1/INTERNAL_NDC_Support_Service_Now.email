<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p class="MsoNormal" style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt; line-height: 0%;"><span style="font-family:&quot;Arial&quot;,sans-serif;
mso-fareast-font-family:&quot;Times New Roman&quot;;display:none;mso-hide:all;letter-spacing:
469.5pt">&nbsp;<o:p></o:p></span></p>

<p class="MsoNormal" style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt; line-height: 0%;"><br></p><table align="center" border="0" cellpadding="0" cellspacing="0" width="750" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="0000000017CD2C50"><tr data_liveedit_tagid="0000000017CD2EB0"><td style="line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="0000000017CD3370" style="background-color: rgb(255, 255, 255); text-align: center;"><tbody><tr><td valign="top" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000017CD3CF0" style="background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="0000000017CD3F50"><tr width="680" data_liveedit_tagid="0000000017CD41B0"><td align="center" data_liveedit_tagid="0000000017CD4410" style="font-variant-ligatures: none; font-size: 10px; color: rgb(102, 102, 102); line-height: 20px; text-align: center; height: 0px; width: 680px;"><div data_liveedit_tagid="0000000017CD4670" style="height: 5px; line-height: 5px;"><font face="Arial, sans-serif">&nbsp;</font></div></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000017CD5370" style="width: 680px;"><tbody data_liveedit_tagid="0000000017CD55D0"><tr data_liveedit_tagid="0000000017CD5830"><td data_liveedit_tagid="0000000017CD5A90" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><a href="https://www.qantas.com/agencyconnect/au/en.html" target="_blank" data_liveedit_tagid="0000000017CD5CF0" style="color: rgb(102, 102, 102); text-decoration-line: none; border: 0px;"><font face="Arial, sans-serif"><img border="0" src="http://qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/header/Qantas-NDC-support.png" title="Qantas" style="width: 680px; height: 70px;"></font></a></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" id="main-content" width="600" data_liveedit_tagid="0000000017CD6760" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="0000000017CD69C0"><tr data_liveedit_tagid="0000000017CD6C20"><td align="center" valign="top" data_liveedit_tagid="0000000017CD6E80" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: left;"><table border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="0000000017CD7330"><tbody data_liveedit_tagid="0000000017ECC000"><tr data_liveedit_tagid="0000000017ECC260"><td valign="top" data_liveedit_tagid="0000000017ECC4C0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 40px; height: 30px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000017ECCCF0"><td align="left" valign="top" data_liveedit_tagid="0000000017ECCF50" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">Dear <span style="background: yellow;">[Name]</span></p><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">&nbsp;</p><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">Thanks for your enquiry regarding NDC.</p><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">All internal requests in relation to NDC issues/queries are to be logged via Service Now.</p><ul type="disc" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal; margin-top: 0cm;"><li class="MsoListParagraph" style="margin-left: 0cm;">Please log in to <a href="https://qantas.service-now.com/digital">Service Now</a></li><li class="MsoListParagraph" style="margin-left: 0cm;">If the issue is new, click on “Report a Fault”</li><li class="MsoListParagraph" style="margin-left: 0cm;">In the Digital Product Name Search Field, enter in ‘NDC’ in free text</li><li class="MsoListParagraph" style="margin-left: 0cm;">Select the category that best describes your issue</li><li class="MsoListParagraph" style="margin-left: 0cm;">Enter a short description outlining the problem</li><li class="MsoListParagraph" style="margin-left: 0cm;">Provide as much info as possible, including uploading attachments and screenshots.</li><li class="MsoListParagraph" style="margin-left: 0cm;">Ensure to include agents PCC and tech partner</li><li class="MsoListParagraph" style="margin-left: 0cm;">Submit the fault. An RITM will be generated for tracking, you will receive an email with the details&nbsp;</li></ul><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">You can track the status of your RITM by Clicking on “My Queries” on the Service Now home page (top right next to your name).</p><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">You will receive an email update when the issue as the case progresses and when it is resolved.</p><p class="MsoNormal" style="color: rgb(93, 93, 93); font-family: &quot;Segoe Sans&quot;, &quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; font-variant-ligatures: normal;">Thank you for your support with this change of process.</p></td></tr><tr data_liveedit_tagid="0000000017ECD410"><td valign="top" data_liveedit_tagid="0000000017ECD670" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><br></td></tr><tr data_liveedit_tagid="0000000017ECDB30"><td align="left" valign="top" data_liveedit_tagid="0000000017ECDD90" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif"><br data_liveedit_tagid="0000000017ECF0C0">Kind regards,<br data_liveedit_tagid="0000000017ECF300"><br data_liveedit_tagid="0000000017ECF410"><strong data_liveedit_tagid="0000000017ECF650">NDC Escalation Support</strong><br data_liveedit_tagid="0000000017ECF8B0"><em data_liveedit_tagid="0000000017ECFAF0">Qantas Airways Limited</em></font></td></tr><tr data_liveedit_tagid="0000000017ED00E0"><td valign="top" data_liveedit_tagid="0000000017ED0340" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000017ED0800"><td valign="top" data_liveedit_tagid="0000000017ED0A60" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="0000000017ED2530"><td data_liveedit_tagid="0000000017ED2790" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000017ED29F0" style="width: 680px;"><tbody data_liveedit_tagid="0000000017ED2C50"><tr data_liveedit_tagid="0000000017ED2EB0"><td align="center" valign="top" data_liveedit_tagid="0000000017ED3110" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="0000000017ED3370" style="font-size: 10px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="0000000017ED35D0"><tr data_liveedit_tagid="0000000017ED3830"><td data_liveedit_tagid="0000000017ED3A90" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000017ED3F50"><td align="center" valign="top" width="600" data_liveedit_tagid="0000000017ED41B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; margin-left: 40px; margin-right: 40px;"><table align="center" border="0" cellpadding="0" width="600" data_liveedit_tagid="0000000017ED4410" style="margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="0000000017ED4670"><tr data_liveedit_tagid="0000000017ED48D0"><td align="left" data_liveedit_tagid="0000000017ED4B30" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 2