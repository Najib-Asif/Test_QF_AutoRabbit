				color: #E40000 !important;
			}
			.color_four {
				color: #161616 !important;
			}			
			.color_five {
				color: #7B7B7B !important;
			}
			.color_six {
				color: #323232 !important;
			}
			h1 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:28px; 
				color: #161616; 
				line-height:32px;
				font-weight:400;
			}
			h2 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:22px; 
				color: #161616; 
				line-height:26px;
				font-weight:400;
			}
			h3 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:18px; 
				color: #161616; 
				line-height:22px;
				font-weight:400;
			}
			ul {
				margin:5px 0 0 40px;
				padding:0 0 0 1px;
				color:#666666;
			}			
			ol {
				font-family: Arial, Verdana, sans-serif;
				margin:0 0 0 15px;
				padding:0 0 0 15px;
				color:#E40000;
			}			
			li {
				font-family: Arial, Verdana, sans-serif;
				font-weight: normal;
				line-height:20px;
				margin: 10px 0 0 15px;
				padding: 0 10px 0 0;
			}
			
			li span {
				font-family: Arial, Verdana, sans-serif;
				font-weight: normal;
				line-height:20px;
				color:#666666;
				margin: 0 10px 0 0;
				padding: 0 10px 0 0;
			}
			.t_c ul {
				margin:0 0 0 1px;
				padding:0 0 0 1px;
				color:#7B7B7B;
			}
			.t_c ol {
				margin:0 0 0 1px;
				padding:0 0 0 1px;
				color:#E40000;
			}
			.t_c li {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 10px; 
				line-height:15px; 
				text-align: left;
				color: #7B7B7B; 
				margin:0;
				padding: 0 10px 0 0;
			}
			.t_c li span {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 10px; 
				line-height:13px; 
				text-align: left;
				color: #7B7B7B; 
				margin:0;
