<!DOCTYPE html>
<html style="overflow-y: hidden;">
<head><meta><meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1">
	<style type="text/css">body {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:14px; 
				color:#666666;
				background:#F4F5F6;
			}
			th {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 14px;
				color: #FFFFFF;
				text-align: center;
				height: 20px;
				font-weight: normal;
				width: 147px; 
				padding: 10px 5px 10px 5px;
			}
			.discountTD th {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 14px;
				text-align: center;
				height: 20px;
				font-weight: normal;
				width: 147px;
				padding: 20px 10px 20px 10px;
				color: #FFFFFF; 
				background-color: #E40000;
			}	
			.discountTD td {
				font-family: Arial, Verdana, sans-serif;
				text-align: center;
				padding: 20px 10px 20px 10px;
				border-style: solid;  
				border-width: 1px; 
				border-color: #F5F5F5;
			}			
			td {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:14px;
				color:#666666;
				line-height: 20px;
			}
			p {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:14px;
				padding:0;
				margin:0 0 2px 0;
				color:#666666;
			}
			div {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
			}
			sup {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				vertical-align: super;
				font-size: x-small;
			}
			/*  ========================== Sup For Mapp ========================== */
			sup.mapp {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				vertical-align: super;
				font-size: larger;
			}	
			#main-content sup.mapp_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: initial;
				font-size: 19px;
			}
			#main-content sup.mapp_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 10px;
				vertical-align: super;
				font-size: x-small;
			}
			.t_c sup.mapp {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: larger;
			}
			/*  !!   It is better just use ~^*  without sup tag   !! */
			.t_c sup.mapp_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: initial;
				font-size: larger;
			}
			.t_c sup.mapp_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: smaller;
			}
			/*  ==========================  End of Sup For Mapp  ========================== */
			/* -------------------------- Sup  For Salesforce -------------------------- */
			sup.salesforce {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				vertical-align: super;
				font-size: larger;
			}		
			#main-content sup.salesforce_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: small;
			}
			#main-content sup.salesforce_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: x-small;
			}
			.t_c sup.salesforce {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: larger;
			}
			/*  !!   It is better just use ~^*  without sup tag   !! */
			.t_c sup.salesforce_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: x-small;
			}
			.t_c sup.salesforce_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: smaller;
			}
			/* ----------------------- End of Sup  For Salesforce ----------------------- */	
			hr { 
				height:2px; 
				border-width:0; 
				color:#DADADA; 
				background-color:#DADADA;
			}
			.t_c {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 10px; 
				line-height:13px; 
				text-align: left;
				color: #7B7B7B; 
				height:13px;
			}			
			.t_c a {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:10px;
				color: #7B7B7B;
				text-decoration:underline;	
			}
			a {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #666666;
				text-decoration: none;
				border:0;
			}			
			a.two {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #E40000 !important;
				text-decoration: none !important;
				border:0;
			}			
			a.three {
				font-family: Arial, Verdana, sans-serif;
