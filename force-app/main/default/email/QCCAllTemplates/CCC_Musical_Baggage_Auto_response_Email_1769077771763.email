<body style="height: auto; min-height: auto;"><span style="font-size:12pt"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Thank you for contacting Qantas.&nbsp;</span></span></span></span></span></span><br />
<span style="font-size:12pt"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">If you have booked via a Travel Agent, your request will not be processed by Qantas Reservations.&nbsp;<br />
Please contact your Travel Agent directly to process your request.&nbsp; &nbsp;<br />
&nbsp;</span></span></span></span></span></span><br />
<span style="font-size:12pt"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><b><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Important:</span></span></span></b>&nbsp;</span></span></span>
<ul>
	<li><span style="font-size:12pt"><span style="tab-stops:list .5in"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Your request will be processed within 5 calendar days.&nbsp;&nbsp;</span></span></span></span></span></span></span></li>
	<li><span style="font-size:12pt"><span style="tab-stops:list .5in"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Ineligible and late requests will not be processed, and standard&nbsp;</span></span></span></span></span></span></span><a href="https://www.qantas.com/en-au/baggage/pre-purchase-additional">excess baggage fees</a><span style="font-size:12pt"><span style="tab-stops:list .5in"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">&nbsp;will be payable.&nbsp;</span></span></span></span></span></span></span></li>
	<li><span style="font-size:12pt"><span style="tab-stops:list .5in"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Late requests will not be accepted by email.&nbsp; Please contact 131313 for urgent requests and quote KIQ4141 to our team.&nbsp;</span></span></span></span></span></span></span></li>
	<li><span style="font-size:12pt"><span style="tab-stops:list .5in"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif"><span lang="EN-AU" style="font-size:11.0pt"><span style="line-height:115%"><span style="font-family:&quot;Calibri&quot;,sans-serif">Requests made over the phone via contact centers will incur a $45 service fee per person/per booking.&nbsp;</span></span></span></span></span></span></span></li>
</ul>
<span style="font-size:12pt"><span style="line-height:115%"><span style="font-family:Aptos,sans-serif">&nbsp;</span></span></span><br />
