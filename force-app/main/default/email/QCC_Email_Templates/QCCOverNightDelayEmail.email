<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p class="x_MsoNormal" style="color: rgb(33, 33, 33); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" style="" size="2">Hi Customer Operations,</font></p><p class="x_MsoNormal" style="color: rgb(33, 33, 33); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2">&nbsp;</font></p><p class="x_MsoNormal" style="color: rgb(33, 33, 33); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Customer Operations, please take relevant actions for the below flight that is overnighting.</font></p><p class="x_MsoNormal" style="color: rgb(33, 33, 33); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2">&nbsp;</font></p><p class="x_MsoNormal" style="color: rgb(0, 0, 0); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><span style="color: rgb(33, 33, 33);">&nbsp; &nbsp; &nbsp;Flight Number :&nbsp;&nbsp;</span><font color="#212121">{!Event__c.FlightNumber__c}</font></font></p><p class="x_MsoNormal" style="color: rgb(0, 0, 0); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><span style="color: rgb(33, 33, 33);">&nbsp; &nbsp; &nbsp;Departure Port :&nbsp;&nbsp;</span><font color="#212121">{!Event__c.DeparturePort__c}</font></font></p><p class="x_MsoNormal" style="color: rgb(0, 0, 0); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><span style="color: rgb(33, 33, 33);">&nbsp; &nbsp; &nbsp;Arrival Port :&nbsp;&nbsp;</span><font color="#212121">{!Event__c.ArrivalPort__c}</font></font></p><p class="x_MsoNormal" style="color: rgb(0, 0, 0); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><span style="color: rgb(33, 33, 33);">&nbsp; &nbsp; &nbsp;Scheduled Local Departure Date/Time :&nbsp;&nbsp;</span><font color="#212121">{!Event__c.Scheduled_Departure__c}</font></font></p><p class="x_MsoNormal" style="color: rgb(0, 0, 0); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><font style="color: rgb(0, 0, 0);"><span style="color: rgb(33, 33, 33);">&nbsp; &nbsp; &nbsp;</span></font><span style="color: rgb(33, 33, 33);">Local Scheduled Arrival Date/Time :&nbsp;&nbsp;</span><font color="#212121" style="">{!Event__c.ScheduledArrDateTime__c}</font></font></p><p class="x_MsoNormal" style="color: rgb(0, 0, 0); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2"><span style="color: rgb(33, 33, 33);">&nbsp; &nbsp;</span></font></p><p class="x_MsoNormal" style="color: rgb(33, 33, 33); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" size="2">Regards,</font></p><p class="x_MsoNormal" style="color: rgb(33, 33, 33); margin: 0cm 0cm 0.0001pt; background-color: rgb(255, 255, 255);"><font face="Arial, sans-serif" style="" size="2">Qantas CJM</font></p>]]></td>
