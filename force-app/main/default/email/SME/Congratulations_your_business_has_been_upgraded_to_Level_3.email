style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><a href="https://www.qantas.com/au/en/business-rewards/" target="_blank" data_liveedit_tagid="0000000013BA0E80" style="color: rgb(102, 102, 102); text-decoration-line: none; border: 0px;"><font face="Arial, sans-serif"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/QBR_eDM_Banner.jpg" title="Qantas Business Rewards" style="width: 680px;"></font></a></td></tr><tr data_liveedit_tagid="0000000013BA18F0"><td data_liveedit_tagid="0000000013BA1B50" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/images/qbr-asq-680x355.jpg" style="width: 680px;"></font></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" id="main-content" width="600" data_liveedit_tagid="0000000013BA2830" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="0000000013BA2A90"><tr data_liveedit_tagid="0000000013BA2CF0"><td align="center" valign="top" data_liveedit_tagid="0000000013BA2F50" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: left;"><table border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="0000000013BA3400"><tbody data_liveedit_tagid="0000000013BA3660"><tr data_liveedit_tagid="0000000013BA38C0"><td valign="top" data_liveedit_tagid="0000000013BA3B20" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000013BA4350"><td align="left" valign="top" data_liveedit_tagid="0000000013BA45B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><h3 data_liveedit_tagid="0000000013BA4810" style="font-size: 18px; color: rgb(22, 22, 22); font-weight: 400; margin: 0px; padding: 0px;"><font face="Arial, sans-serif">Congratulations, your business has been upgraded to Level 3</font></h3></td></tr><tr data_liveedit_tagid="0000000013BA4E00"><td valign="top" data_liveedit_tagid="0000000013BA5060" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000013BA5520"><td align="left" valign="top" data_liveedit_tagid="0000000013BA5780" style="line-height: 20px;"><font face="Arial, sans-serif" style=""><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">Hi {!Contact.FirstName},</span></font><br data_liveedit_tagid="0000000013BA0FB0"><br data_liveedit_tagid="0000000013BA59E0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">In recognition of </span></font><span style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none; background-color: rgb(255, 255, 51);">XXX</span><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">'s partnership with Qantas, and as a valued member of Qantas Business Rewards, we are pleased to advise that&nbsp;</span></font><span data_liveedit_tagid="0000000013BA5C20" style=""><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;"><b>{!Account.Name}&nbsp;</b></span></font><b style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none;">has been upgraded to Level 3</b></span><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">.</span></font><br data_liveedit_tagid="0000000013BA5FB0"><br data_liveedit_tagid="0000000013BA60C0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">As a Level 3 member your business has access to the highest level of benefits in the program, which means you can unlock more rewards, bigger savings, and greater value.</span></font><br data_liveedit_tagid="0000000013BA6300"><br data_liveedit_tagid="0000000013BA6410"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">As part of upgrading your business to Level 3, we would like to invite you to&nbsp;</span></font><strong data_liveedit_tagid="0000000013BA6650" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none;">schedule a call</strong><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">&nbsp;with one of our team members who will provide an overview of the Program, the new benefits available to you and tips on how to get the most out of your membership. If you are interested in this, please reply with confirmation of your availability for a call and one of our team will be in contact with you.</span></font><br data_liveedit_tagid="0000000013BA69E0"><br data_liveedit_tagid="0000000013BA6AF0"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">In the meantime, to find out your benefits as a Level 3 member, visit our&nbsp;</span></font><a href="https://www.qantas.com/au/en/business-rewards/home.html" target="_blank" data_liveedit_tagid="0000000013BA6D30" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none; border: 0px;">website</a><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">&nbsp;or log in to your&nbsp;</span></font><a href="https://accounts.qantas.com/qbr/identity/login?oauth-type=qbr" target="_blank" data_liveedit_tagid="0000000013BA70C0" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none; border: 0px;">account</a><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">.</span></font><br data_liveedit_tagid="0000000013BA7450"><br data_liveedit_tagid="0000000013BA7560"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">For assistance with your account, please call our Service Centre on 13 74 78 between 7am-7pm AEST, Monday to Friday.</span></font><br data_liveedit_tagid="0000000013BA77A0"><br data_liveedit_tagid="0000000013BA78B0"><em data_liveedit_tagid="0000000013BA7AF0" style="color: rgb(102, 102, 102); font-size: 14px; font-variant-ligatures: none;">Qantas Business Rewards</em></font></td></tr><tr data_liveedit_tagid="0000000013BA80E0"><td valign="top" data_liveedit_tagid="0000000013BA8340" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000013BA8800"><td valign="top" data_liveedit_tagid="0000000013BA8A60" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="0000000013BA9E50"><td data_liveedit_tagid="0000000013BAA0B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000013BAA310" style="width: 680px;"><tbody data_liveedit_tagid="0000000015E53010"><tr data_liveedit_tagid="0000000015E53270"><td align="center" valign="top" data_liveedit_tagid="0000000015E534D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="0000000015E53730" style="font-size: 10px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="0000000015E53990"><tr data_liveedit_tagid="0000000015E53BF0"><td data_liveedit_tagid="0000000015E53E50" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 10