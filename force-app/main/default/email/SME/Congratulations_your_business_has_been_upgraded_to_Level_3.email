td border="0" hspace="0" vspace="0" data_liveedit_tagid="0000000015E5AC40" style="font-variant-ligatures: none; color: rgb(123, 123, 123); line-height: 13px; text-align: center;"><font face="Arial, sans-serif">To unsubscribe from Qantas updates or marketing offers, contact your Qantas representative&nbsp;<a href="mailto:?subject=Unsubscribe%20from%20Qantas%20marketing%20offers" target="_blank" title="Unsubscribe" data_liveedit_tagid="0000000015E5AEA0" style="color: rgb(123, 123, 123); border: 0px;">here</a>&nbsp;to unsubscribe.</font></td></tr><tr data_liveedit_tagid="0000000015E5B490"><td data_liveedit_tagid="0000000015E5B6F0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px; margin: 0px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></div></div></div></div>]]></td>
