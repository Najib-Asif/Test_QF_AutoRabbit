ing="0" cellspacing="0" data_liveedit_tagid="0000000016D1D3B0"><tbody><tr data_liveedit_tagid="00000000167B36C0"><td align="left" valign="top" data_liveedit_tagid="0000000016D1CE00" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000187AE430"><tbody><tr data_liveedit_tagid="00000000167B2D40"><td align="left" valign="top" data_liveedit_tagid="00000000167B3CB0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/flyer-bonus-icon.png" data_liveedit_tagid="0000000016D1D060" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px;"></td></tr></tbody></table></td><td data_liveedit_tagid="00000000167B4040" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="0000000016D1D170"></font></td><td align="center" valign="top" data_liveedit_tagid="00000000167B3460" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: top; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167B3200"><tbody><tr data_liveedit_tagid="00000000167B2FA0"><td align="left" data_liveedit_tagid="00000000167B5200" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="00000000167B5460">Flyer bonus</strong><br data_liveedit_tagid="00000000167B1470">250 bonus Qantas Points per booking for Frequent Flyers<sup data_liveedit_tagid="00000000167B8820" style="font-size: 11px; line-height: 8px;">+</sup>, every time they fly for work, on top of the points and Status Credits they already earn.<sup data_liveedit_tagid="00000000167B7EA0" style="font-size: 10px; line-height: 8px;">#</sup></font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="00000000167B4FA0"><td valign="top" data_liveedit_tagid="00000000167B4D40" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000167B7670"><td align="left" valign="top" data_liveedit_tagid="00000000167B7410" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">Just ensure you and your team&nbsp;<strong data_liveedit_tagid="00000000167B8100">include your business' ABN and Qantas Frequent Flyer number in the booking so you never miss a point.</strong></font></td></tr><tr data_liveedit_tagid="00000000167B91A0"><td data_liveedit_tagid="00000000167B85C0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; margin: 0px; padding: 0px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="00000000187AF580"></font><hr data_liveedit_tagid="00000000167B9530" style="height: 2px; border-width: 0px; color: rgb(218, 218, 218); background-color: rgb(218, 218, 218);"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="00000000167B9640"></font></td></tr><tr data_liveedit_tagid="00000000167B9BD0"><td align="left" valign="top" data_liveedit_tagid="00000000167B9D00" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">If you require any assistance or wish to speak with a team member regarding your account, please contact the relevant team below.</font><ul data_liveedit_tagid="00000000167B9E30" style="margin: 5px 0px 0px; padding: 0px 0px 0px 1px;"><li data_liveedit_tagid="000000001BFB3BA0" style="margin: 15px 0px 0px; padding: 0px 10px 0px 0px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="000000001BFB3E00">Qantas Business Rewards: 13 74 78 option 1</strong>, for non-booking related queries, updating profile information, login assistance.</font></li><li data_liveedit_tagid="000000001BFB4290" style="margin: 15px 0px 0px; padding: 0px 10px 0px 0px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="000000001BFB57C0">Qantas Business Rewards: 13 74 78 option 2</strong>, for booking related queries (please note any bookings made via a Travel Agent will need to be managed via your Travel Agent).</font></li><li data_liveedit_tagid="000000001BFB5A20" style="margin: 15px 0px 0px; padding: 0px 10px 0px 0px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="000000001BFB4D10">Qantas Club: 13 74 78 option 1</strong>, or join via your&nbsp;<a href="https://www.qantas.com/au/en/business-rewards/qbr/qantas-club" data_liveedit_tagid="000000001BFB50A0" style="color: rgb(102, 102, 102); border: 0px;">Qantas Business Rewards Account</a>.</font></li></ul><font face="Arial, sans-serif"><br data_liveedit_tagid="00000000167B9880">Kind regards,<br data_liveedit_tagid="00000000167B9990"><br data_liveedit_tagid="0000000016BF8CA0"><strong data_liveedit_tagid="000000001BFB44F0">{!User.FirstName} {!User.LastName}</strong><br data_liveedit_tagid="000000001933D780">{!User.Title}<br data_liveedit_tagid="00000000187B0CF0">Qantas Business Rewards</font></td></tr><tr data_liveedit_tagid="000000001BFB4980"><td valign="top" data_liveedit_tagid="00000000187AF260" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000187B12B0"><td valign="top" data_liveedit_tagid="00000000187B1510" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000187B1770"><td data_liveedit_tagid="00000000187B19D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/images/why-fly-qantas-24.png" width="600" data_liveedit_tagid="00000000187B0260" style="width: 600px; display: block;"></td></tr><tr data_liveedit_tagid="0000000018F06050"><td valign="top" data_liveedit_tagid="0000000018F04440" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000187B1C30"><td align="left" valign="top" data_liveedit_tagid="00000000187B0960" style="font-variant-ligatures: none; font-size: 9px; color: rgb(102, 102, 102); line-height: 12px;"><font face="Arial, sans-serif">1. Selected featured content may not be available on your flight. Inflight entertainment varies by route and aircraft.<br data_liveedit_tagid="00000000187ACCF0"><br data_liveedit_tagid="00000000187ABA20">2. Meals, beverages, entertainment offerings vary between flight times. Alcohol offered during select flight times on select flights.<br data_liveedit_tagid="00000000187AAF90"><br data_liveedit_tagid="00000000187A82C0">3. Qantas Club membership and access is subject to the&nbsp;<a href="https://www.qantas.com/au/en/frequent-flyer/the-qantas-club/terms-conditions.html" target="_blank" data_liveedit_tagid="00000000187AF690" style="color: rgb(102, 102, 102); border: 0px;">terms and conditions</a>&nbsp;of the Qantas Club.<br data_liveedit_tagid="00000000187A6FF0"><br data_liveedit_tagid="00000000187A3600">4. The number of destinations is correct as at 5 February 2024, but is subject to change.<br data_liveedit_tagid="0000000019526500"><br data_liveedit_tagid="000000001B7EB0E0">5. You must be a member of the Qantas Frequent Flyer program to earn and redeem Qantas Points. A joining fee may apply. Membership and Qantas Points are subject to the Qantas Frequent Flyer program terms and conditions.</font></td></tr><tr data_liveedit_tagid="00000000187AF8F0"><td valign="top" data_liveedit_tagid="00000000187AFB50" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000187AFDB0"><td valign="top" data_liveedit_tagid="00000000187AA160" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="00000000187ABFE0"><td data_liveedit_tagid="00000000187AC240" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000187AC4A0" style="width: 680px;"><tbody data_liveedit_tagid="00000000187AC700"><tr data_liveedit_tagid="00000000187ACF30"><td align="center" valign="top" data_liveedit_tagid="00000000187AC960" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="00000000187AB690" style="font-size: 10px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="00000000187AA3C0"><tr data_liveedit_tagid="00000000187AA620"><td data_liveedit_tagid="00000000187AA880" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000187AAAE0"><td align="center" valign="top" width="600" data_liveedit_tagid="00000000187A5840" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102);