<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div align="center" style=""><div align="center" style="text-align: center;"><div align="center" data_liveedit_tagid="0000000020F36970" style="font-size: medium;"><div align="center" style=""><div align="center"><div align="center"><table border="0" cellspacing="0" cellpadding="0" style="background-color: rgb(244, 245, 246); width: 562.5pt;"><tbody><tr><td style="padding: 0cm;"><div align="center"><table id="table_1" border="0" cellspacing="0" cellpadding="0" style="background-color: white; width: 510pt;"><tbody><tr><td style="padding: 0cm; vertical-align: top;"><div align="center"><table border="0" cellspacing="0" cellpadding="0" style="background-color: rgb(244, 245, 246);"><tbody><tr><td style="padding: 0cm; width: 510pt; height: 30pt;"><p style="text-align: center; line-height: 11.25pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 7.5pt; color: rgb(102, 102, 102);" data-olk-copy-source="MailCompose">&nbsp;</span></p><p style="text-align: center; line-height: 11.25pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 8pt; color: rgb(102, 102, 102);">Qantas Business Rewards</span></p><p style="line-height: 11.25pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 7.5pt; color: rgb(102, 102, 102);">&nbsp;</span></p></td></tr></tbody></table></div><p style="text-align: center; line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 14px; color: rgb(102, 102, 102);"><img src="data:image/png;base64," id="Picture_x0020_37" data-imagetype="AttachmentByCid" data-custom="AAkALgAAAAAAHYQDEapmEc2byACqAC%2FEWg0AMq54F9Gjo0aCp%2FB1oRzNiwAJ1a08%2FgAAARIAEABikKoV1JHtTY4QGHCGt9hG" width="679" height="70" style="width: 679px; height: 70px; margin-top: 0px; margin-bottom: 0px;"></span></p><p style="text-align: center; line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);">&nbsp;</span></p><p style="text-align: center; line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);"><br></span></p><div align="center"><table border="0" cellspacing="0" cellpadding="0" style="width: 450pt;"><tbody><tr><td style="padding: 0cm; vertical-align: top;"><table border="0" cellspacing="0" cellpadding="0" style="width: 450pt;"><tbody><tr><td style="padding: 0cm; vertical-align: top;"><p style="line-height: 15pt; margin: 0cm;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);">Hi&nbsp;</span><span style="text-align: center; font-size: 14px;"><font color="#666666" face="Arial, sans-serif">{!Contact.FirstName},</font></span></p><p style="line-height: 15pt; margin: 0cm;"><span style="text-align: center; font-size: 14px;"><font color="#666666" face="Arial, sans-serif"><br></font></span></p><p style="line-height: 15pt; margin: 0cm;"><span style="text-align: center; font-size: 14px;"><font color="#666666" face="Arial, sans-serif">Thank you for contacting Qantas Business Rewards.</font></span></p><p style="line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);">&nbsp;</span></p><p style="line-height: 15pt; margin: 0cm;"><font color="#666666" face="Arial, sans-serif"><span style="font-size: 14px;">For support with a Qantas Business Rewards flight booking, including making or changing a booking, upgrades, refund enquiries, using Qantas Points or Travel Fund as payment, please contact the Qantas Business Rewards Service Centre on 13 74 78 option 2, available 24 hours, 7 days a week.</span></font></p><p style="line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);">&nbsp;</span></p><p style="line-height: 15pt; margin: 0cm;"><font color="#666666" face="Arial, sans-serif"><span style="font-size: 14px;">If you would like to speak with a Qantas Business Rewards sales specialist about how to get the most value out of benefits or manage business travel, please call 13 10 85, Monday to Friday, 8:30am to 5:30pm AEST.</span></font></p><p style="line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);"><br>Kind regards,<br><br></span></p><p style="line-height: 15pt; margin: 0cm;"><font color="#666666" face="Arial, sans-serif"><span style="font-size: 14px;">{!User.Name}</span></font><br><b style="color: rgb(102, 102, 102); font-family: Arial, sans-serif; font-size: 10.5pt;">Qantas Business Rewards team</b></p></td></tr><tr><td style="padding: 0cm; vertical-align: top; height: 15pt;"><p style="line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);">&nbsp;</span></p></td></tr><tr><td style="padding: 0cm; vertical-align: top; height: 15pt;"><p style="line-height: 15pt; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><span style="font-family: Arial, sans-serif; font-size: 10.5pt; color: rgb(102, 102, 102);">&nbsp;</span></p></td></tr></tbody></table></td></tr></tbody></table></div><p style="text-align: center; margin: 0cm; font-family: Calibri, sans-serif; font-size: 11pt;"><br></p></td></tr><tr><td style="padding: 0cm;"><div align="center"><table border="0" cellspacing="0" cellpadding="0" style="width: 510pt;"><tbody><tr><td style="padding: 0cm; vertical-align: top;"><div align="cen