<!DOCTYPE html>
<html style="overflow-y: hidden;">
<head><meta><meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1">
	<style type="text/css">body {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:14px; 
				color:#666666;
			}
			th {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 14px;
				color: #FFFFFF;
				text-align: center;
				height: 20px;
				font-weight: normal;
				width: 147px; 
				padding: 10px 5px 10px 5px;
			}
			.discountTD th {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 14px;
				text-align: center;
				height: 20px;
				font-weight: normal;
				width: 147px;
				padding: 20px 10px 20px 10px;
				color: #FFFFFF; 
				background-color: #E40000;
			}	
			.discountTD td {
				font-family: Arial, Verdana, sans-serif;
				text-align: center;
				padding: 20px 10px 20px 10px;
				
			}			
			td {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:14px;
				color:#666666;
				line-height: 20px;
			}
			p {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:14px;
				padding:0;
				margin:0 0 2px 0;
				color:#666666;
			}
			div {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
			}
			sup {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				vertical-align: super;
				font-size: x-small;
			}
			/*  ========================== Sup For Mapp ========================== */
			sup.mapp {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				vertical-align: super;
				font-size: larger;
			}	
			#main-content sup.mapp_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: initial;
				font-size: 19px;
			}
			#main-content sup.mapp_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 10px;
				vertical-align: super;
				font-size: x-small;
			}
			.t_c sup.mapp {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: larger;
			}
			/*  !!   It is better just use ~^*  without sup tag   !! */
			.t_c sup.mapp_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: initial;
				font-size: larger;
			}
			.t_c sup.mapp_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: smaller;
			}
			/*  ==========================  End of Sup For Mapp  ========================== */
			/* -------------------------- Sup  For Salesforce -------------------------- */
			sup.salesforce {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				vertical-align: super;
				font-size: larger;
			}		
			#main-content sup.salesforce_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: small;
			}
			#main-content sup.salesforce_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: x-small;
			}
			.t_c sup.salesforce {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: larger;
			}
			/*  !!   It is better just use ~^*  without sup tag   !! */
			.t_c sup.salesforce_curl {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: x-small;
			}
			.t_c sup.salesforce_num {
				font-family: Arial, Verdana, sans-serif;
				line-height: 0px;
				vertical-align: super;
				font-size: smaller;
			}
			/* ----------------------- End of Sup  For Salesforce ----------------------- */	
			hr { 
				height:2px; 
				border-width:0; 
				color:#DADADA; 
				background-color:#DADADA;
			}
			.t_c {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 10px; 
				line-height:13px; 
				text-align: left;
				color: #7B7B7B; 
				height:13px;
			}			
			.t_c a {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:10px;
				color: #7B7B7B;
				text-decoration:underline;	
			}
			a {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #666666;
				text-decoration: none;
				border:0;
			}			
			a.two {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #E40000 !important;
				text-decoration: none !important;
				border:0;
			}			
			a.three {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #666666;
				text-decoration: none;
				border:0;
			}
			a.four {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #161616;
				border:0;
			}
			a.five {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #7B7B7B;
				border:0;
			}
			a.six {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				color: #323232;
				border:0;
			}
			.color_one {
				color: #666666 !important;
			}
			.color_two {
				color: #E40000 !important;
			}
			.color_four {
				color: #161616 !important;
			}			
			.color_five {
				color: #7B7B7B !important;
			}
			.color_six {
				color: #323232 !important;
			}
			h1 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:28px; 
				color: #161616; 
				line-height:32px;
				font-weight:400;
			}
			h2 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:22px; 
				color: #161616; 
				line-height:26px;
				font-weight:400;
			}
			h3 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:18px; 
				color: #161616; 
				line-height:22px;
				font-weight:400;
			}
			ul {
				margin:5px 0 0 40px;
				padding:0 0 0 1px;
				color:#666666;
			}			
			ol {
				font-family: Arial, Verdana, sans-serif;
				margin:0 0 0 15px;
				padding:0 0 0 15px;
				color:#E40000;
			}			
			li {
				font-family: Arial, Verdana, sans-serif;
				font-weight: bold;
				line-height:20px;
				color:#E40000;
				margin: 10px 0 0 15px;
				padding: 0 10px 0 0;
			}
			
			li span {
				font-family: Arial, Verdana, sans-serif;
				font-weight: normal;
				line-height:20px;
				color:#666666;
				margin: 0 10px 0 0;
				padding: 0 10px 0 0;
			}
			.t_c ul {
				margin:0 0 0 1px;
				padding:0 0 0 1px;
				color:#7B7B7B;
			}
			.t_c ol {
				margin:0 0 0 1px;
				padding:0 0 0 1px;
				color:#E40000;
			}
			.t_c li {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 10px; 
				line-height:15px; 
				text-align: left;
				color: #7B7B7B; 
				margin:0;
				padding: 0 10px 0 0;
			}
			.t_c li span {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 10px; 
				line-height:13px; 
				text-align: left;
				color: #7B7B7B; 
				margin:0;
				padding: 0 10px 0 0;
			}
			.h1 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:28px; 
				color: #161616; 
				line-height:32px;
				font-weight:400;
			}
			.h2 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:22px; 
				color: #161616; 
				line-height:26px;
				font-weight:400;
			}
			.h3 {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size:18px; 
				color: #161616; 
				line-height:22px;
				font-weight:400;
			}
			.height_five {
				font-family: Arial, Verdana, sans-serif;
				font-variant-ligatures: none;
				font-size: 5px; 
				line-height:5px; 
				height:5px;
			}
			.underline{
				text-decoration:underline !important;
			}
			.no_underline{
				text-decoration:none !important;
			}
			.heading_color{
				color: #161616 !important;
			}
			@media only screen and (max-width: 480px){
				.templateColumns{
					width:100% !important;
				}
				.templateColumnContainer{
					width:100% !important;
					display:block !important;
					text-align:center !important;
				}
			}
	</style>
	<title>Qantas</title>
</head>
<body style="height: auto; min-height: auto;">
<table align="center" border="0" cellpadding="0" cellspacing="0" style="background-color:#F4F5F6;" width="750">
	<tbody>
		<tr>
			<td>
			<table align="center" border="0" cellpadding="0" cellspacing="0" style="background-color:#FFFFFF; text-align:center;" width="680">
				<tbody>
					<tr>
						<td valign="top">
						<table align="center" border="0" cellpadding="0" cellspacing="0" style="background-color:#F4F5F6;">
							<tbody>
								<tr style="" width="680">
									<td align="center" style="text-align:center; height:40px; width:680px; font-size:10px; font-family: Ciutadella regular, Arial, Verdana, sans-serif;">
									<div style="height:10px; line-height:15px; font-family: Ciutadella regular, Arial, Verdana, sans-serif;">&nbsp;</div>

									<div style="height:10px; line-height:15px; font-family: Ciutadella regular, Arial, Verdana, sans-serif;">&nbsp;</div>
									</td>
								</tr>
							</tbody>
						</table>

						<table border="0" cellpadding="0" cellspacing="0" style="background-color:#FFFFFF; text-align:left; width:680px;">
							<tbody>
								<tr>
									<td><span style="font-family:Arial,Helvetica,sans-serif;"><img border="0" src="https://www.qantas.com/content/dam/per/email/email-headers/salesdistribution/qantas-Sales-generic.png" style="width:680px;" title="Qantas" /></span></td>
								</tr>
							</tbody>
						</table>

						<table border="0" cellpadding="0" cellspacing="0" id="main-content" style="background-color:#FFFFFF; text-align:center; width:600px; margin-left:40px; margin-right:40px;" width="600">
							<tbody>
								<tr>
									<td align="center" style="text-align:left;" valign="top">
									<table border="0" cellpadding="0" cellspacing="0" width="600">
										<tbody>
											<tr>
												<td style="height:30px; line-height:40px;" valign="top">&nbsp;</td>
											</tr>
											<tr>
												<td align="left" style="color: #666666; font-family: Ciutadella regular, Arial, Verdana, sans-serif;" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;">Hi {{{Recipient.FirstName}}},</span></td>
											</tr>
											<tr>
												<td style="height:20px; line-height:20px;" valign="top">&nbsp;</td>
											</tr>
											<tr>
												<td align="left" style="color: #666666; font-family: Arial, Verdana, sans-serif;" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;">To help you keep track of your spend and to allow us to make our quarterly partnership&nbsp;meetings more valuable, we are sharing your&nbsp;monthly account update.<br />
												<br />
												These updates will&nbsp;provide you with transparency on how your business is tracking,&nbsp;and also gives you the opportunity to reach out to us with any questions or concerns&nbsp;outside of our scheduled catch ups.</span></td>
											</tr>
											<tr>
												<td style="height:20px; line-height:20px;" valign="top">&nbsp;</td>
											</tr>
											<tr>
												<td style="width: 167px;" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><strong>To view a summary of your&nbsp;current account spend, please see attached.</strong></span></td>
											</tr>
											<tr>
												<td style="height:20px; line-height:20px;" valign="top">&nbsp;</td>
											</tr>
											<tr>
												<td align="left" style="color: #666666; font-family: Arial, Verdana, sans-serif;" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;">If you have any questions, please do not hesitate to get in touch with me on 13 10 85.<br />
												<br />
												Kind regards,<br />
												<br />
												{{{Sender.Name}}}<br />
												{{{Sender.Title}}}<br />
												<br />
												Qantas Corporate Sales<br />
												<em>Qantas Airways Limited</em><br />
												<br />
												A Wing, Level 4, 10 Bourke Road, Mascot NSW 2020<br />
												P. 13 10 85<br />
												E.&nbsp;{{{Sender.Email}}}</span></td>
											</tr>
											<tr>
												<td style="height:20px; line-height:20px;" valign="top">&nbsp;</td>
											</tr>
											<tr>
												<td style="height:20px; line-height:20px;" valign="top">&nbsp;</td>
											</tr>
										</tbody>
									</table>
									</td>
								</tr>
							</tbody>
						</table>
						</td>
					</tr>
					<tr>
						<td>
						<table border="0" cellpadding="0" cellspacing="0" style="width:680px;">
							<tbody>
								<tr>
									<td align="center" valign="top">
									<table align="center" border="0" cellpadding="0" cellspacing="0" style="font-size:10px; background-color:#F4F5F6;" width="680">
										<tbody>
											<tr>
												<td>&nbsp;</td>
											</tr>
											<tr>
												<td align="center" style="margin-left:40px; margin-right:40px;" valign="top" width="600">
												<table align="center" border="0" cellpadding="0" style="margin-left:40px; margin-right:40px;" width="600">
													<tbody>
														<tr>
															<td align="right" style="text-align:center; width:166px;" valign="top"><span style="font-family:Arial,Helvetica,sans-serif;"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/QF-oneworld-logo-lockup.png" title="Qantas" width="166" /></span></td>
														</tr>
														<tr>
															<td align="center" colspan="2" valign="top">
															<hr /></td>
														</tr>
													</tbody>
												</table>
												</td>
											</tr>
										</tbody>
									</table>
									</td>
								</tr>
							</tbody>
						</table>
						</td>
					</tr>
					<tr>
						<td>
						<table border="0" cellpadding="0" cellspacing="0" style="width:680px; background-color:#F4F5F6;">
							<tbody>
								<tr>
									<td align="center" valign="top">
									<table align="center" border="0" cellpadding="0" cellspacing="0" style="font-size:10px; background-color:#F4F5F6; margin-left:40px; margin-right:40px;" width="600">
										<tbody>
											<tr>
												<td style="font-family: Arial !important; color: #7B7B7B; font-size: 10px; line-height:13px; text-align: left;"><br />
												<span style="font-family:Arial,Helvetica,sans-serif;"><a href="https://www.qantas.com/au/en/support/contact-us.html" style="color: #7B7B7B; font-family: Arial !important; text-decoration:underline;" target="_blank" title="Contact Us">Contact Us</a> | <a href="http://www.qantas.com/travel/airlines/privacy/global/en" style="color: #7B7B7B; font-family: Arial !important; text-decoration:underline;" target="_blank" title="Privacy Statement">Privacy Statement</a> | <a href="https://help.qantas.com/support/s/" style="color: #7B7B7B; font-family: Arial, Verdana, sans-serif; text-decoration:underline;" title="Help & Support">Help &amp; Support</a></span></td>
											</tr>
											<tr>
												<td>&nbsp;</td>
											</tr>
											<tr>
												<td style="font-family: Ciutadella regular, Arial, Verdana, sans-serif; color: #7B7B7B; font-size: 10px; line-height:13px; text-align: left;"><span style="font-family:Arial,Helvetica,sans-serif;">To unsubscribe from these emails, contact your Account Manager at&nbsp;{{{Sender.Email}}}&nbsp;<a href="mailto:?subject=Unsubscribe%20from%20Monthly%20Account%20Update%20emails" style="color: #7B7B7B; text-decoration:underline;" target="_blank" title="Unsubscribe">here</a>.</span></td>
											</tr>
											<tr>
												<td style="height:20px; line-height:20px; margin:0;">&nbsp;</td>
											</tr>
										</tbody>
									</table>
									</td>
								</tr>
							</tbody>
						</table>
						</td>
					</tr>
				</tbody>
			</table>
			</td>
		</tr>
	</tbody>
</table>
</body>
</html>