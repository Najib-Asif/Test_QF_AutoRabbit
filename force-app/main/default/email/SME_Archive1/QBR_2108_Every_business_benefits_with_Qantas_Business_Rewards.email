lay: block; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="00000000167C9660" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="00000000167C9B20"></font></td><td align="center" valign="top" data_liveedit_tagid="00000000167C9FB0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: top; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167CA210"><tbody><tr data_liveedit_tagid="00000000167CA470"><td align="left" data_liveedit_tagid="00000000167CA6D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="00000000167CA930">Earn, save and enjoy!</strong>&nbsp;As a Qantas Business Rewards member you can earn Qantas Points* for your business on top of the points and Status Credits you and your employees earn as a Frequent Flyer.<sup data_liveedit_tagid="00000000167CACC0" style="font-size: 9px; line-height: 8px;">#</sup></font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="00000000167CBC20"><td valign="top" data_liveedit_tagid="00000000167CBE80" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000167CC590"><td align="left" valign="top" data_liveedit_tagid="00000000167CC7F0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167CCA50"><tbody><tr data_liveedit_tagid="00000000167CCCB0"><td align="left" valign="top" data_liveedit_tagid="00000000167CCF10" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167CD170"><tbody><tr data_liveedit_tagid="00000000167CD3D0"><td align="left" valign="middle" data_liveedit_tagid="00000000167CD630" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/icon-flights.png" data_liveedit_tagid="00000000167CDAE0" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="00000000167CE1E0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="00000000167CE6A0"></font></td><td align="center" valign="middle" data_liveedit_tagid="00000000167CEB30" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: middle; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167CED90"><tbody><tr data_liveedit_tagid="00000000167CEFF0"><td align="left" data_liveedit_tagid="00000000167CF250" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">Save up to 10% off the base fare of selected flights and up to 5% off Red e-Deals<sup data_liveedit_tagid="00000000167CF4B0" style="font-size: 9px; line-height: 8px;">~</sup>, depending on your member level.</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="00000000167D0410"><td valign="top" data_liveedit_tagid="00000000167D0670" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000167D0D80"><td align="left" valign="top" data_liveedit_tagid="00000000167D0FE0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167D1240"><tbody><tr data_liveedit_tagid="00000000167D14A0"><td align="left" valign="top" data_liveedit_tagid="00000000167D1700" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167D1960"><tbody><tr data_liveedit_tagid="00000000167D1BC0"><td align="left" valign="middle" data_liveedit_tagid="00000000167D1E20" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/flyer-bonus-icon.png" data_liveedit_tagid="00000000167D22D0" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="00000000167D29D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="00000000167D2E90"></font></td><td align="center" valign="middle" data_liveedit_tagid="00000000167D3320" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: middle; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167D3580"><tbody><tr data_liveedit_tagid="00000000167D37E0"><td align="left" data_liveedit_tagid="00000000167D3A40" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">250 bonus Qantas Points per booking for Frequent Flyers+, every time they fly for work, on top of the points and Status Credits they already earn.<sup data_liveedit_tagid="00000000167D3CA0" style="font-size: 9px; line-height: 8px;">#</sup></font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="00000000167D4C00"><td valign="top" data_liveedit_tagid="00000000167D4E60" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000167D5570"><td align="left" valign="top" data_liveedit_tagid="00000000167D57D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167D5A30"><tbody><tr data_liveedit_tagid="00000000167D5C90"><td align="left" valign="top" data_liveedit_tagid="00000000167D5EF0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000167D6150"><tbody><tr data_liveedit_tagid="00000000167D63B0"><td align="left" valign="middle" data_liveedit_tagid="00000000167D6610" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/lounge-icon.png" data_liveedit_tagid="00000000167D6AC0" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="00000000167D71C0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="0000000016809140"></font></td><td align="center" valign="middle" data_liveedit_tagid="00000000168095D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: middle; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000016809830"><tbody><tr data_liveedit_tagid="0000000016809A90"><td align="left" data_liveedit_tagid="0000000016809CF0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">Bigger discounts on Qantas Club Memberships, with members now saving up to 30% off.^</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="000000001680AB20"><td valign="top" data_liveedit_tagid="000000001680AD80" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="000000001680B490"><td align="left" valign="top" data_liveedit_tagid="000000001680B6F0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000001680B950"><tbody><tr data_liveedit_tagid="000000001680BBB0"><td align="left" valign="top" data_liveedit_tagid="000000001680BE10" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000001680C070"><tbody><tr data_liveedit_tagid="000000001680C2D0"><td align="left" valign="middle" data_liveedit_tagid="000000001680C530" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/offer-icon.png" data_liveedit_tagid="000000001680C9E0" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="000000001680D0E0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="000000001680D5A0"></font></td><td align="center" valign="middle" data_liveedit_tagid="000000001680DA30" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: middle; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000001680DC90"><tbody><tr data_liveedit_tagid="000000001680DEF0"><td align="left" data_liveedit_tagid="000000001680E150" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">New Gold Accelerator - Level 3 members can nominate 1 traveller to fast track their Frequent Flyer status to Gold, per year.<sup data_liveedit_tagid="000000001680E3B0" style="font-size: 9px; line-height: 8px;">§</sup></font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="000000001680F310"><td valign="top" data_liveedit_tagid="000000001680F570" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="000000001680FA30"><td align="left" valign="top" data_liveedit_tagid="000000001680FC90" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">Just ensure you and your team&nbsp;<strong data_liveedit_tagid="000000001680FEF0">include your business's ABN and Qantas Frequent Flyer number in the booking so you never miss a point!</strong>&nbsp;Find out more below about your benefits, including your member flights savings and the exclusive Qantas Club discount available for you and your employees.<br data_liveedit_tagid="0000000016810280"><br data_liveedit_tagid="0000000016810390"><a class="two" href="https://www.qantas.com/au/en/business-rewards/home.html" title="Learn more" target="_blank" data_liveedit_tagid="00000000168105D0" style="color: rgb(228, 0, 0); border: 0px; text-decoration-line: none !important;">Learn more</a>&nbsp;&nbsp;<a class="two" href="https://www.qantas.com/au/en/business-rewards/home.html" target="_blank" data_liveedit_tagid="0000000016810A90" style="border: 0px; color: rgb(228, 0, 0) !important; text-decoration-line: none !important;"><img border="0" title="" alt="" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/other/cta-arrow-5px.jpg" width="4" data_liveedit_tagid="0000000016810CF0" style="display: inline-block;"></a></font></td></tr><tr data_liveedit_tagid="00000000168112C0"><td valign="top" data_liveedit_tagid="0000000016811520" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000168119E0"><td align="left" valign="top" data_liveedit_tagid="0000000016811C40" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">We've recently added Travel Expense Reports to help you manage your business travel expenses and you can now redeem your business's Qantas Points on your next flight right from your account. You can check out all the tools and features to manage your account&nbsp;<a href="https://www.qantas.com/au/en/business-rewards/home.html#manage" target="_blank" title="Manage Your Account" data_liveedit_tagid="0000000016811EA0" style="color: rgb(102, 102, 102); border: 0px;">here</a>.</font></td></tr><tr data_liveedit_tagid="0000000016812490"><td valign="top" data_liveedit_tagid="00000000168126F0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000016812E00"><td align="left" valign="top" data_liveedit_tagid="0000000016813060" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000168132C0"><tbody><tr data_liveedit_tagid="0000000016813520"><td align="left" valign="top" data_liveedit_tagid="0000000016813780" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: top; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000168139E0"><tbody><tr data_liveedit_tagid="0000000016813C40"><td align="left" valign="top" data_liveedit_tagid="0000000016813EA0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: top; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/icon-laptop.png" data_liveedit_tagid="0000000016814350" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="0000000016814A50" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="0000000016814F10"></font></td><td align="center" valign="middle" data_liveedit_tagid="00000000168153A0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000016815600"><tbody><tr data_liveedit_tagid="0000000016815860"><td align="left" data_liveedit_tagid="0000000016815AC0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="0000000016815D20">Manage travel.</strong>&nbsp;Manage all your travel plans in one place and enjoy exclusive access to features that can help you save time when booking flights for work.</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="0000000016816C80"><td valign="top" data_liveedit_tagid="0000000016816EE0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000168175F0"><td align="left" valign="top" data_liveedit_tagid="0000000016817850" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000016817AB0"><tbody><tr data_liveedit_tagid="0000000016817D10"><td align="left" valign="middle" data_liveedit_tagid="0000000016817F70" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="00000000168181D0"><tbody><tr data_liveedit_tagid="0000000016818430"><td align="left" valign="middle" data_liveedit_tagid="0000000016818690" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px;"><img src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/icons/classic-flight-rewards-icon.png" data_liveedit_tagid="0000000016818B40" style="margin: 0px; padding: 0px; border: none; display: block; width: 48px; text-align: center;"></td></tr></tbody></table></td><td data_liveedit_tagid="000000001682F280" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; padding: 0px; margin: 0px; width: 30px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="000000001682F740"></font></td><td align="center" valign="top" data_liveedit_tagid="000000001682FBD0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; vertical-align: top; padding: 0px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000001682FE30"><tbody><tr data_liveedit_tagid="0000000016830090"><td align="left" data_liveedit_tagid="00000000168302F0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif"><strong data_liveedit_tagid="0000000016830550">Use Points for your next flight.</strong>&nbsp;You can redeem your business's Qantas Points on flights, upgrades, seats and bags directly from your account<span data_liveedit_tagid="00000000168308E0" style="vertical-align: 1px; font-size: 12px; bottom: 0.3ex; position: relative;">±</span>. Simply log in to use points to book Classic Flight Rewards or Points Plus Pay flights.</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="0000000016831A90"><td data_liveedit_tagid="0000000016831CF0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; margin: 0px; padding: 0px;"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="00000000168321B0"></font><hr data_liveedit_tagid="00000000168322C0" style="height: 2px; border-width: 0px; color: rgb(218, 218, 218); background-color: rgb(218, 218, 218);"><font face="Arial, sans-serif">&nbsp;<br data_liveedit_tagid="0000000016832760"></font></td></tr><tr data_liveedit_tagid="0000000016832D20"><td align="left" valign="top" data_liveedit_tagid="0000000016832F80" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><font face="Arial, sans-serif">If you have a query, please feel free to contact me direct on 13&nbsp;10&nbsp;85 ext. <span style="background-color: rgb(255, 255, 51);">XXXX</span>, or the Qantas Business Rewards Priority line 13&nbsp;74&nbsp;78. I look forward to speaking with you again soon.<br data_liveedit_tagid="0000000016833B60"><br data_liveedit_tagid="0000000016833C70">You can see our easy to read&nbsp;<a href="https://www.qantas.com/au/en/business-rewards/news/how-to.html" target="_blank" title="How-to Guides" data_liveedit_tagid="0000000016833EB0" style="color: rgb(102, 102, 102); border: 0px;">How-to Guides</a>&nbsp;or visit&nbsp;<a href="https://www.qantas.com/au/en/business-rewards/home.html" target="_blank" title="qantasbusinessrewards.com" data_liveedit_tagid="0000000016834240" style="color: rgb(102, 102, 102); border: 0px;">qantasbusinessrewards.com</a>.</font></td></tr><tr data_liveedit_tagid="0000000016834830"><td valign="top" data_liveedit_tagid="0000000016834A90" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000016834F50"><td valign="top" data_liveedit_tagid="00000000168351B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000016835670"><td data_liveedit_tagid="00000000168358D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/images/qbr-cvp-flyers-email-proof-points-600x353.jpg" width="600" data_liveedit_tagid="0000000016835B30" style="width: 600px; display: block;"></td></tr><tr data_liveedit_tagid="0000000016835FD0"><td valign="top" data_liveedit_tagid="0000000016836230" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 25px; height: 25px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="00000000168366F0"><td align="left" valign="top" data_liveedit_tagid="0000000016836950" style="font-variant-ligatures: none; font-size: 9px; color: rgb(102, 102, 102); line-height: 12px;"><font face="Arial, sans-serif">1. Selected featured content may not be available on your flight. Inflight entertainment varies by route and aircraft.<br data_liveedit_tagid="0000000016836BB0"><br data_liveedit_tagid="0000000016836CC0">2. Meals, beverages, entertainment offerings vary between flight times. Alcohol offered during select flight times on select flights.<br data_liveedit_tagid="0000000016836F00"><br data_liveedit_tagid="0000000016837010">3. Qantas Australian Domestic and International lounge network is subject to change due to changes in state and territory-specific restrictions, or health and safety advice. Please remember to check our airport service changes page for the most up-to-date information on Domestic and International lounge openings and updates. Lounge access eligibility conditions apply. Temporary measures have been put in place across the Qantas lounge network including capacity restrictions, physical distancing requirements and changes to our food and beverage service offerings. Please be advised that lounges are subject to capacity limits at the time of your visit.<br data_liveedit_tagid="0000000016837250"><br data_liveedit_tagid="0000000016837360">4. The number of Australian destinations is correct as at 7 May 2021, but is subject to change. Before booking and departure, ensure you check the latest  Australian domestic travel requirements and/or international travel requirements, which may include mandatory health declarations, vaccinations, COVID-19 tests, use of face masks, entry permits, pre-approval and quarantine (possibly at your own expense), or you could be denied entry. All travellers are responsible for ensuring they are eligible to enter Australia prior to booking. All passengers aged 12 years and older on Qantas international flights will be required to be fully vaccinated with a TGA-approved or recognised vaccine (some exceptions apply). Passengers will also be required to return a negative PCR COVID test taken no later than three days prior to departure.<br data_liveedit_tagid="00000000168375A0"><br data_liveedit_tagid="00000000168376B0">5. You must be a member of the Qantas Frequent Flyer program to earn and redeem Qantas Points. A joining fee may apply. Membership and Qantas Points are subject to the Qantas Frequent Flyer program terms and conditions.</font></td></tr><tr data_liveedit_tagid="0000000016837B50"><td valign="top" data_liveedit_tagid="0000000016837DB0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr data_liveedit_tagid="0000000016838270"><td valign="top" data_liveedit_tagid="00000000168384D0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="0000000016839B20"><td data_liveedit_tagid="0000000016839D80" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="0000000016839FE0" style="width: 680px;"><tbody data_liveedit_tagid="000000001683A240"><tr data_liveedit_tagid="000000001683A4A0"><td align="center" valign="top" data_liveedit_tagid="000000001683A700" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="000000001683A960" style="font-size: 10px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="000000001683ABC0"><tr data_li