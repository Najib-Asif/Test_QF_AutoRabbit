<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<table align="center" border="0" cellpadding="0" cellspacing="0" width="750" style="font-family: &quot;Ciutadella regular&quot;, Arial; background-color: rgb(244, 245, 246);"><tbody><tr><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" style="background-color: rgb(255, 255, 255); text-align: center;"><tbody><tr><td valign="top" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); text-align: left; height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" style="background-color: rgb(244, 245, 246);"><tbody><tr width="680"><td align="center" style="font-variant-ligatures: none; line-height: 20px; font-size: 10px; color: rgb(102, 102, 102); text-align: center; height: 60px; width: 680px;"><div style="height: 15px; line-height: 15px;">&nbsp;</div><div style="line-height: 15px; height: 15px; width: 680px;">Limited time offer</div><div style="height: 15px; line-height: 15px;">&nbsp;</div></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" style="width: 680px;"><tbody><tr><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;"><a href="http://salesnews.qantas.com.au/re?l=DIs4ak38I7u5boldI0" target="_blank" style="color: rgb(102, 102, 102); border: 0px;"><img border="0" src="http://salesnews.qantas.com/imgproxy/img/2013300744/device-tp.jpg" title="Qantas" alt="Qantas" style="width: 680px; height: 70px;"></a></td></tr><tr><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;">&nbsp;<br></td></tr><tr><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;"><img border="0" src="http://salesnews.qantas.com/imgproxy/img/2021617191/180201_500_bonus_eDM_680x400.jpg" title="Take off with 500 bonus Qantas points on flights" alt="Take off with 500 bonus Qantas points on flights" style="width: 680px; height: 400px;"></td></tr></tbody></table><table id="main-content" border="0" cellpadding="0" cellspacing="0" width="600" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody><tr><td valign="top" align="center" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); text-align: left; height: 20px;"><table border="0" cellpadding="0" cellspacing="0" width="600"><tbody><tr><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 15px; margin: 0px;"></td></tr><tr><td valign="top" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;"><font face="Arial, sans-serif">Hi ,</font></td></tr><tr><td valign="top" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;"><font face="Arial, sans-serif">&nbsp;</font></td></tr><tr><td valign="top" style="line-height: 20px; height: 20px;"><font face="Arial, sans-serif"><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">Enjoy 500 bonus Qantas Points for your business on eligible Qantas flights with Qantas Business Rewards^.</span></font><br><br><font color="#666666"><span style="font-size: 14px; font-variant-ligatures: none;">All you need to do is register from 1 February 2018, and book eligible flights between 6 - 28 February 2018 for travel by 31 March 2018 ^. Your business will earn bonus Qantas Points on every eligible flight, so fly as many times as you like during the promotional period to get your points soaring.</span><br><br><span style="font-size: 14px; font-variant-ligatures: none;">And remember to add your business' ABN and individual Qantas Frequent Flyer number to every flight booking to earn Qantas Points for your business and the person travelling~.</span></font></font></td></tr><tr><td valign="top" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px;"><table width="600" border="0" cellspacing="0" cellpadding="0"><tbody><tr><td style="margin: 0px; height: 25px;">&nbsp;</td></tr><tr><td><table align="left" class="w100perc" border="0" cellspacing="0" cellpadding="0" style="margin: 0px auto;"><tbody><tr><td width="6" align="right" valign="top" style="border: 0px currentcolor; width: 6px; line-height: 0px; font-family: Arial, Helvetica, sans-serif; font-size: 0px;"><a href="https://www.qantasbusinessrewards.com/offer/QANTAS-POINTS-500BONUS" target="_blank" style="margin: 0px; padding: 0px; border: 0px currentcolor;"><img width="6" height="40" title="" alt="" src="http://loyalty.qantas.com/imgproxy/img/3001543098/qa_primary_cta_l.png" border="0" style="margin: 0px; padding: 0px; border: currentcolor; display: block;"></a></td><td height="40" align="center" class="w100perc applelinkwhite" valign="middle" bgcolor="#e40000" style="padding: 0px 10px; border: 0px currentcolor; height: 40px; color: rgb(255, 255, 255); line-height: 16px; font-family: Ciutadella-Regular, Arial, Helvetica, sans-serif; font-size: 14px; vertical-align: middle;"><a title="Register now" href="https://www.qantasbusinessrewards.com/offer/QANTAS-POINTS-500BONUS" target="_blank" alt="Register now" style="color: rgb(255, 255, 255); line-height: 16px; font-family: Ciutadella, Arial, Helvetica; text-decoration-line: none;">Register now</a>																&nbsp;</td><td width="6" align="left" valign="top" style="border: 0px currentcolor; width: 6px; line-height: 0px; font-family: Arial, Helvetica, sans-serif; font-size: 0px;"><a href="https://www.qantasbusinessrewards.com/offer/QANTAS-POINTS-500BONUS" target="_blank"><img width="6" height="40" title="" alt="" src="http://loyalty.qantas.com/imgproxy/img/3001543099/qa_primary_cta_r.png" bo