ng="0"><tbody><tr><td align="left" valign="top" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px; vertical-align: top; padding: 0px;"><div style="padding: 0px; margin: 2px 0px;"><img width="30" height="17" src="http://salesnews.qantas.com/imgproxy/img/2018913669/list-bullet-icon30x17.png" style="margin: 0px; padding: 0px; border: none; display: block; width: 30px; height: 17px;"></div></td><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px; padding: 0px;"><div style="padding: 0px; margin: 4px 0px;"><font face="Arial, sans-serif"><a href="https://www.qantasbusinessrewards.com/earn-points" target="_blank" style="color: rgb(102, 102, 102); border: 0px;">Earn</a>&nbsp;with one of our Partners<sup style="line-height: 11px; font-size: 11px;">+</sup>&nbsp;or</font></div></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0"><tbody><tr><td align="left" valign="top" style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px; vertical-align: top; padding: 0px;"><div style="padding: 0px; margin: 2px 0px;"><img width="30" height="17" src="http://salesnews.qantas.com/imgproxy/img/2018913669/list-bullet-icon30x17.png" style="margin: 0px; padding: 0px; border: none; display: block; width: 30px; height: 17px;"></div></td><td style="font-variant-ligatures: none; line-height: 20px; font-size: 14px; color: rgb(102, 102, 102); height: 20px; padding: 0px;"><div style="padding: 0px; margin: 4px 0px;"><font face="Arial, sans-serif"><a href="https://www.qantasbusinessrewards.com/login" target="_blank" style="color: rgb(102, 102, 102); border: 0px;">Transfer</a>&nbsp;a minimum of 3,000 Qantas Points from your business' account to any Qantas Frequent Flyer account<sup style="line-height: 11px; font-size: 11px;">^</sup></font></div></td></tr></tbody></table><table border="0" cellpadding="0" 