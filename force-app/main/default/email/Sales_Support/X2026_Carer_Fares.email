<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<table align="center" border="0" cellpadding="0" cellspacing="0" width="750" data_liveedit_tagid="000000001B4AB550" style="color: rgb(102, 102, 102); font-family: Arial, Verdana, sans-serif; font-size: 14px; font-variant-ligatures: none; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="000000001B4AB8F0"><tr data_liveedit_tagid="000000001B4ABB50"><td data_liveedit_tagid="000000001B4AC010" style="line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="000000001B4AC270" style="background-color: rgb(255, 255, 255); text-align: center;"><tbody data_liveedit_tagid="000000001B4AC4D0"><tr data_liveedit_tagid="000000001B4AC730"><td valign="top" data_liveedit_tagid="000000001B4AC990" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000001B4ACBF0" style="background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="000000001B4ACE50"><tr width="680" data_liveedit_tagid="000000001B4AD2F0"><td align="center" data_liveedit_tagid="000000001B4AD550" style="font-variant-ligatures: none; font-size: 10px; color: rgb(102, 102, 102); line-height: 20px; text-align: center; height: 60px; width: 680px;"><div data_liveedit_tagid="000000001B4ADA00" style="height: 15px; line-height: 15px;"><br></div><div data_liveedit_tagid="000000001B4AE120" style="height: 15px; line-height: 15px;">&nbsp;</div></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000001B4AEBC0" style="width: 680px;"><tbody data_liveedit_tagid="000000001B4AEE20"><tr data_liveedit_tagid="000000001B4AF1C0"><td data_liveedit_tagid="000000001B4AF420" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><a href="https://www.qantas.com/au/en.html" target="_blank" data_liveedit_tagid="000000001B4AF680" style="color: rgb(102, 102, 102); text-decoration-line: none; border: 0px;"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/qantas-header-banner.jpg" title="Qantas" style="width: 680px;"></a></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" id="main-content" width="600" data_liveedit_tagid="000000001B4B0490" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="000000001B4B06F0"><tr data_liveedit_tagid="000000001B4B0950"><td align="center" valign="top" data_liveedit_tagid="000000001B4B0BB0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: left;"><table border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="000000001B4B1060"><tbody data_liveedit_tagid="000000001B4B12C0"><tr data_liveedit_tagid="000000001B4B1520"><td valign="top" data_liveedit_tagid="000000001B4B1780" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 40px; height: 30px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000001B4B1FB0"><td align="left" valign="top" data_liveedit_tagid="000000001B4B2210" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">Dear Agency Partner,</td></tr><tr data_liveedit_tagid="000000001B4B26D0"><td valign="top" data_liveedit_tagid="000000001B4B2930" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000001B4B2DF0"><td align="left" valign="top" data_liveedit_tagid="000000001B4B3050" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">Qantas is pleased to offer Carer fares to select travel agents who specialise in travel for customers with specific needs.<br>Carers fares are available on all Australian domestic services and for international journeys departing from Australia in economy, premium economy and business class.&nbsp;<br><br><b>Eligibility</b>&nbsp;<br>Carer fares can be offered when a customer does not meet independent traveller requirements and requires a Carer to assist them. Both passengers are eligible for the discount. Carers must travel in an adjoining seat in the same class of service.<br><br>Refer to <a href="https://www.qantas.com/en-au/travel-information/specific-needs-assistance/carer">Travelling with a Carer</a> on qantas.com for full details of requirements.<br data_liveedit_tagid="000000002D56F570"><br data_liveedit_tagid="0000000009187EE0"><b>How to Book and Price<br></b>Create one booking for both customers.<br>Price itinerary using the account code <b>'Carer'</b>. The fare basis will reflect the private fare:<br><ul><li><b>Australian Domestic</b>: the published fare basis with <b>'CARE'</b> at the end</li><li><b>International</b>: the published fare basis with <b>'UQC'</b> at the end</li></ul><div>All other fare rules and conditions remain the same as the published fare.</div><div><br></div><div><b>Name Change</b>&nbsp;</div><div>Qantas Carer fares permit one free name change if the ticketed Carer is no longer able to travel and a new Carer is required. Please refer to Qantas Agency Connect for assistance.&nbsp;</div><br><br data_liveedit_tagid="000000001B4B3CA0">Kind regards,<br data_liveedit_tagid="000000001B4B3EE0"><em data_liveedit_tagid="000000001B4B4470">Qantas Airways Limited</em></td></tr><tr data_liveedit_tagid="000000001B4B4A60"><td valign="top" data_liveedit_tagid="000000001B4B4CC0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000001B4B5180"><td valign="top" data_liveedit_tagid="000000001B4B53E0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="000000002D565A90"><td data_liveedit_tagid="000000002D565CF0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000002D565F50" style="width: 680px;"><tbody data_liveedit_tagid="000000002D5661B0"><tr data_liveedit_tagid="000000002D566410"><td align="center" valign="top" data_liveedit_tagid="000000002D566670" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="680" data_liveedit_tagid="000000002D5668D0" style="font-size: 10px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="000000002D566B30"><tr data_liveedit_tagid="000000002D566D90"><td data_liveedit_tagid="000000002D566FF0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000002D5674B0"><td align="center" valign="top" width="600" data_liveedit_tagid="000000002D567710" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; margin-left: 40px; margin-right: 40px;"><table align="center" border="0" cellpadding="0" width="600" data_liveedit_tagid="000000002D567970" style="margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="000000002D567BD0"><tr data_liveedit_tagid="000000002D567E30"><td align="left" data_liveedit_tagid="000000002D568090" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">&nbsp;</td><td align="right" valign="top" data_liveedit_tagid="000000002D568420" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: right; width: 167px;"><a href="https://www.qantas.com/" target="_blank" data_liveedit_tagid="000000002D568680" style="color: rgb(102, 102, 102); text-decoration-line: none; border: 0px;"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/QF-oneworld-logo-lockup.png" title="Qantas" width="166" data_liveedit_tagid="000000002D5687B0"></a></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="000000002D569F50"><td data_liveedit_tagid="000000002D56A1B0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000002D56A410" style="width: 680px; background-color: rgb(244, 245, 246);"><tbody data_liveedit_tagid="000000002D56A670"><tr data_liveedit_tagid="000000002D56A8D0"><td align="center" valign="top" data_liveedit_tagid="000000002D56AB30" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table align="center" border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="000000002D56AD90" style="font-size: 10px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="000000002D56AFF0"><tr data_liveedit_tagid="000000002D56B250"><td data_liveedit_tagid="000000002D56B5E0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 10px; height: 10px; margin: 0px;">&nbsp;</td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table>]]></td>
