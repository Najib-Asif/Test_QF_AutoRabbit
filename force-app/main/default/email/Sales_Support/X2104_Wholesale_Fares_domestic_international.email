olor: rgb(102, 102, 102); line-height: 20px;"><a href="https://www.qantas.com/au/en.html" target="_blank" data_liveedit_tagid="000000002D567970" style="color: rgb(102, 102, 102); text-decoration-line: none; border: 0px;"><img border="0" src="https://www.qantas.com/content/dam/qantas/sales-news/salesforce-email-assets/qantas-header-banner.jpg" title="Qantas" style="width: 680px;"></a></td></tr></tbody></table><table border="0" cellpadding="0" cellspacing="0" id="main-content" width="600" data_liveedit_tagid="000000002D567BD0" style="text-align: center; width: 600px; margin-left: 40px; margin-right: 40px;"><tbody data_liveedit_tagid="000000002D567E30"><tr data_liveedit_tagid="000000002D568420"><td align="center" valign="top" data_liveedit_tagid="000000002D568680" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; text-align: left;"><table border="0" cellpadding="0" cellspacing="0" width="600" data_liveedit_tagid="000000002D568090"><tbody data_liveedit_tagid="000000002D566D90"><tr data_liveedit_tagid="000000002D566FF0"><td valign="top" data_liveedit_tagid="000000001B4AC730" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 40px; height: 30px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000001B4AC990"><td align="left" valign="top" data_liveedit_tagid="000000001B4B0490" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">Dear Agency Partner,</td></tr><tr data_liveedit_tagid="000000001B4B06F0"><td valign="top" data_liveedit_tagid="000000001B4B0950" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000001B4B0BB0"><td align="left" valign="top" data_liveedit_tagid="000000001B4B1060" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;">We're pleased to provide your Agency access to Qantas domestic Wholesale fares.<br data_liveedit_tagid="000000001B4B3CA0"><br data_liveedit_tagid="000000001B4B3B90">Wholesale fares have one price point, and are sold as a package with another product, such as hotels, cruise packages or tours.<br data_liveedit_tagid="0000000009CC57F0"><br data_liveedit_tagid="0000000009CC63E0">Please find attached our&nbsp;<em data_liveedit_tagid="000000001B4B12C0">Qantas Wholesale Fare clue card</em>, where you will find information about our Wholesale fare product.<br data_liveedit_tagid="000000000936CBC0"><br data_liveedit_tagid="000000000936CCD0">If you have any questions or require further information, please let us know.<br data_liveedit_tagid="000000000936CDE0"><br data_liveedit_tagid="000000000936CEF0">Kind regards,<br data_liveedit_tagid="000000002D572770">Agency Partnerships and Leisure Sales<br data_liveedit_tagid="000000002D572660"><br data_liveedit_tagid="000000002D572420"><em data_liveedit_tagid="000000001B4B5180">Qantas Airways Limited</em></td></tr><tr data_liveedit_tagid="000000001B4B53E0"><td valign="top" data_liveedit_tagid="000000001B4B4A60" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr><tr data_liveedit_tagid="000000001B4B4CC0"><td valign="top" data_liveedit_tagid="000000001B4B2DF0" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px; height: 20px;">&nbsp;</td></tr></tbody></table></td></tr></tbody></table></td></tr><tr data_liveedit_tagid="000000001B4B3050"><td data_liveedit_tagid="000000001B4B4470" style="font-variant-ligatures: none; font-size: 14px; color: rgb(102, 102, 102); line-height: 20px;"><table border="0" cellpadding="0" cellspacing="0" data_liveedit_tagid="000000002D56E5F0" style="width: 680px;"><tbody data_liveedit_tagid="000000001B4B26D0"><tr data_liveedit_tagid="000000001B4B2930"><td align="center" valign="top" data_liveedit_tagid="000000001B4B1FB0" style="font-va