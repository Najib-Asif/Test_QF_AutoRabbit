<messaging:emailTemplate subject="Your specific needs request is approved." recipientType="User" relatedToType="Case" >
<messaging:htmlEmailBody >

<html>
<head>
    <title></title>
    <style>
    body{
        font-family: arial, calibri;
        font-size: 14px;
    }
    </style>
</head>
<body>
    
<center><img src="https://qantas.file.force.com/servlet/servlet.ImageServer?id=0159000000FSVkd&oid=00D900000010OOK&lastMod=1521233610000" alt="QantasLetterhead" /> <br/> <br/> </center>

Hello {!relatedTo.First_Name__c},
<!-- Type of Approval -->
<p>Your 
{!IF( (relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c = "Non-Motorised Wheelchair" || relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c = "Motorised Wheelchair") && 
(relatedTo.QCC_Specific_Needs__r.QCC_Torso_Support_Required__c == 'No'
    && relatedTo.QCC_Specific_Needs__r.QCC_Eagle_Lift__c == 'No'
    &&  relatedTo.QCC_Specific_Needs__r.QCC_Self_Transfer__c == 'No'
    &&  relatedTo.QCC_Specific_Needs__r.QCC_Johnny_Belt__c == 'No'
    &&  relatedTo.QCC_Specific_Needs__r.QCC_Slide_Board__c == 'No'
),"wheelchair has","")} 

{!IF( (relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c = "Non-Motorised Wheelchair" || relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c = "Motorised Wheelchair") && 
(relatedTo.QCC_Specific_Needs__r.QCC_Torso_Support_Required__c == 'Yes'
    || relatedTo.QCC_Specific_Needs__r.QCC_Eagle_Lift__c == 'Yes'
    ||  relatedTo.QCC_Specific_Needs__r.QCC_Self_Transfer__c == 'Yes'
    ||  relatedTo.QCC_Specific_Needs__r.QCC_Johnny_Belt__c == 'Yes'
    ||  relatedTo.QCC_Specific_Needs__r.QCC_Slide_Board__c == 'Yes'
),"wheelchair and additional requests have","")} 

{!IF( (relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c = "Motorised Mobility Aid") && 
(relatedTo.QCC_Specific_Needs__r.QCC_Torso_Support_Required__c == 'No'
    && relatedTo.QCC_Specific_Needs__r.QCC_Eagle_Lift__c == 'No'
    &&  relatedTo.QCC_Specific_Needs__r.QCC_Self_Transfer__c == 'No'
    &&  relatedTo.QCC_Specific_Needs__r.QCC_Johnny_Belt__c == 'No'
    &&  relatedTo.QCC_Specific_Needs__r.QCC_Slide_Board__c == 'No'
),"motorised mobility aid has","")} 


{!IF( (relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c = "Motorised Mobility Aid") && 
(relatedTo.QCC_Specific_Needs__r.QCC_Torso_Support_Required__c == 'Yes'
    || relatedTo.QCC_Specific_Needs__r.QCC_Eagle_Lift__c == 'Yes'
    ||  relatedTo.QCC_Specific_Needs__r.QCC_Self_Transfer__c == 'Yes'
    ||  relatedTo.QCC_Specific_Needs__r.QCC_Johnny_Belt__c == 'Yes'
    ||  relatedTo.QCC_Specific_Needs__r.QCC_Slide_Board__c == 'Yes'
),"motorised mobility aid and additional requests have","")} 
been approved.

</p>  
<!-- END Type of Approval --> 
<!-- Next Steps -->
<h4>What are your next steps?</h4>
<ul align="left">
    <apex:outputPanel rendered="{!relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c == 'Motorised Wheelchair'}">
        <li>Received battery approval from Dangerous Goods. For further enquiries, contact dg@qantas.com.au</li>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!relatedTo.QCC_Specific_Needs__r.QCC_Mobility_Aid_Type__c == 'Motorised Mobility Aid'}">
        <li>Received battery approval from Dangerous Goods. For further enquiries, contact dg@qantas.com.au</li>
    </apex:outputPanel>
    <li>Check-in online</li>
    <li>Arrive at the airport on the day of travel with your wheelchair 2hrs before departure for international flights and 1hr for domestic flights.</li>
    <li>Seek assistance from Qantas staff at check-in. You can drop off your wheelchair at check-in or the boarding gate.</li>
    <li>Go to the boarding gate</li> 
    <li>Ready to take off</li>
</ul>
<!-- END Next Steps -->

<h4>We’re here to help</h4>

<p>If you’re a passenger or carer with questions relating to specific needs during your journey, you can reply to this email or contact our Customer Specific Needs team on 1800 177 474 (within Australia), +61 2 9123 7471 (from outside Australia), who are available 7 days, from 6am to 10pm (AEST) or contact your local Qantas office.</p>

<p>Travelling within 72 hours? We will respond within 24 hours.</p>
<p>If your travel departure time is more than 72 hours away, we will respond within 72 hours.</p>

Kind Regards,<br/>
{!$User.FirstName}<br/>
Qantas Customer Specific Needs Team<br/>

<img src="https://qantas.file.force.com/servlet/servlet.ImageServer?id=0159000000FSVke&oid=00D900000010OOK&lastMod=1521233610000" alt="QantasFooter" /> 


<center>Qantas Airways Limited, ABN 16 009 661 901</center>
<center>10 Bourke Road Mascot NSW 2020 Australia</center>


<center>************PLEASE CONSIDER OUR ENVIRONMENT BEFORE PRINTING************</center>
<center>***************************Confidentiality and Privilege Notice*******************************</center>


<p>This e-mail is intended only to be read or used by the addressee. It is confidential and may contain legally privileged information. If you are not the addressee indicated in this message (or responsible for delivery of the message to such person), you may not copy or deliver this message to anyone, and you should destroy this message and kindly notify the sender by reply e-mail. Confidentiality and legal privilege are not waived or lost by reason of mistaken delivery to you. Qantas Airways Limited ABN 16 009 661 901</p>
    <font color="white">
        <apex:outputText value="{!relatedTo.Custom_Thread_ID__c}"/>
    </font>
</body>
</html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>