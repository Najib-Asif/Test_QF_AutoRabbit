                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Parent_Case_Id</targetReference>
            </connector>
            <label>Has Parent</label>
        </rules>
    </decisions>
    <description>CRM-8421: Publish Request Tracker Platform Event to Qantas Mobile App</description>
    <environments>Default</environments>
    <formulas>
        <name>Date120DaysBack</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 120</expression>
    </formulas>
    <formulas>
        <name>isValidCaseGroup</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Original_Case_Record.Group__c},
&apos;GMC&apos;,&apos;invalid&apos;,
&apos;valid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidCaseOrigin</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Original_Case_Record.Origin},
&apos;Social_Media&apos;, &apos;valid&apos;,
&apos;SHR QCC&apos;, &apos;valid&apos;,
&apos;Qantas.com&apos;, &apos;valid&apos;,
&apos;Phone&apos;,&apos;valid&apos;,
&apos;invalid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidCaseRecordType</name>
        <dataType>String</dataType>
        <expression>CASE ( {!Get_Original_Case_Record.RecordType.Name},
&apos;CCC Complaints&apos;,&apos;valid&apos;,
&apos;CCC Baggage&apos;,&apos;valid&apos;,
&apos;CCC Insurance Letter Case&apos;, &apos;valid&apos;,
&apos;CCC Query&apos;,&apos;valid&apos;,
&apos;invalid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidCategory</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Original_Case_Record.Category__c},
&apos;Customer behaviour/Customer offload&apos;, &apos;invalid&apos;,
&apos;Customer Behaviour&apos;, &apos;invalid&apos;,
&apos;Medical - Assistance Provided&apos;, &apos;invalid&apos;,
&apos;Medical - Patient&apos;, &apos;invalid&apos;,
&apos;Customs/Immigration&apos;, &apos;invalid&apos;,
&apos;Theft&apos;, &apos;invalid&apos;,
&apos;valid&apos;)</expression>
    </formulas>
    <formulas>
        <name>responseRequested</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!objNewCase.ParentId}), IF (ISBLANK(TEXT({!objNewCase.Is_Response_Requested__c})), &apos;Yes&apos;, 
TEXT({!objNewCase.Is_Response_Requested__c})), IF (ISBLANK(TEXT({!objNewCase.Parent.Is_Response_Requested__c})), &apos;Yes&apos;,
 TEXT({!objNewCase.Parent.Is_Response_Requested__c})))</expression>
    </formulas>
