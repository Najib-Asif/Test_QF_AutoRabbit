    <decisions>
        <description>Checking the criterias to publish the Platform Event</description>
        <name>Check_Is_Valid_Case_to_Publish_the_PE</name>
        <label>Check Is Valid Case to Publish the PE</label>
        <locationX>446</locationX>
        <locationY>542</locationY>
        <defaultConnectorLabel>Non Frequent Flyer Contact</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.Contact.Frequent_Flyer_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseOrigin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseGroup</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCategory</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Original_Case_Record.CreatedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Date120DaysBack</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>responseRequested</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getJsonPayload</targetReference>
            </connector>
            <label>Yes Valid Case</label>
        </rules>
    </decisions>
    <decisions>
        <description>checking is current case is a Child/Parent Case</description>
        <name>Original_Case_Check</name>
