                <leftValueReference>objNewCase.Freight_Shipment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>International</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Sub_Type_2__c</leftValueReference>
