    <decisions>
        <name>Queue_Changed</name>
        <label>Queue Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Queue_Changed_To_CCC_Query</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>caseId.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CCC_Musical_Baggage_Queue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>caseId.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CCC_OneWorld_Helpdesk_Queue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>caseId.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CCC_Emirates_Helpdesk_Queue</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record_Type_Id_for_QCC</targetReference>
            </connector>
            <label>Queue Changed To CCC Query</label>
        </rules>
        <rules>
            <name>Queue_Changed_to_AU_Sales_Support</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseId.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QIC_Sales_Support_Escalation_Queue</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record_Type_Id_for_QAC</targetReference>
            </connector>
            <label>Queue Changed to AU Sales Support</label>
        </rules>
    </decisions>
