    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>ValidateTheRecordTypeAndSubType</name>
        <label>ValidateTheRecordTypeAndSubType</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordTypeAndSubType</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CaseRecord.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Offers Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseRecord.Sub_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Corporate Trigger - 50% Bonus Status</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sales_Offers_Corporate_Trigger_50_Bonus_Trigger_Notification</targetReference>
            </connector>
            <label>RecordTypeAndSubType</label>
        </rules>
    </decisions>
