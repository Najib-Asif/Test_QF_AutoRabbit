<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Child_Case_CCC_And_B_Case_Type_c</name>
        <label>Assign Child Case CCC_And_B_Case_Type__c</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>objNewCase.CCC_And_B_Case_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>VarCCCAndBCaseType</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Child_case</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Checking_Childs_of_Old_Parent_Record</name>
        <label>Checking Childs of Old Parent Record</label>
        <locationX>182</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Update_Old_Parent_to_Parent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Child_Cases_Present_Under_Old_Parent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Old_Parent_Child_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Old_Parent_to_Stand_alone</targetReference>
            </connector>
            <label>No Child Cases Present Under Old Parent</label>
        </rules>
    </decisions>
    <decisions>
        <name>Updating_Child_Case_ParentId_Field</name>
        <label>Updating Child Case ParentId Field?</label>
        <locationX>380</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Updating_Child_Case_ParentId</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objOldCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.ParentId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>objNewCase.ParentId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Old_Parent_Child_Records</targetReference>
            </connector>
            <label>Yes Updating Child Case ParentId</label>
        </rules>
    </decisions>
    <description>This flow will update the &quot;CCC And B Case Type&quot; picklist value to parent/child/stand-alone.  CRM-5272 Differentiation of the case type for QCC(Platform change)</description>
    <environments>Default</environments>
    <formulas>
        <name>VarCCCAndBCaseType</name>
        <dataType>String</dataType>
        <expression>IF ( {!objNewCase.ParentId} == &apos;&apos;,  &apos;Stand-alone&apos;, &apos;Child&apos; )</expression>
    </formulas>
    <interviewLabel>QCC Update Case Type {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CaseAfterTriggerSubFlowQCC_UpdateCaseType</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Old_Parent_Child_Records</name>
        <label>Get Old Parent Child Records</label>
        <locationX>182</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Checking_Childs_of_Old_Parent_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>objOldCase.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>objNewCase.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Child_case</name>
        <label>Update Child case</label>
        <locationX>380</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Updating_Child_Case_ParentId_Field</targetReference>
        </connector>
        <inputReference>objNewCase</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Old_Parent_to_Parent</name>
        <label>Update Old Parent to Parent</label>
        <locationX>314</locationX>
        <locationY>782</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>objOldCase.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CCC_And_B_Case_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Parent</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Do_not_Send_Survey__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Old_Parent_to_Stand_alone</name>
        <label>Update Old Parent to Stand-alone</label>
        <locationX>50</locationX>
        <locationY>782</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>objOldCase.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CCC_And_B_Case_Type__c</field>
            <value>
                <stringValue>Stand-alone</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Do_not_Send_Survey__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>update_parent_case</name>
        <label>Update Parent case</label>
        <locationX>380</locationX>
        <locationY>134</locationY>
        <connector>
            <targetReference>Assign_Child_Case_CCC_And_B_Case_Type_c</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>objNewCase.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CCC_And_B_Case_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Parent</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>CCC_And_B_Case_Type__c</field>
            <value>
                <stringValue>Parent</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>update_parent_case</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>trigger.new</description>
        <name>objNewCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>objOldCase</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
