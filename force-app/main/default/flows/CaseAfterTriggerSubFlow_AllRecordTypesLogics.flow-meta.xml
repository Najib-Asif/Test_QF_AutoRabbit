            </connector>
            <label>ContractExtensionConditions</label>
        </rules>
        <rules>
            <name>ContractTerminationConditions</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.NAM_s_Approval__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal_Support_Request_Queue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Assigned-Deal Support-iDeal loading</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Owner:Group.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US_Case_Assignment_Queue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ISNEW</leftValueReference>
