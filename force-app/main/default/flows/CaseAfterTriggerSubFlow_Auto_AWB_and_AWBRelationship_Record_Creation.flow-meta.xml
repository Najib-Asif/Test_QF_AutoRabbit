    <decisions>
        <name>Validate_Product_SLA_Criteria</name>
        <label>Validate Product SLA Criteria</label>
        <locationX>402</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Set_Product_SLA_Met_to_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Do Not Meet SLA</defaultConnectorLabel>
        <rules>
            <name>Product_Q_Go_Priority_Shipment_Domestic_Wt_50_SLA_45min</name>
            <conditionLogic>1 AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>CaseRecord.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Q-GO Priority</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseRecord.Freight_Shipment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Domestic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Weight</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_AWB_Records.SLA_Target__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>45.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Product_SLA_to_True</targetReference>
            </connector>
            <label>Product - Q Go Priority Shipment - Domestic Wt &lt;50 SLA &lt;45min</label>
        </rules>
        <rules>
            <name>Product_Q_Go_Priority_Shipment_Domestic_Wt_50_SLA_60min</name>
            <conditionLogic>1 AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>CaseRecord.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Q-GO Priority</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseRecord.Freight_Shipment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Domestic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Weight</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_AWB_Records.SLA_Target__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Product_SLA_to_True</targetReference>
            </connector>
            <label>Product - Q Go Priority Shipment - Domestic Wt &gt;50 SLA &lt;60min</label>
        </rules>
        <rules>
            <name>Product_Q_Go_Priority_Shipment_International_SLA_120_min</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>CaseRecord.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Q-GO Express</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseRecord.Freight_Shipment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>International</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_AWB_Records.SLA_Target__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>120.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Product_SLA_to_True</targetReference>
            </connector>
            <label>Product - Q Go Priority Shipment - International  SLA &lt; 120 min</label>
        </rules>
        <rules>
            <name>Product_Q_Go_Express_Shipment_International_SLA_75_min</name>
            <conditionLogic>1 AND 2 AND 3</conditionLogic>
            <conditions>
                <leftValueReference>CaseRecord.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Q-GO Classic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseRecord.Freight_Shipment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>International</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_AWB_Records.SLA_Target__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>75.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Product_SLA_to_True</targetReference>
            </connector>
            <label>Product - Q Go Priority Shipment - International  SLA &lt; 75 min</label>
        </rules>
    </decisions>
