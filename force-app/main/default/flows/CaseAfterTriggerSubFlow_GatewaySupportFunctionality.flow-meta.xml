    <textTemplates>
        <name>GatewayEmailAcknowledgingReceiptofIssue</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello {!objNewCase.Consultants_Name__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;We have received your Qantas Gateway support query with the following details:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Support issue: &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!objNewCase.Group__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Topic: &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!objNewCase.Category__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Details: &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!objNewCase.Description}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;One of our team members will be in contact with you within 48 hours.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you&lt;/p&gt;&lt;p&gt;Qantas Gateway&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>GatewayEmailAcknowledgmentAutoClosed</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello {!objNewCase.SuppliedName}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;This email box is not monitored for new emails. Please raise a case from the Gateway website.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you&lt;/p&gt;&lt;p&gt;Qantas Gateway&lt;/p&gt;</text>
    </textTemplates>
