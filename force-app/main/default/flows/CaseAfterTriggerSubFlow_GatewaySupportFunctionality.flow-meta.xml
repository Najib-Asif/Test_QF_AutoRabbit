    <decisions>
        <name>Gateway_New_Case_Source</name>
        <label>Gateway New Case Source</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YES_ISNEW_Gateway_Web_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Gateway_Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Origin</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Email</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Consultant_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Gateway_Email_confirmation</targetReference>
            </connector>
            <label>YES ISNEW Gateway Web Case?</label>
        </rules>
        <rules>
            <name>YES_ISNEW_Gateway_Email_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Gateway_Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Consultant_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Gateway_Email_confirmation_Auto_Closed</targetReference>
            </connector>
            <label>YES ISNEW Gateway Email Case?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
