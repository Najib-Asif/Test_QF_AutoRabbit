        </rules>
        <rules>
            <name>Case_Closed</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal_Support_request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue> Niche Fares</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue> Closed - Deal Implemented</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue> Closed - Deal Implemented</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Niche Fares</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Notify_Case_Creator_when_Niche_Fares_Case_is_Closed</targetReference>
            </connector>
            <label>Case Closed</label>
        </rules>
    </decisions>
