    <decisions>
        <name>Case_type_check_with_status_as_approved</name>
        <label>Case type check with status as approved</label>
        <locationX>666</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Check_Status_is_Complete_Pending_PRISM_Deal_Load_send_notification_to_creator</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE Case type check with status as approved</defaultConnectorLabel>
        <rules>
            <name>TRUE_Case_type_check_with_status_as_approved</name>
            <conditionLogic>1 AND (2 OR 3) AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Support Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Extension</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_approval_post_to_the_case_requester</targetReference>
            </connector>
            <label>TRUE Case type check with status as approved</label>
        </rules>
        <rules>
            <name>TRUE_Case_type_check_with_status_as_Rejected</name>
            <conditionLogic>1 AND (2 OR 3) AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Support Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Extension</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Rejection_post_to_the_case_requester</targetReference>
            </connector>
            <label>TRUE Case type check with status as Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <description>This decision will check role and deal termination record type and send a chatter notification to user reporting manager&apos;s manager</description>
        <name>Check_Role_and_Deal_Termination</name>
        <label>Check Role and Deal Termination</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Check_Status_is_Complete_Pending_PRISM_Deal_Load_send_notification_to_creator</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approval_Role_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.CreatedBy.Manager.UserRole.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>QIS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Manager_s_Manager_notification</targetReference>
            </connector>
            <label>Approval Role Check</label>
        </rules>
        <rules>
            <name>Rejection_Role_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.CreatedBy.Manager.UserRole.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>QIS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal Termination</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reject_Manager_s_Manager_notification</targetReference>
            </connector>
            <label>Rejection Role Check</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status_is_Complete_Pending_PRISM_Deal_Load_send_notification_to_creator</name>
        <label>Check Status is Complete – Pending PRISM Deal Load send notification to creator</label>
        <locationX>666</locationX>
        <locationY>734</locationY>
        <defaultConnector>
            <targetReference>Notify_Case_Creator_when_Niche_Fares_case_is_created_Or_closed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TRUE_Status_is_Complete_Pending_PRISM_Deal_Load_send_notification_to_creator</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal_Support_request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Complete - Pending PRISM Deal Load</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Account.BillingCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Complete - Pending PRISM Deal Load</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Account.BillingCountry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>NotificationtoCasecreator</targetReference>
            </connector>
            <label>TRUE Status is Complete – Pending PRISM Deal Load send notification to creator</label>
        </rules>
    </decisions>
    <decisions>
        <name>Notify_Case_Creator_when_Niche_Fares_case_is_created_Or_closed</name>
        <label>Notify Case Creator when Niche Fares case is created Or closed</label>
        <locationX>930</locationX>
        <locationY>842</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Created</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Deal_Support_request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue> Niche Fares</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>with AU Sales Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>with AU Sales Support</stringValue>
