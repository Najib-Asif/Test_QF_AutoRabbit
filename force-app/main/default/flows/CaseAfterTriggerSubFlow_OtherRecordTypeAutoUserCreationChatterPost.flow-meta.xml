    <decisions>
        <name>Check_Approved_and_closed</name>
        <label>Check Approved and closed</label>
        <locationX>578</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Check_Is_QIdeas</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE Check Approved and closed</defaultConnectorLabel>
        <rules>
            <name>TRUE_Check_Approved_and_closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.Approved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue> Service Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System_Admin_Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Sub_Type_2__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue> User Maintenance (New User)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Comments__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>User has been Created from flow</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_to_new_User</targetReference>
            </connector>
            <label>TRUE Check Approved and closed</label>
        </rules>
    </decisions>
