    <formulas>
        <name>QICServiceRequestCasePriorityHighCalculation</name>
        <dataType>Boolean</dataType>
        <expression>IF(
NOT(ISBLANK({!objNewCase.AccountId})),
AND(
{!objNewCase.RecordType.DeveloperName} = &quot;QIC_Service_request&quot;,
NOT(CONTAINS(TEXT({!objNewCase.Status}), &apos;Closed&apos;)),
{!objNewCase.Account.RecordType.DeveloperName} =&quot;Agency_Account&quot;,
OR( 
CONTAINS({!objNewCase.Account_Tier__c}, &quot;Platinum&quot;),
ISPICKVAL({!objNewCase.Customer_Tier__c} , &quot;CL&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;PO&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;PL&quot;), 
AND(
{!objNewCase.Travel_expected_date__c} &lt;= 3, 
{!objNewCase.Travel_expected_date__c} &gt;0
),
AND(
{!objNewCase.No_of_Days_for_Ticketing__c} &lt;= 3 ,
{!objNewCase.No_of_Days_for_Ticketing__c} &gt; 0 
)
)
),
FALSE
)</expression>
    </formulas>
    <formulas>
        <name>QICServiceRequestCasePriorityLowCalculation</name>
        <dataType>Boolean</dataType>
        <expression>IF(
NOT(ISBLANK({!objNewCase.AccountId})),
AND( 
{!objNewCase.RecordType.DeveloperName} = &quot;QIC_Service_request&quot;,
NOT(CONTAINS( TEXT({!objNewCase.Status} ), &apos;Closed&apos;)),
{!objNewCase.Account.RecordType.DeveloperName} =&quot;Agency_Account&quot;,
OR( 
CONTAINS(({!objNewCase.Account_Tier__c}), &quot;Bronze&quot;),
CONTAINS(({!objNewCase.Account_Tier__c}), &quot;White&quot;)
), 
NOT(CONTAINS({!objNewCase.Account_Tier__c}, &quot;Platinum&quot;)),
NOT(CONTAINS({!objNewCase.Account_Tier__c}, &quot;Gold&quot;)), 
NOT(CONTAINS({!objNewCase.Account_Tier__c}, &quot;Silver&quot;)), 
OR( 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;GD&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;SL&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;BR-NON&quot;) 
), 
OR( 
ISNULL({!objNewCase.Travel_expected_date__c}), 
{!objNewCase.Travel_expected_date__c} &gt;3,
{!objNewCase.Travel_expected_date__c} &lt;0
), 
OR( 
ISNULL({!objNewCase.No_of_Days_for_Ticketing__c}), 
{!objNewCase.No_of_Days_for_Ticketing__c} &gt;3 ,
{!objNewCase.No_of_Days_for_Ticketing__c} &lt;0 
), 
OR( 
NOT(ISPICKVAL({!objNewCase.Customer_Tier__c},&quot;CL&quot;)), 
NOT(ISPICKVAL({!objNewCase.Customer_Tier__c},&quot;PO&quot;)), 
NOT(ISPICKVAL({!objNewCase.Customer_Tier__c},&quot;PL&quot;)) 
) 
),
FALSE
)</expression>
    </formulas>
    <formulas>
        <name>QICServiceRequestCasePriorityMediumCalculation</name>
        <dataType>Boolean</dataType>
        <expression>IF(
NOT(ISBLANK({!objNewCase.AccountId})),
AND(
{!objNewCase.RecordType.DeveloperName} = &quot;QIC_Service_request&quot;, 
NOT(CONTAINS( TEXT({!objNewCase.Status} ), &apos;Closed&apos;)),
{!objNewCase.Account.RecordType.DeveloperName} =&quot;Agency_Account&quot;,
OR( 
CONTAINS({!objNewCase.Account_Tier__c}, &quot;Gold&quot;),
CONTAINS({!objNewCase.Account_Tier__c}, &quot;Silver&quot;)
), 
NOT(CONTAINS({!objNewCase.Account_Tier__c}, &quot;Platinum&quot;)),
NOT(CONTAINS({!objNewCase.Account_Tier__c}, &quot;Bronze&quot;)), 
NOT(CONTAINS({!objNewCase.Account_Tier__c}, &quot;White&quot;)), 
OR( 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;GD&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;SL&quot;), 
ISPICKVAL({!objNewCase.Customer_Tier__c}, &quot;BR-NON&quot;) 
), 
OR( 
ISNULL({!objNewCase.Travel_expected_date__c}), 
