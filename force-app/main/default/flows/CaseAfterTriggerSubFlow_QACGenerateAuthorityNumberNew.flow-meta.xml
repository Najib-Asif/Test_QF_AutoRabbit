    <decisions>
        <name>Check_Authority_Number_is_Null</name>
        <label>Check Authority Number is Null?</label>
        <locationX>468</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Check_QIC_Info_Last_Number_not_equals_to_AuthNumb</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Authority_Number_c_is_Null_For_Service_Request</name>
            <conditionLogic>1 AND 2 AND ( 3 OR 4 )  AND 5</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.Authority_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_QIC_Auto_Number_Record.Record_Type__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Authority_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Authority_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Type</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_QIC_Auto_Number_Record.CaseType__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Auth_Number</targetReference>
            </connector>
            <label>Yes Authority_Number__c is Null For Service Request</label>
        </rules>
        <rules>
            <name>Yes_Authority_Number_c_is_Null_For_Master_Operational_Waiver</name>
            <conditionLogic>1 AND 2 AND ( 3 OR 4 )</conditionLogic>
            <conditions>
                <leftValueReference>objNewCase.Authority_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_QIC_Auto_Number_Record.Blanket_Waiver__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Authority_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Auto Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Authority_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_Case_Auth_Number</targetReference>
            </connector>
            <label>Yes Authority_Number__c is Null For Master Operational Waiver</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_QIC_Info_EndNumber_Equals_to_authNum</name>
        <label>Check QIC Info EndNumber Equals to authNum?</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Check_QIC_Info_Last_Number_not_equals_to_AuthNumb</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YES_QIC_Info_EndNumber_Equals_to_authNum</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>authNum</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_QIC_Auto_Number_Record.EndNumber__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Start_Number_to_Auth_Num</targetReference>
            </connector>
            <label>YES QIC Info EndNumber Equals to authNum</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_QIC_Info_Last_Number_not_equals_to_AuthNumb</name>
        <label>Check QIC Info Last Number not equals to AuthNumb?</label>
        <locationX>468</locationX>
        <locationY>842</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YES</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_QIC_Auto_Number_Record.LastNumber__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>authNum</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Auth_Numb_To_QIC_Info_Last_Number</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <description>migrated from clsCaseFieldUpdatesHelper.generateAuthorityNumberNew() method.(Platform change)</description>
