    <description>This flow is used to calculate the case status duration in case value change object. Created as per CRM - 5138(Platform change)</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseStatusChangedIntreval</name>
        <dataType>Number</dataType>
        <expression>({!CurrentDateTime} - {!PriorDateTime})</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <description>CRM-5265
Case Value Changes - for 30 seconds</description>
        <name>CeilingSecondsToMinutes</name>
        <dataType>Number</dataType>
        <expression>IF ({!Seconds} &gt; 30, {!Mins} + 1, {!Mins})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Days</name>
        <dataType>Number</dataType>
        <expression>FLOOR({!CaseStatusChangedIntreval})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Duration</name>
        <dataType>String</dataType>
        <expression>IF({!Days}&gt;1, TEXT({!Days})+&apos; Days&apos;, TEXT({!Days})+&apos; Day&apos;)+&apos;  &apos;+IF({!Hrs}&gt;1, TEXT({!Hrs})+&apos; Hrs&apos;, TEXT({!Hrs})+&apos; Hr&apos;)+&apos; : &apos;+IF({!CeilingSecondsToMinutes}&gt;1, TEXT({!CeilingSecondsToMinutes})+&apos; Mins&apos;, TEXT({!CeilingSecondsToMinutes})+&apos; Min&apos;)</expression>
    </formulas>
    <formulas>
        <name>Hrs</name>
        <dataType>Number</dataType>
        <expression>FLOOR({!remainingTotalHrs})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Mins</name>
        <dataType>Number</dataType>
        <expression>FLOOR({!remainingTotalMinutes})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>remainingTotalHrs</name>
        <dataType>Number</dataType>
        <expression>({!CaseStatusChangedIntreval}-{!Days})*24</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>remainingTotalMinutes</name>
        <dataType>Number</dataType>
        <expression>({!remainingTotalHrs}-{!Hrs})*60</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>remainingTotalSeconds</name>
        <dataType>Number</dataType>
        <expression>({!remainingTotalMinutes}-{!Mins})*60</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Seconds</name>
        <dataType>Number</dataType>
        <expression>FLOOR({!remainingTotalSeconds})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TotalCaseDurationinminutes</name>
        <dataType>Number</dataType>
        <expression>({!Days}*1440+{!Hrs}*60+{!CeilingSecondsToMinutes})</expression>
        <scale>4</scale>
    </formulas>
