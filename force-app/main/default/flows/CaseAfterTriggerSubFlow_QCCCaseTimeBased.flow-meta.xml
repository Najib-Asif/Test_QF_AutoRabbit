NOT(ISPICKVAL({!objNewCase.Origin}, &apos;Red App&apos; )),
OR({!objNewCase.RecordType.DeveloperName} = &apos;CCC_Complaints&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Baggage&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Further_Action_Required&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;QCC_Insurance_Letter_Case&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Query&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Medical&apos; ),  NOT(ISPICKVAL({!objNewCase.Type},&apos;On the Spot Recovery&apos;)),
IF(ISPICKVAL({!objNewCase.Type}, &apos;Insurance Letter&apos;) &amp;&amp; {!objNewCase.FCR__c} &lt;&gt; true , true, IF(NOT(ISPICKVAL({!objNewCase.Type}, &apos;Insurance Letter&apos;)), true, false)),
ISPICKVAL({!objNewCase.Is_Response_Requested__c}, &apos;Yes&apos;),
