    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!objNewCase.Hot_words_check__c} =FALSE,
NOT(ISBLANK({!objNewCase.ContactId})),
NOT(ISBLANK({!objNewCase.Contact_Email__c})),
NOT(ISPICKVAL({!objNewCase.Status} , &apos;Closed&apos;)),
NOT(ISPICKVAL({!objNewCase.Origin}, &apos;Red App&apos; )),
OR({!objNewCase.RecordType.DeveloperName} = &apos;CCC_Complaints&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Baggage&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Further_Action_Required&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;QCC_Insurance_Letter_Case&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Query&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Medical&apos;, {!objNewCase.RecordType.DeveloperName} = &apos;CCC_Refund&apos; ),  NOT(ISPICKVAL({!objNewCase.Type},&apos;On the Spot Recovery&apos;)),
IF(ISPICKVAL({!objNewCase.Type}, &apos;Insurance Letter&apos;) &amp;&amp; {!objNewCase.FCR__c} &lt;&gt; true , true, IF(NOT(ISPICKVAL({!objNewCase.Type}, &apos;Insurance Letter&apos;)), true, false)),
ISPICKVAL({!objNewCase.Is_Response_Requested__c}, &apos;Yes&apos;),
NOT({!objNewCase.Acknowledgement_Sent__c}),
ISBLANK({!objNewCase.ParentId}))</expression>
    </formulas>
    <formulas>
