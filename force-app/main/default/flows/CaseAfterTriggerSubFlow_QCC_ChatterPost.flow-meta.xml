    <decisions>
        <name>Check_Email_Message_Chatter_Post</name>
        <label>Check Email Message Chatter Post</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Check_Owner_Change_Chatter_Post</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TRUE_Check_Email_Message_Chatter_Post</name>
            <conditionLogic>1 AND 2 AND ( 3 OR 4 )</conditionLogic>
            <conditions>
                <leftValueReference>objOldCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reply Received</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Waiting for Customer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Waiting for Internal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Publish_to_Chatter_Post</targetReference>
            </connector>
            <label>TRUE Check Email Message Chatter Post</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Owner_Change_Chatter_Post</name>
        <label>Check Owner Change Chatter Post</label>
        <locationX>182</locationX>
        <locationY>434</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TRUE_Check_Owner_Change_Chatter_Post</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objOldCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objOldCase.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>objNewCase.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>objNewCase.OwnerId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>005</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Publish_to_Chatter_Post_for_Owner_Change</targetReference>
            </connector>
            <label>TRUE Check Owner Change Chatter Post</label>
        </rules>
    </decisions>
