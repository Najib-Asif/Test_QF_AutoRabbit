an style=&quot;font-size: 16px; font-family: serif; color: rgb(68, 68, 68);&quot;&gt;        &lt;img src=&quot;https://qantas.lightning.force.com/servlet/servlet.ImageServer?id=0159000000FSVke&amp;oid=00D8s00000IDoz7&amp;lastMod=1521233610000&quot; alt=&quot;Qantas_Logo&quot; /&gt; &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 16px; font-family: serif; color: rgb(68, 68, 68);&quot;&gt;    &lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;Qantas Airways Limited, ABN 16 009 661 901&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;10 Bourke Road, Mascot NSW 2020 Australia | qantas.com&lt;/span&gt;&lt;/p&gt;</text>
