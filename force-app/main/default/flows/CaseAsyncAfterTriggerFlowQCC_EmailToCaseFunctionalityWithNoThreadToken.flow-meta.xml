    <decisions>
        <name>Create_System_Admin_Case_Or_Email_Bounce_Back_Case</name>
        <label>Create System Admin Case Or Email Bounce Back Case</label>
        <locationX>440</locationX>
        <locationY>384</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Create_Email_Bounce_Case</name>
            <conditionLogic>1 AND ( 2 OR 3 OR 4 OR 6 ) AND (NOT (5))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CCC Email Bounced Back</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Qantas Customer Care</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>We are waiting to hear from you regarding your case number</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>An update regarding your</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Email_Message_records.ToAddress</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>gmcescalations@qantas.com.au</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Jetstar - We didn&apos;t receive your email</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_CCC_Exception_Queue</targetReference>
            </connector>
            <label>Create Email Bounce Case</label>
        </rules>
        <rules>
            <name>Create_System_Admin_Case</name>
            <conditionLogic>1 AND (NOT (2))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
