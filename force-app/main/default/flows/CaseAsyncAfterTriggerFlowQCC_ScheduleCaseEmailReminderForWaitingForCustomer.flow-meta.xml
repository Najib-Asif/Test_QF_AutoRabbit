    <decisions>
        <description>This Decision is added to identify if the case is GW and to reject all the relared WOLIs so that case can be updated to &apos;Closed&apos;</description>
        <name>Check_If_GW_Case</name>
        <label>Check If GW Case</label>
        <locationX>824</locationX>
        <locationY>684</locationY>
        <defaultConnector>
            <targetReference>myWaitEvent_myWait_myRule_1_event_1_SA2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_is_GW_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record_01.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CCC_Query</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record_01.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Claims and Reimbursements</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record_01.Group__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Flight Disruptions</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record_01.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accommodation/Reimbursement of Expenses</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_owner_update_to_Running_user</targetReference>
            </connector>
            <label>Yes is GW Case</label>
        </rules>
    </decisions>
