    <decisions>
        <name>Is_Previous_Response_sent_less_than_One_year</name>
        <label>Is Previous Response sent less than One year?</label>
        <locationX>446</locationX>
        <locationY>1092</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Assign_Template_And_Date_Fields</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE Check sameComplimentType is True?</defaultConnectorLabel>
        <rules>
            <name>TRUE_Check_sameComplimentType_is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sameComplimentType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>prev_Counter</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>prev_FirstCaseDateDaysBetweenToday</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>365.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Template_To_Be_Used_Field</targetReference>
            </connector>
            <label>TRUE Is Previous Response sent less than One year?</label>
        </rules>
        <rules>
            <name>Previous_Response_sent_Grater_than_One_year</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sameComplimentType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>prev_Counter</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>prev_CaseDateDaysBetweenToday</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>365.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>prev_FirstCaseDateDaysBetweenToday</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>365.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_Template_And_Date_Fields</targetReference>
            </connector>
            <label>Previous Response sent Grater than One year?</label>
        </rules>
        <rules>
            <name>SameComplimentType_if_False</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sameComplimentType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_Template_And_Date_Fields</targetReference>
            </connector>
            <label>SameComplimentType if False</label>
        </rules>
    </decisions>
