    <description>This flow assigns the freight Account to Freight Web Cases.
 Account assigned based on the region for Web-to- Case.[CRM 9791]</description>
    <environments>Default</environments>
    <formulas>
        <name>AccountEmailDomain</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.Contact.Account.Email__c}, LEN({!$Record.Contact.Account.Email__c}) - FIND(&quot;@&quot;,{!$Record.Contact.Account.Email__c}))</expression>
    </formulas>
    <formulas>
        <name>AccountNameTrimmed</name>
        <dataType>String</dataType>
        <expression>UPPER( 
TRIM( 
IF( 
CONTAINS({!loopAroundAccounts.Name}, &quot;[&quot;), 
LEFT( 
{!loopAroundAccounts.Name}, 
FIND(&quot;[&quot;, {!loopAroundAccounts.Name}) - 1 
), 
{!loopAroundAccounts.Name}
) 
) 
)</expression>
    </formulas>
    <formulas>
        <name>CaseEmailDomain</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.SuppliedEmail}, LEN({!$Record.SuppliedEmail}) - FIND(&quot;@&quot;,{!$Record.SuppliedEmail}))</expression>
    </formulas>
    <formulas>
        <name>CompanyMatches</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(
{!SuppliedCompanyUpper},
{!AccountNameTrimmed}
)</expression>
    </formulas>
    <formulas>
        <name>SuppliedCompanyUpper</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!$Record.SuppliedCompany}))</expression>
    </formulas>
