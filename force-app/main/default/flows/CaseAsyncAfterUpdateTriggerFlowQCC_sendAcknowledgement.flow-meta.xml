    <formulas>
        <name>formula_TRUE_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.Hot_words_check__c} =FALSE,
NOT(ISBLANK({!$Record.ContactId})),
NOT(ISBLANK({!$Record.Contact_Email__c})),
NOT(ISPICKVAL({!$Record.Status} , &apos;Closed&apos;)),
NOT(ISPICKVAL({!$Record.Origin}, &apos;Red App&apos; )),
OR({!$Record.RecordType.DeveloperName} = &apos;CCC_Complaints&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Baggage&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Further_Action_Required&apos;, {!$Record.RecordType.DeveloperName} = &apos;QCC_Insurance_Letter_Case&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Query&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Medical&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Refund&apos; ),  NOT(ISPICKVAL({!$Record.Type},&apos;On the Spot Recovery&apos;)),
IF(ISPICKVAL({!$Record.Type}, &apos;Insurance Letter&apos;) &amp;&amp; {!$Record.FCR__c} &lt;&gt; true , true, IF(NOT(ISPICKVAL({!$Record.Type}, &apos;Insurance Letter&apos;)), true, false)),
ISPICKVAL({!$Record.Is_Response_Requested__c}, &apos;Yes&apos;),
NOT({!$Record.Acknowledgement_Sent__c}),
ISBLANK({!$Record.ParentId}))</expression>
    </formulas>
    <formulas>
        <name>formula_TRUE_myRule_113</name>
        <dataType>Boolean</dataType>
        <expression>AND(
{!$Record.Hot_words_check__c} =TRUE,
NOT(ISBLANK({!$Record.ContactId})),
NOT(ISBLANK({!$Record.Contact_Email__c})),
NOT(ISPICKVAL({!$Record.Status} , &apos;Closed&apos;)),
NOT(ISPICKVAL({!$Record.Origin}, &apos;Red App&apos; )),
OR({!$Record.RecordType.DeveloperName} = &apos;CCC_Complaints&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Baggage&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Further_Action_Required&apos;, {!$Record.RecordType.DeveloperName} = &apos;QCC_Insurance_Letter_Case&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Query&apos;, {!$Record.RecordType.DeveloperName} = &apos;CCC_Medical&apos; ),  NOT(ISPICKVAL({!$Record.Type},&apos;On the Spot Recovery&apos;)),
IF(ISPICKVAL({!$Record.Type}, &apos;Insurance Letter&apos;) &amp;&amp; {!$Record.FCR__c} &lt;&gt; true , true, IF(NOT(ISPICKVAL({!$Record.Type}, &apos;Insurance Letter&apos;)), true, false)),
ISPICKVAL({!$Record.Is_Response_Requested__c}, &apos;Yes&apos;),
NOT({!$Record.Acknowledgement_Sent__c}),
ISBLANK({!$Record.ParentId}))</expression>
    </formulas>
