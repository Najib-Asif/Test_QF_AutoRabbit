<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Contact_is_tagged_to_Case_or_not</name>
        <label>Check Contact is tagged to Case or not?</label>
        <locationX>446</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Contact_Missing_Error_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Case_is_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>closed_Case_Error_Msg_Heading</targetReference>
            </connector>
            <label>Is Case is Closed?</label>
        </rules>
        <rules>
            <name>Contact_tagged_to_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.ContactId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Is_Contact_Fields_are_Missing</targetReference>
            </connector>
            <label>Contact tagged to Case</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Is_Contact_Fields_are_Missing</name>
        <label>Check Is Contact Fields are Missing</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Contact_Fields_Missing_Error_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.First_Name__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record.Last_Name__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record.Contact_Email__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Record.Contact_Phone__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Change_Case_Record_Type_Flow</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>CRM-9338: Enable &apos;Change Record Type&apos; via &apos;Actions &amp; Recommendations&apos; in a QCC Voice Case</description>
    <environments>Default</environments>
    <formulas>
        <name>ContactFieldsMissingErrorMsg</name>
        <dataType>String</dataType>
        <expression>&apos;Please ensure case has a valid &apos; +
IF (BEGINS({!EmptyFields}, &apos;,&apos;), RIGHT({!EmptyFields}, LEN({!EmptyFields}) -2 ), {!EmptyFields} )
 +
 &apos; in order to change the record type.&apos;</expression>
    </formulas>
    <formulas>
        <name>EmptyFields</name>
        <dataType>String</dataType>
        <expression>
IF (ISBLANK({!Get_Case_Record.First_Name__c}), &apos;First Name&apos;, &apos;&apos; ) +  IF (ISBLANK({!Get_Case_Record.Last_Name__c}), &apos;, Last Name&apos;, &apos;&apos; ) + IF (ISBLANK({!Get_Case_Record.Contact_Phone__c}), &apos;, Phone&apos;, &apos;&apos; ) +  
IF (ISBLANK({!Get_Case_Record.Contact_Email__c}), &apos;, Email Address&apos;, &apos;&apos; )</expression>
    </formulas>
