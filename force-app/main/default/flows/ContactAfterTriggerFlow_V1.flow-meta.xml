    <formulas>
        <name>IsKeyCoordinatorFieldChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.FirstName})||
ISCHANGED({!$Record.LastName}) ||
ISCHANGED({!$Record.Title}) ||
ISCHANGED({!$Record.Salutation})||
ISCHANGED({!$Record.MailingCity} )||
ISCHANGED({!$Record.MailingCountry} )||
ISCHANGED({!$Record.MailingState} )||
ISCHANGED({!$Record.MailingPostalCode} )||
ISCHANGED({!$Record.MailingStreet} )||
ISCHANGED({!$Record.Phone})||
ISCHANGED({!$Record.MobilePhone})||
ISCHANGED({!$Record.Email})||
ISCHANGED({!$Record.Job_Role__c})</expression>
    </formulas>
    <formulas>
        <description>Formula variable to check the criteria to send SMS or not</description>
        <name>sendSMSCriteria</name>
        <dataType>Boolean</dataType>
        <expression>OR(
	AND(
		ISNEW(),
               NOT(ISBLANK({!$Record.QCC_TECH_Loyalty_Point_Type__c})),
		TEXT({!$Record.QCC_LoyaltyBonus_Channel__c}) = &apos;SMS&apos;
	),
	AND(
		NOT(ISNEW()),
                NOT(ISBLANK({!$Record.QCC_TECH_Loyalty_Point_Type__c})),
		TEXT({!$Record.QCC_LoyaltyBonus_Channel__c}) = &apos;SMS&apos;,
		OR(
			ISCHANGED({!$Record.QCC_TECH_Loyalty_Point_Type__c}),
			ISCHANGED({!$Record.QCC_LoyaltyBonus_Channel__c})
		)
	)
)</expression>
    </formulas>
