<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>For testing changed 15 days reminder to 1 hour</description>
    <environments>Default</environments>
    <formulas>
        <name>EFTRecovery</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.RecordType.DeveloperName} = &apos;EFT_Recovery&apos;, true, false)</expression>
    </formulas>
    <interviewLabel>EFT Recovery - Awaiting Customer Scheduled Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EFT Recovery - Awaiting Customer Scheduled Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Process_Status_to_Expired</name>
        <label>Update Process Status to Expired</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>Process_Status__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.RecordType.DeveloperName} = &apos;EFT_Recovery&apos;, ISPICKVAL({!$Record.Process_Status__c}, &apos;Awaiting Customer Response&apos;))</filterFormula>
        <object>Recovery__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X30_days_from_now</name>
            <connector>
                <targetReference>Update_Process_Status_to_Expired</targetReference>
            </connector>
            <label>30 days from now</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Awaiting_Customer_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X15_days_from_now</name>
            <connector>
                <targetReference>Invoke_Email_Framework</targetReference>
            </connector>
            <label>15 days from now</label>
            <offsetNumber>15</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Invoke Email framework to trigger an email</description>
        <name>Invoke_Email_Framework</name>
        <label>Invoke Email Framework</label>
        <locationX>440</locationX>
        <locationY>276</locationY>
        <flowName>RecoveryEmailFramework</flowName>
        <inputAssignments>
            <name>recoveryRecord</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Source</name>
            <value>
                <stringValue>Trigger</stringValue>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
