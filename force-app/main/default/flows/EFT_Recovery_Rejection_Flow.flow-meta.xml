    <decisions>
        <description>For EFT: Case is open (not in &apos;Closed&apos; Status) and a related EFT Recovery is in any of the following Process Statuses:
Submitted to Finance
Findel Approved
Payment Ready
Payment Sent

(or) 

Travel Voucher Recovery</description>
        <name>Check_Case_Status</name>
        <label>EFT (or) TV Recovery (or) Credit Card Recovery</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Closed</name>
            <conditionLogic>1 AND (6 AND ( 2 OR 3 OR 4 OR 5 OR 8)) OR 7</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Number__r.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Process_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted to Finance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Process_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Findel Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Process_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Payment Ready</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Process_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Payment Sent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EFT_Recovery</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Credit_Card_Recovery</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Process_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Payment Finalised</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Cloned_Recovery_Values_Credit_Card</targetReference>
            </connector>
            <label>EFT Or Credit Card Case Open and its Process Status Changed</label>
        </rules>
        <rules>
            <name>TV_Recovery</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Travel_Voucher_Recovery</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clone_RejectedRecovery</targetReference>
            </connector>
            <label>TV Recovery</label>
        </rules>
    </decisions>
