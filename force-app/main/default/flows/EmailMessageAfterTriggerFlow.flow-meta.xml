    <formulas>
        <name>CurrentDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>CustomNotificationBody</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.ParentId}), &quot;&quot; , {!$Record.Parent.CaseNumber}) &amp; &quot; Email Sent to &quot; &amp; {!$Record.ToAddress} &amp; &quot; has been bounced.&quot;</expression>
    </formulas>
    <formulas>
        <name>IsCaseResolvedGreaterThan30Days</name>
        <dataType>Boolean</dataType>
        <expression>IF (ISNULL({!$Record.ParentId}) || ISNULL({!$Record.Parent.Original_Closed_Date__c}), FALSE, TODAY() &gt; {!$Record.Parent.Original_Closed_Date__c} + 30)</expression>
    </formulas>
    <formulas>
