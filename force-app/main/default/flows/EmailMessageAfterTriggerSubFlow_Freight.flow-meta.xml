        <name>FRT_Acknowledgement_Email_For_FRT_Cust_Service</name>
        <label>FRT Acknowledgement Email For FRT Cust Service</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <defaultConnector>
