            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Incoming</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Parent.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>0122v000001qpr9AAA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Parent.SuppliedEmail</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>qantas.com</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Subject</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RE:</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Subject</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FW:</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Parent.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FRT Cust Service</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewEmailMessageRecord.Parent.SuppliedEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Freight_Email_Alert_to_FRT_Cust_Service</targetReference>
            </connector>
            <label>Send Email</label>
        </rules>
    </decisions>
