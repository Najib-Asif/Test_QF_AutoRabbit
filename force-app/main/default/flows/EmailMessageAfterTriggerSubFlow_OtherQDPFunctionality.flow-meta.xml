<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>update case status to Reply Received and Owner to QAC Contact Us Support Queue</description>
        <name>Assign_Case_Status_To_Reply_Received</name>
        <label>Assign Case Status To Reply Received</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>Get_QDP_Case_Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reply Received</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_QDP_Case_Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Fetch_QDP_Portal_Support.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>update case status to Reply Received and Owner to QAC Contact us Support Queue</description>
        <name>Assignment_1</name>
        <label>Assign Case Status To Re Open</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>Get_QDP_Case_Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reopened</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_QDP_Case_Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Fetch_QDP_Portal_Support.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Email_Message_is_Incoming</name>
        <label>Check Email Message is Incoming?</label>
        <locationX>534</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>FALSE Email Message is Incoming</defaultConnectorLabel>
        <rules>
            <name>TRUE_Email_Message_is_Incoming</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewEmail.Incoming</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_QDP_Case_Record</targetReference>
            </connector>
            <label>TRUE Email Message is Incoming</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_QDP_Case_Status</name>
        <label>Check QDP Case Status?</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Update_Case_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>QDP_Closed_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_QDP_Case_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QDP_Case_Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resolved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QDP_Case_Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QAC_Contact_Us_Support</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_1</targetReference>
            </connector>
            <label>QDP Closed Case</label>
        </rules>
        <rules>
            <name>QDP_On_Hold_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_QDP_Case_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QDP_Case_Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_QDP_Case_Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>QAC_Contact_Us_Support</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Status_To_Reply_Received</targetReference>
            </connector>
            <label>QDP On Hold Case</label>
        </rules>
    </decisions>
    <description>CRM-7533
