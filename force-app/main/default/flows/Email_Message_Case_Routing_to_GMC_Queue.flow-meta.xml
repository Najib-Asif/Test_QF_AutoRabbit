    <decisions>
        <name>Case_owner_update_to_GMC_Queue</name>
        <label>Case owner update to GMC Queue</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Exclude_CCAT_user_for_case_owner_update_to_GMC_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TriggeringRecord.Parent.Is_CCAT_User__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Exclude CCAT user for case owner update to GMC Queue</label>
        </rules>
        <rules>
            <name>Update_to_GMC_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TriggeringRecord.ToAddress</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>gmcescalations@qantas.com.au</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_record_owner</targetReference>
            </connector>
            <label>Update to GMC Queue</label>
        </rules>
    </decisions>
    <description>CRM - 8140 : If any mail is forwarded to gmcescalations@qantas.com.au, then that particular case is assigned to GMC Triage Queue
2. Removed Get Case record and condition for validationg case Id as part of ticket CDP2-1162</description>
