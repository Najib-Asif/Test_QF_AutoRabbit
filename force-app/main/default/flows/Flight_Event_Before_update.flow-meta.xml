<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AssignFlightEvent</name>
        <label>AssignFlightEvent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Flight_Event__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Flight_Event.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>FlightNumber</name>
        <dataType>String</dataType>
        <expression>{!$Record.Operating_Carrier__c}+{!$Record.Flight_Number__c}</expression>
    </formulas>
    <interviewLabel>Flight Event Before update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Before insert Flight Event</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Flight_Event</name>
        <label>Get Flight Event</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>AssignFlightEvent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Operational_Carrier__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Operating_Carrier__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>FlightNumber__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>FlightNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>DeparturePort__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DepartureAirport__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ArrivalPort__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ArrivalAirport__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ScheduledDepDate__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DepartureDateLocal__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Event__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Flight_Event</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Source__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Disruption Engine</stringValue>
            </value>
        </filters>
        <filters>
            <field>Flight_Event__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>FlightFailure__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
