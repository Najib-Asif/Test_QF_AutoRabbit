        <rules>
            <name>Set_Priority_to_Urgent</name>
            <conditionLogic>(6 OR 7) AND (1 OR 2) AND (3 OR 4) AND 5</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Qantas_Freight_RecordTypeId</elementReference>
                </rightValue>
