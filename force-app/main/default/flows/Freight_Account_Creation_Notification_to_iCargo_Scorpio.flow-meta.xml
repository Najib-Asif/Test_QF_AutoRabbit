    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND (

ISPICKVAL([AccountContactRelation].Account.New_Account_Type__c , &apos;Freight-Branch&apos;), 

NOT(ISNEW()),


[AccountContactRelation].Account.Freight_Email_Sent__c == False, 

 ISPICKVAL([AccountContactRelation].Account.Freight_Revenue_Stream__c, &apos;INT&apos;))


