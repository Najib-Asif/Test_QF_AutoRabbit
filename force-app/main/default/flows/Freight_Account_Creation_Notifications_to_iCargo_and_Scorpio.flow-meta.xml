    <decisions>
        <description>Decision will check whether Freight  is INT or DOM or INT/DOM</description>
        <name>Freight_INT_DOM_Account_Check</name>
        <label>Freight INT/DOM Account Check</label>
        <locationX>446</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Freight_INT_Account_Check</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>FreightINTAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_sent_check_INT</targetReference>
            </connector>
            <label>Freight INT Account Check</label>
        </rules>
        <rules>
            <name>Freight_DOM_Account_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FreightDOMCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_sent_check_DOM</targetReference>
            </connector>
            <label>Freight DOM Account Check</label>
        </rules>
        <rules>
            <name>Freight_INT_AND_DOM_Account_Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FreightINTAndDOMcheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_sent_check_INT_DOM</targetReference>
            </connector>
            <label>Freight INT/DOM Account Check</label>
        </rules>
    </decisions>
    <description>Created this flow as per the story : CRM-7303</description>
    <environments>Default</environments>
    <formulas>
        <name>FreightDOMCheck</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL({!$Record.Account.New_Account_Type__c}, &apos;Freight-Branch&apos;),
NOT(ISNEW()),
{!$Record.Account.Freight_Email_Sent__c} == False,
ISPICKVAL({!$Record.Account.Freight_Revenue_Stream__c}, &apos;DOM&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>FreightINTAccount</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL({!$Record.Account.New_Account_Type__c}, &apos;Freight-Branch&apos;),
NOT(ISNEW()),
{!$Record.Account.Freight_Email_Sent__c} == False,
ISPICKVAL({!$Record.Account.Freight_Revenue_Stream__c}, &apos;INT&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>FreightINTAndDOMcheck</name>
        <dataType>Boolean</dataType>
        <expression>AND(
ISPICKVAL({!$Record.Account.New_Account_Type__c}, &apos;Freight-Branch&apos;),
NOT(ISNEW()),
{!$Record.Account.Freight_Email_Sent__c}== False  
)</expression>
    </formulas>
