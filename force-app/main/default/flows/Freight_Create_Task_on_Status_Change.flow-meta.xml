    <description>This flow is used to create task when quote status is presented for more than or equal to 4 days.
CRM-9760</description>
    <environments>Default</environments>
    <formulas>
        <name>CCRecipients</name>
        <dataType>String</dataType>
        <expression>{!$Record.Opportunity.Owner.Email}</expression>
    </formulas>
    <formulas>
