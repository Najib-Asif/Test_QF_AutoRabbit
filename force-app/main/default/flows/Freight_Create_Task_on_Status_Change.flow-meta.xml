    <formulas>
        <name>DynamicQuoteSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Follow-up Quote &apos;+{!$Record.Name}+&apos; with &apos;+{!$Record.Opportunity.Account.Name}</expression>
    </formulas>
    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>&apos;Hello &apos; + {!$Record.Freight_Contact_Name__c} + &apos;, &lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Re recent quote&apos; + &apos; &apos; + {!$Record.QuoteNumber} +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Following on from the recent quote we sent you (copy attached).  If you need any help or have questions regarding the quote or would like to accept the quote, please let me know as soon as possible.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;A reminder that quotes have limited validity and may change or need to be requoted if not accepted within the original validity period, noted on the quote document.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;In order to secure capacity please make a booking online and ensure the Freight Sales Support team are advised of the AWB number by email to &lt;a href=&quot;mailto:freightsalessupport@qantas.com.au&quot;&gt;freightsalessupport@qantas.com.au&lt;/a&gt;.  Please note Spot Rates cannot be applied retrospectively.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Please let me know if you have any questions.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Regards&apos;+&apos;&lt;br/&gt;&apos;+
{!$Record.Owner:User.FirstName} + &apos; &apos; + {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <name>EmailBodyForReminderEmail</name>
        <dataType>String</dataType>
        <expression>IF (ISPICKVAL({!$Record.Owner:User.CountryCode}, &apos;NZ&apos;), {!EmailBodyNZ}, {!EmailBody})</expression>
    </formulas>
    <formulas>
        <name>EmailBodyNZ</name>
        <dataType>String</dataType>
        <expression>&apos;Hello &apos; + {!$Record.Freight_Contact_Name__c} + &apos;, &lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Re recent quote&apos; + &apos; &apos; + {!$Record.QuoteNumber} +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Following on from the recent quote we sent you (copy attached).  If you need any help or have questions regarding the quote or would like to accept the quote, please let me know as soon as possible.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;A reminder that quotes have limited validity and may change or need to be requoted if not accepted within the original validity period, noted on the quote document.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;In order to secure capacity please make a booking online and ensure the Freight Sales Support team are advised of the AWB number by email to &lt;a href=&quot;mailto:aucklandfreight@qantas.com.au&quot;&gt;aucklandfreight@qantas.com.au&lt;/a&gt;.  Please note Spot Rates cannot be applied retrospectively.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Please let me know if you have any questions.&apos; +&apos;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;&apos;+
&apos;Regards&apos;+&apos;&lt;br/&gt;&apos;+
{!$Record.Owner:User.FirstName} + &apos; &apos; + {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <name>HistoryTrackDateValue</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>MaximumDate</name>
        <dataType>Boolean</dataType>
        <expression>TODAY() - {!$Record.History_Track_Date__c} &gt;=1</expression>
    </formulas>
    <formulas>
