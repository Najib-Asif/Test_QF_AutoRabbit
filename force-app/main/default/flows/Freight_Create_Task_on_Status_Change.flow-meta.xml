    </formulas>
    <formulas>
        <name>Subject</name>
        <dataType>String</dataType>
        <expression>&apos;Re recent quote&apos; + &apos; &apos;  +{!$Record.QuoteNumber}</expression>
    </formulas>
    <formulas>
        <name>subject1</name>
        <dataType>String</dataType>
        <expression>&quot;Rate valid after acceptance to &quot; &amp;
IF(
    ISBLANK({!$Record.Rate_Valid_after_acceptance_until__c}),
    &quot;&quot;,
    TEXT({!$Record.Rate_Valid_after_acceptance_until__c})
)</expression>
    </formulas>
    <formulas>
