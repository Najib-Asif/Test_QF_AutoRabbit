    <decisions>
        <name>Check_if_Quote_status_is_still_Presented</name>
        <label>Check if Quote status is still Presented?</label>
        <locationX>710</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Presented</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Presented</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_attachment_from_Quote</targetReference>
            </connector>
            <label>Presented</label>
        </rules>
    </decisions>
