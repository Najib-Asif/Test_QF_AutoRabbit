    <description>To update the Account&apos;s Last Completed Account Review Date from Activity</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND ( 
ISPICKVAL([Task].Status , &quot;Completed&quot;),
ISPICKVAL([Task].Subtype__c , &quot;Account Review&quot;),
CONTAINS ( [Task].Created_by_Reporting_Team__c , &quot;QIS&quot;),
NOT(ISNULL([Task].WhatId)),
LEFT([Task].WhatId, 3) = &apos;001&apos;
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
