    <decisions>
        <name>Check_Lead_ParentAccountID_and_Salescockpit_Exists</name>
        <label>Check Lead ParentAccountID  and Salescockpit Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Validate_Lead_Parent_AccountID_And_SalescockpitID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SC_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_status_to_Qualified</targetReference>
            </connector>
            <label>Validate Lead Parent AccountID And SalescockpitID</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validate_Parent_Account_Region</name>
        <label>Validate Parent Account Region</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AU_NZ_Region</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent_Account__r.Freight_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AU_NZRegion</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_for_AU_and_NZ_Region</targetReference>
            </connector>
            <label>AU_NZ Region</label>
        </rules>
        <rules>
            <name>Asia_US_Region</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent_Account__r.Freight_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>US_Region</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent_Account__r.Freight_Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Asia_Region</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_for_Asia_and_US_Region</targetReference>
            </connector>
            <label>Asia_US Region</label>
        </rules>
    </decisions>
    <description>This flow auto creating opportunity for Freight Salescockpit</description>
    <environments>Default</environments>
    <formulas>
        <name>ExpectedClosedDate</name>
        <dataType>Date</dataType>
        <expression>$Record.CreatedDate + 30</expression>
    </formulas>
    <formulas>
        <name>OpportunityName</name>
        <dataType>String</dataType>
        <expression>&quot;ZZ-&quot; &amp;{!$Record.Freight_Origin__c}  &amp; &quot;-&quot; &amp;{!$Record.Freight_Destination__c} &amp; &quot; &quot; &amp;{!$Record.Parent_Account__r.Name}</expression>
    </formulas>
    <formulas>
        <name>OriginandDestination</name>
        <dataType>String</dataType>
        <expression>{!$Record.Freight_Origin__c} &amp;&apos;-&apos; &amp;{!$Record.Freight_Destination__c}</expression>
    </formulas>
    <interviewLabel>Auto Convert from Lead to Opportunity for SC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LeadAfterTriggerFlow To Auto Convert from Lead to Opportunity for Salescockpit</label>
