<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Add all the flight Events to the collection variable FlightEventstoUpdate</description>
        <name>Add_the_Flight_Events_to_the_Collection_Variable</name>
        <label>Add the Flight Events to the Collection Variable</label>
        <locationX>918</locationX>
        <locationY>140</locationY>
        <assignmentItems>
            <assignToReference>FlightEventstoUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>FlightEvent</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Traverse_Selected_Flight_Events</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assign selected Global Event to Flight Event</description>
        <name>Assign_Global_Event_to_Flight_Event</name>
        <label>Assign Global Event to Flight Event</label>
        <locationX>674</locationX>
        <locationY>53</locationY>
        <assignmentItems>
            <assignToReference>FlightEvent.GlobalEvent__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GlobalEventId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_the_Flight_Events_to_the_Collection_Variable</targetReference>
        </connector>
    </assignments>
    <description>Flow to add selected Flight events from the list view to a global event</description>
    <dynamicChoiceSets>
        <name>CheckNull</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ed</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>Get Flight Events(Global Event Record Types)</description>
        <name>FlightEvents</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>Global_Event_Name</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeName__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>GlobalEvent</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <outputAssignments>
            <assignToReference>GlobalEventId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>testflightevents</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <stringValue>QF0002</stringValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeName__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>GlobalEvent</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <formulas>
        <name>checkRecordchoice</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!FlightEvents})</expression>
    </formulas>
    <interviewLabel>QCC_AddtoGlobalEvent {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Add to Global Event</label>
    <loops>
        <name>Traverse_Selected_Flight_Events</name>
        <label>Traverse Selected Flight Events</label>
        <locationX>486</locationX>
        <locationY>58</locationY>
        <assignNextValueToReference>FlightEvent</assignNextValueToReference>
        <collectionReference>selectedFlightEvents</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Global_Event_to_Flight_Event</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Flight_Events</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Get the Selected Global Event record from flight Events</description>
        <name>Get_Selected_Global_Event</name>
        <label>Get Selected Global Event</label>
        <locationX>481</locationX>
        <locationY>239</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GlobalEventId</elementReference>
            </value>
        </filters>
        <object>Event__c</object>
        <outputAssignments>
            <assignToReference>GlobalEventId</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>GlobalEventName</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <description>Update Flight Events with Selected Global Events</description>
        <name>Update_Flight_Events</name>
        <label>Update Flight Events</label>
        <locationX>684</locationX>
        <locationY>255</locationY>
        <connector>
            <targetReference>Get_Selected_Global_Event</targetReference>
        </connector>
        <inputReference>FlightEventstoUpdate</inputReference>
    </recordUpdates>
    <screens>
        <name>Select_Flight_Event</name>
        <label>Select Flight Event</label>
        <locationX>318</locationX>
        <locationY>53</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Traverse_Selected_Flight_Events</targetReference>
        </connector>
        <fields>
            <name>Please_select_Global_Event</name>
            <choiceReferences>FlightEvents</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Please select Global Event or Enter valid name and search again</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Show_FE_and_GE_Lookup</name>
        <label>Show FE and GE Lookup</label>
        <locationX>186</locationX>
        <locationY>48</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Select_Flight_Event</targetReference>
        </connector>
        <fields>
            <name>Global_Event_Name</name>
            <dataType>String</dataType>
            <fieldText>Global Event Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>325</locationX>
        <locationY>242</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>MessagetotheUser</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Flight Events were Successfully added to the Global Event!&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;a href=&quot;https://qantas.lightning.force.com/{!GlobalEventId}&quot; target=&quot;_blank&quot;&gt;{!GlobalEventName}&lt;/a&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>false</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>Show_FE_and_GE_Lookup</startElementReference>
    <status>Active</status>
    <variables>
        <description>Iteration Variable for collection of flight Events</description>
        <name>FlightEvent</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Event__c</objectType>
    </variables>
    <variables>
        <description>Holds The Flight Events  to be updated</description>
        <name>FlightEventstoUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Event__c</objectType>
    </variables>
    <variables>
        <description>Store the Id of Global Event selected from the Lookup</description>
        <name>GlobalEventId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Stores the Name of Selected Global Event</description>
        <name>GlobalEventName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>GlobalEventRecordTypeDeveloperName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>GlobalEvent</stringValue>
        </value>
    </variables>
    <variables>
        <description>Get the Selected Flight Events from the VisualForce page QCC_GetSelectedFlightEvents</description>
        <name>selectedFlightEvents</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Event__c</objectType>
    </variables>
    <variables>
        <description>Get the Selected Flight Events from the VisualForce page QCC_GetSelectedFlightEvents</description>
        <name>selectedFlightEventsId</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Testtext</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>default value for the record</stringValue>
        </value>
    </variables>
</Flow>
