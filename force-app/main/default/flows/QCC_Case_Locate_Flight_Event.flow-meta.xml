<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets the Case.Event field to blank if no matching record is found</description>
        <name>Remove_Flight_Event_Id</name>
        <label>Remove Flight Event Id</label>
        <locationX>938</locationX>
        <locationY>497</locationY>
        <assignmentItems>
            <assignToReference>CaseFlightEventId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Assigns the matching Flight Event to the Case.Event field.</description>
        <name>Set_Flight_Event_Id</name>
        <label>Set Flight Event Id</label>
        <locationX>668</locationX>
        <locationY>490</locationY>
        <assignmentItems>
            <assignToReference>CaseFlightEventId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Flight_Event.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks to see if the Case is found (this is a best practice to ensure that the Flow does not generate an error if the Case doesn&apos;t exist.)</description>
        <name>Check_Case</name>
        <label>Check Case</label>
        <locationX>369</locationX>
        <locationY>246</locationY>
        <defaultConnectorLabel>Case Doesn&apos;t Exist</defaultConnectorLabel>
        <rules>
            <name>Case_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Flight_Event</targetReference>
            </connector>
            <label>Case Exists</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks to see if the Flight Event is found (this is a best practice to ensure that the Flow does not generate an error if the record doesn&apos;t exist.)</description>
        <name>Check_Flight_Event</name>
        <label>Check Flight Event</label>
        <locationX>792</locationX>
        <locationY>248</locationY>
        <defaultConnector>
            <targetReference>Remove_Flight_Event_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Event Found</defaultConnectorLabel>
        <rules>
            <name>Event_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Flight_Event</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Flight_Event_Id</targetReference>
            </connector>
            <label>Event Found</label>
        </rules>
    </decisions>
    <description>The Flow is called from Process builder if one or more of Case Flight fields are changed.  The flow checks to see if a corresponding flight event exists and if found, adds the Flight Event ID to the case.</description>
    <interviewLabel>QCC_Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QCC_Case Locate Flight Event</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get the details of the existing case</description>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>171</locationX>
        <locationY>243</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets information of the matching Flight Event record, based on matching fields from the Case record.</description>
        <name>Get_Flight_Event</name>
        <label>Get Flight Event</label>
        <locationX>602</locationX>
        <locationY>243</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Flight_Event</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 OR 5)</filterLogic>
        <filters>
            <field>ArrivalPort__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Arrival_City__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>DeparturePort__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Departure_City__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>FlightNumber__c</field>
            <operator>Contains</operator>
            <value>
                <elementReference>Get_Case.Flight_Number__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Scheduled_Departure_Date_Time__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Departure_Date_system__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Scheduled_Departure_Date_Time__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Departure_Date_Time__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Event__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Case.Event Id with the matching Flight Event Id, or a blank value if no record is found.</description>
        <name>Update_Case</name>
        <label>Update Case</label>
        <locationX>778</locationX>
        <locationY>688</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Event__c</field>
            <value>
                <elementReference>CaseFlightEventId</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Case</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>CaseFlightEventId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
