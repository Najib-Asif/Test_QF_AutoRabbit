        </defaultConnector>
        <defaultConnectorLabel>Not Supported</defaultConnectorLabel>
        <rules>
            <name>Supported_RecType</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Baggage</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Complaints</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_recType_Query</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_recType_Medical</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Insurance</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Furtheractionrequired</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Elite</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Assistance</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Onthespot</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_RecType_Refund</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetCaseDetails.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>con_recType_Sensitive</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Missing_Info</targetReference>
            </connector>
            <label>Supported RecType</label>
        </rules>
