    <assignments>
        <description>increasing the count of affected passengers tagged with event comms variable.</description>
        <name>Assign_Event_Comms_Tagged_Pax_Count</name>
        <label>Assign Event Comms Tagged Pax Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>EventCommsTaggedAffectedPaxCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_the_Affected_Passengers</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>This varaiable will store the all the affected passengers count.</description>
        <name>Set_Affected_Pax_Count</name>
        <label>Set Affected Pax Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>affectedPaxCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Affected_Passengers_List</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_All_Affected_Pax_tagged_to_Event_Comms</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check wheterh Event Comms are created for this FE or not</description>
        <name>Check_Event_Comms_Record_Is_Present_or_Not</name>
        <label>Check Event Comms Record Is Present or Not?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Event_Comms_Records_Are_Not_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Event_Comms_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Event_Comms_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Affected_Passengers_List</targetReference>
            </connector>
            <label>Event Comms Exists</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check whether Flight Failure record is tagged to FE or not.</description>
        <name>Check_Flight_Failure_Record_is_Present_or_Not</name>
        <label>Check Flight Failure Record is Present or Not?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Flight_Failure_Record_Is_Not_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Flight_Failure_Record_is_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Flight_Failure_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Event_Comms_Records</targetReference>
            </connector>
            <label>Flight Failure Record is Present</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check whether Affected passengers are tagged to Flight Event or not</description>
        <name>Check_Flight_Has_Affected_Pax</name>
        <label>Check Flight Has Affected Pax?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Affected_Pax_Records_Are_Not_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Affected_Passengers_List</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_the_Affected_Passengers</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check Event comm was tagged to affected passenger?</description>
        <name>Check_Is_Event_Comm_tagged_to_Passenger_Or_Not</name>
        <label>Check Is Event Comm tagged to Passenger Or Not?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_the_Affected_Passengers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>EVent_Comm_tagged_to_Passenger</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_the_Affected_Passengers.EventCommunication__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Event_Comms_Tagged_Pax_Count</targetReference>
            </connector>
            <label>EVent Comm tagged to Passenger</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checking all the affected passengers were tagged to the event comms are not?</description>
        <name>Is_All_Affected_Pax_tagged_to_Event_Comms</name>
        <label>Is All Affected Pax tagged to Event Comms?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Affected_Pax_Records_Are_Not_Tagged_to_Event_Comms</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Tagged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>affectedPaxCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>EventCommsTaggedAffectedPaxCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Comments</targetReference>
            </connector>
            <label>Yes Tagged</label>
        </rules>
    </decisions>
    <description>CRM-9743: Validation of required steps on Flight Event submission
Validating Flight failure, Event comms, and Affected passengers records against Flight event record, before submitting the recoveries for approval.</description>
    <environments>Default</environments>
    <interviewLabel>QCC Flight Event Submit For Approval Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QCC Flight Event Submit For Approval Validation</label>
    <loops>
        <description>looping all the affected passengers, to get the event comms tagged affected passenger count.</description>
        <name>Loop_Through_the_Affected_Passengers</name>
        <label>Loop Through the Affected Passengers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Affected_Passengers_List</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Is_Event_Comm_tagged_to_Passenger_Or_Not</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Affected_Pax_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
