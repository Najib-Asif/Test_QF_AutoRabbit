<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>tagging Flight event to the matching flight failure record.</description>
        <name>Assign_Flight_Event_to_Flight_Failure_Record</name>
        <label>Assign Flight Event to Flight Failure Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CurrentFlightFailure.Flight_Event__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>CurrentFlightFailure.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_All_the_Flight_Failure_Records.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assignment_2</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_2</name>
        <label>Assignment 2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>collectionFlightFailure</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CurrentFlightFailure</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_All_the_Flight_Failure_Records</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checking the macthing Flight failure records exists or not.</description>
        <name>Is_Matching_Flight_Failure_Records_Exists</name>
        <label>Is Matching Flight Failure Records Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Flight Failure Records Not Exists</defaultConnectorLabel>
        <rules>
            <name>Flight_Failure_Records_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Flight_Failure_Record</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_All_the_Flight_Failure_Records</targetReference>
            </connector>
            <label>Flight Failure Records Exists</label>
        </rules>
    </decisions>
    <description>CDS-291: DRs - [TECH] - Link Flight Failures to Flight Event.</description>
    <environments>Default</environments>
    <formulas>
        <name>Flight_Number</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.FlightNumber__c}, 4)</expression>
    </formulas>
    <interviewLabel>QCC Populate Event On Flight Failure Record {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QCC Populate Event On Flight Failure Record</label>
    <loops>
        <description>Looping through the all the matching flight failure records</description>
        <name>Loop_All_the_Flight_Failure_Records</name>
        <label>Loop All the Flight Failure Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Existing_Flight_Failure_Record</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Flight_Event_to_Flight_Failure_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Flight_Failure_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Logging the error message.</description>
        <name>Log_Error_Msg</name>
        <label>Log Error Msg</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Business_Function_Name__c</field>
            <value>
                <stringValue>Flight Failure Tagging</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Error_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Exception_Type__c</field>
            <value>
                <stringValue>Get Element Failure</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FailedRecordID__c</field>
            <value>
                <elementReference>$Flow.CurrentRecord</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LoggedIn_User__c</field>
            <value>
                <elementReference>$User.Username</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>ErrorLogRecordTypeId</elementReference>
            </value>
        </inputAssignments>
        <object>Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Querying existing orphan Flight Failure record to tag the Flight event.</description>
        <name>Get_Existing_Flight_Failure_Record</name>
        <label>Get Existing Flight Failure Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Matching_Flight_Failure_Records_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Flight_Event__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Operating_Carrier__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Operational_Carrier__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Flight_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Flight_Number</elementReference>
            </value>
        </filters>
        <filters>
            <field>DepartureAirport__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DeparturePort__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ArrivalAirport__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ArrivalPort__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>DepartureDateLocal__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ScheduledDepDate__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FlightFailure__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>updating the Flight failure record with flight event.</description>
        <name>Update_Flight_Failure_Records</name>
        <label>Update Flight Failure Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Error_Msg</targetReference>
        </faultConnector>
        <inputReference>collectionFlightFailure</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Flight_Failure_Record</targetReference>
        </connector>
        <object>Event__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>collectionFlightFailure</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FlightFailure__c</objectType>
    </variables>
    <variables>
        <name>CurrentFlightFailure</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FlightFailure__c</objectType>
    </variables>
    <variables>
        <name>ErrorLogRecordTypeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>012Mo000000Tlht</stringValue>
        </value>
    </variables>
</Flow>
