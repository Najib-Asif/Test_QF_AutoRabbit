    <formulas>
        <name>isEFTRecovery</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!Get_Recovery_Record.Type__c},&apos;Payment (EFT)&apos;)</expression>
    </formulas>
    <formulas>
        <description>Process Status</description>
        <name>Process_Status</name>
        <dataType>String</dataType>
        <expression>	IF(
OR(

ISPICKVAL({!Get_Recovery_Record.Type__c}, &quot;Payment (EFT)&quot;),
ISPICKVAL({!Get_Recovery_Record.Type__c}, &quot;Ticket Refund EFT&quot;)
),
&quot;Payment Details Received&quot;,
IF(ISPICKVAL({!Get_Recovery_Record.Type__c}, &quot;Payment (Credit Card)&quot;),
&quot;Queued for Payment Processing&quot;,
IF(OR(
ISPICKVAL({!Get_Recovery_Record.Type__c}, &quot;Travel vouchers&quot;),
ISPICKVAL({!Get_Recovery_Record.Type__c}, &quot;Lounge Passes&quot;),
ISPICKVAL({!Get_Recovery_Record.Type__c}, &quot;Qantas Points&quot;)
),
&quot;Approved&quot;,
&quot;&quot;
)
)
)</expression>
    </formulas>
