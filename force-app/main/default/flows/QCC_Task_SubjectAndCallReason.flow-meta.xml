<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>CallType</name>
        <label>CallType</label>
        <locationX>616</locationX>
        <locationY>371</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Inbound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CallType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Inbound</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isTaskRelatedToFollowupSchedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Inbound_Task_Subject</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Inbound</label>
        </rules>
        <rules>
            <name>Outbound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isTaskRelatedToFollowupSchedule</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Outbound_Call_Reason</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Outbound</label>
        </rules>
    </decisions>
    <description>Added condition for updating the case only voice type

Agent Desktop / ADT-80: If the Call Reason is blank, update the Subject to &quot;Call&quot; but if the Call Reason is not blank, the Subject should be updated with the value of the Call Reason</description>
    <environments>Default</environments>
    <formulas>
        <description>Agent Desktop / ADT-80: Concatenate the values of Subject and Call Reason.</description>
        <name>InboundSubjectAndCallReason</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.QCC_On_Behalf_Caller_Type__c})),
{!$Record.QCC_On_Behalf_Caller_Type__c} + &apos; &apos; + {!$Record.QCC_Caller_Full_Name__c} + &apos; &apos; + {!$Record.QCC_Caller_Phone__c} + &apos; Called for &apos; + TEXT({!$Record.QCC_Call_Reason__c}), TEXT({!$Record.QCC_Call_Reason__c}))</expression>
    </formulas>
    <formulas>
        <name>isTaskRelatedToFollowupSchedule</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Record.Subject}, &apos;Callback Reminder&apos;)</expression>
    </formulas>
    <formulas>
        <name>OutboundSubjectAndCallReason</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK(TEXT({!$Record.QCC_Call_Reason__c}))),
&apos;Outbound Call for &apos; + TEXT({!$Record.QCC_Call_Reason__c}), &apos;Outbound Call&apos;)</expression>
    </formulas>
    <interviewLabel>QCC_Task_SubjectAndCallReason {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QCC Task SubjectAndCallReason</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Agent Desktop / ADT-80: Update the Subject every time the Call Reason is updated. &quot;Subject - Call Reason&quot;. Example: &quot;Call - Refunds&quot;</description>
        <name>Update_Inbound_Task_Subject</name>
        <label>Update Inbound Task Subject</label>
        <locationX>484</locationX>
        <locationY>479</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>InboundSubjectAndCallReason</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Agent Desktop / ADT-80: Update the Subject every time the Call Reason is updated. &quot;Subject - Call Reason&quot;. Example: &quot;Call - Refunds&quot;</description>
        <name>Update_Outbound_Call_Reason</name>
        <label>Update Outbound Call Reason</label>
        <locationX>748</locationX>
        <locationY>477</locationY>
        <connector>
            <targetReference>UpdateCaseRecord</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>OutboundSubjectAndCallReason</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UpdateCaseRecord</name>
        <label>UpdateCaseRecord</label>
        <locationX>620</locationX>
        <locationY>667</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Voice</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Case_Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Case_Subject</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>490</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>CallType</targetReference>
        </connector>
        <filterLogic>(1 OR 2 ) AND 3 AND NOT(4)</filterLogic>
        <filters>
            <field>QCC_Call_Reason__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>QCC_Call_Reason__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TaskSubtype</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Callback Reminder</stringValue>
            </value>
        </filters>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Case_Description</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Case created for outbound call</stringValue>
        </value>
    </variables>
    <variables>
        <description>Storing the subject in this variable</description>
        <name>Case_Subject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Outbound Call</stringValue>
        </value>
    </variables>
</Flow>
