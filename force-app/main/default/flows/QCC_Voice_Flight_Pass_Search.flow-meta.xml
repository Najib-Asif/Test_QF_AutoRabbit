    <description>This flow is designed to be used for QCC Voice case to search for Exgratia Flight Pass Vouchers</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula validates that at least FF Number/PNR is required.</description>
        <name>FrequentFlyerOrPNRNumberRequired</name>
        <dataType>Boolean</dataType>
        <expression>IF( AND( ISBLANK({!FF_Number}), ISBLANK({!PNR_Number} ) ) ,true,false)</expression>
    </formulas>
