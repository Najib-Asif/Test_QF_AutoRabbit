    <formulas>
        <description>In case API call to Loyalty fails, assign Last Name by using the QFF Full Name from Genesys. This will however be overridden with correct value when the Contact record is viewed by an agent later on.</description>
        <name>finalFFLastName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_New_Frequent_Flyer_Details.ffDetails.lastName})), {!Get_New_Frequent_Flyer_Details.ffDetails.lastName}, {!varPassengerFullName})</expression>
    </formulas>
    <formulas>
        <name>formulaFullName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!varPassengerLastName}),  {!varPassengerFullName}, {!varPassengerFirstName} + &quot; &quot; + {!varPassengerLastName})</expression>
    </formulas>
