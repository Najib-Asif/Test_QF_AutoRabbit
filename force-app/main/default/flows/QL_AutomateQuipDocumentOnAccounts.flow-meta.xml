        <locationX>2096</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>EndTheFlow</defaultConnectorLabel>
        <rules>
            <name>CheckContractCommencementDate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contract_Commencement_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>ContractCommencementDate</elementReference>
                </rightValue>
            </conditions>
