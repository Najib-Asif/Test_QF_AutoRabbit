    <decisions>
        <description>This element checks if QUIP doc exists for an account.</description>
        <name>CheckIfQuipExists</name>
        <label>CheckIfQuipExists</label>
        <locationX>1326</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>CreateQuipDocumentNoTempChange</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>QuipDoesNotExists</defaultConnectorLabel>
        <rules>
            <name>QuipExists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quip__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RemoveQuipDocumentToRefresh</targetReference>
            </connector>
            <label>QuipExists</label>
        </rules>
    </decisions>
    <decisions>
        <description>This checks the contract commencement date of the account is greater than 2 months or not.</description>
        <name>CheckTheContractCommencementDate</name>
