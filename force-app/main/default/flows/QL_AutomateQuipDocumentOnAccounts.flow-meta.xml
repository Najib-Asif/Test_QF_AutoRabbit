    <description>CRM-5832
This flow checks the conditions for customer accounts that qualify to have QUIP documents created and create QUIP documents, and convert them into PDFs.</description>
    <environments>Default</environments>
    <formulas>
        <description>This formula adds two months into today&apos;s date.</description>
        <name>ContractCommencementDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(),-2)</expression>
    </formulas>
    <formulas>
        <description>Formula to compare today&apos;s date with flow run date.</description>
        <name>IfTodayIs1</name>
        <dataType>Boolean</dataType>
        <expression>DAY(TODAY()) == 1</expression>
    </formulas>
