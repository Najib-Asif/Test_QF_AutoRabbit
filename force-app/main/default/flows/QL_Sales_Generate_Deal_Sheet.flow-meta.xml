    <formulas>
        <name>congaTriggerFinalURL</name>
        <dataType>String</dataType>
        <expression>&apos;&amp;id=&apos; +  {!recordId} + {!CongaPDFURL} + {!categoryCongaURL} + {!recordId} + &apos;&amp;ofn=&apos; +  {!Get_Contract_Record.Deal_Sheet_Name__c} +&apos;&amp;SC1=SalesforceFile&apos;</expression>
    </formulas>
    <formulas>
        <name>fileName</name>
        <dataType>String</dataType>
        <expression>&apos;QantasDS &apos;+  {!dealSheetType} + &apos; - &apos; + {!Get_Case_Record.CaseNumber} + {!Get_Contract_Record.Account__r.Name} + &apos; - &apos; + TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
