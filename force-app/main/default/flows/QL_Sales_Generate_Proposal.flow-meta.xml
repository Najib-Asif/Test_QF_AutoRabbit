    <description>Flow used to enable Generate Proposal field and to display the merged file name.</description>
    <environments>Default</environments>
    <formulas>
        <name>fileName</name>
        <dataType>String</dataType>
        <expression>&apos;Qantas Proposal - &apos; + {!Get_Proposal_Record.Account__r.Name} + &apos; - &apos; + {!$User.FirstName} + &apos; - &apos; +  TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <interviewLabel>QL Sales Generate Proposal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QL Sales Generate Proposal</label>
