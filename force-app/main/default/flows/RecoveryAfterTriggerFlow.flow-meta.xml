        <rules>
            <name>Customer_Connect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer_Connect</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Record_is_Created_Or_Updated</targetReference>
            </connector>
