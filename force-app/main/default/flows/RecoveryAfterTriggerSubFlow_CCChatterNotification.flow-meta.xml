    <decisions>
        <name>Recovery_Status_Check</name>
        <label>Recovery Status Check</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Finalised_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewRecovery.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Finalised</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Post_Recovery_Finalised_msg_to_Case</targetReference>
            </connector>
            <label>Finalised Status</label>
        </rules>
        <rules>
            <name>Finalisation_Declined_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>objNewRecovery.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Finalisation Declined</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Post_Recovery_Finalisation_Declined_msg_to_Case</targetReference>
            </connector>
            <label>Finalisation Declined Status</label>
        </rules>
    </decisions>
    <description>migrated from LoyaltyAPIHelper.invokeLoyaltyAPI future class</description>
    <environments>Default</environments>
    <formulas>
        <name>chatterMsg</name>
        <dataType>String</dataType>
        <expression>IF ( ISPICKVAL({!objNewRecovery.Status__c} , &apos;Finalised&apos;), &apos;Loyalty API call successful after Attempt # noofAttemptsCount&apos;, IF (ISPICKVAL({!objNewRecovery.Status__c}, &apos;Finalisation Declined&apos;), &apos;Loyalty API call unsuccessful Attempt # objNewRecovery.API_Attempts__c \n noFFMsg&apos;,&apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>noFFMsg</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!objNewRecovery.FF_Number__c}), &apos;Frequent Flyer Number not available&apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>noofAttemptsCount</name>
        <dataType>Number</dataType>
        <expression>{!objNewRecovery.API_Attempts__c} + 1</expression>
        <scale>2</scale>
    </formulas>
