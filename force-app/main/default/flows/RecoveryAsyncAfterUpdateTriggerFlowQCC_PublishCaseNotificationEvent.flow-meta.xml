                </rightValue>
            </conditions>
            <connector>
                <targetReference>Parent_CaseId_Assignment</targetReference>
            </connector>
            <label>Has Parent Case</label>
        </rules>
    </decisions>
    <description>CRM-8421: Publish Request Tracker Notification Platform Event</description>
    <environments>Default</environments>
    <formulas>
        <name>contactFFNumber</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!$Record.Case_Number__r.ParentId}), {!$Record.Case_Number__r.Contact.Frequent_Flyer_Number__c}, {!$Record.Case_Number__r.Parent.Contact.Frequent_Flyer_Number__c} )</expression>
    </formulas>
    <formulas>
        <name>Date120DaysBack</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 120</expression>
    </formulas>
    <formulas>
        <name>isReponseRequired</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!$Record.Case_Number__r.ParentId}), IF (ISBLANK(TEXT({!$Record.Case_Number__r.Is_Response_Requested__c})), &apos;Yes&apos;, TEXT({!$Record.Case_Number__r.Is_Response_Requested__c}) ),  IF (ISBLANK(TEXT({!$Record.Case_Number__r.Parent.Is_Response_Requested__c})), &apos;Yes&apos;, TEXT({!$Record.Case_Number__r.Parent.Is_Response_Requested__c}) )  )</expression>
    </formulas>
    <formulas>
        <name>isValidCaseCategory</name>
        <dataType>String</dataType>
        <expression>CASE( {!Get_Parent_Case_Record.Category__c},
&apos;Customer behaviour/Customer offload&apos;, &apos;invalid&apos;,
&apos;Customer Behaviour&apos;, &apos;invalid&apos;,
&apos;Medical - Assistance Provided&apos;,&apos;invalid&apos;,
&apos;Medical - Patient&apos;, &apos;invalid&apos;,
&apos;Customs/Immigration&apos;, &apos;invalid&apos;,
&apos;Theft&apos;, &apos;invalid&apos;,
&apos;valid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidCaseGroup</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Parent_Case_Record.Group__c},
&apos;GMC&apos;,&apos;invalid&apos;,
&apos;valid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidCaseOrigin</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Parent_Case_Record.Origin},
&apos;Social_Media&apos;, &apos;valid&apos;,
&apos;SHR QCC&apos;, &apos;valid&apos;,
&apos;Qantas.com&apos;, &apos;valid&apos;,
&apos;Phone&apos;,&apos;valid&apos;,
&apos;invalid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidCaseRecordType</name>
        <dataType>String</dataType>
        <expression>CASE ( {!Get_Parent_Case_Record.RecordType.Name},
&apos;CCC Complaints&apos;,&apos;valid&apos;,
&apos;CCC Baggage&apos;,&apos;valid&apos;,
&apos;CCC Insurance Letter Case&apos;, &apos;valid&apos;,
&apos;CCC Query&apos;,&apos;valid&apos;,
&apos;invalid&apos;
)</expression>
    </formulas>
    <formulas>
        <name>isValidRecoveryType</name>
        <dataType>String</dataType>
        <expression>CASE( {!$Record.Type__c},
&apos;Qantas Points&apos;, &apos;valid&apos;,
&apos;Domestic Qantas Club Lounge Passes&apos;, &apos;valid&apos;,
&apos;International Business Lounge Passes&apos;, &apos;valid&apos;,
&apos;Travel vouchers&apos;, &apos;valid&apos;,
&apos;Credit Card Refund&apos;, &apos;valid&apos;,
&apos;EFT Refund&apos;, &apos;valid&apos;,
&apos;Bag Repair&apos;,&apos;valid&apos;,
&apos;Bag Replacement&apos;, &apos;valid&apos;,
&apos;Payment (EFT)&apos;, &apos;valid&apos;,
&apos;Payment (Credit Card)&apos;, &apos;valid&apos;,
&apos;Lounge Passes&apos;, &apos;valid&apos;,
&apos;First Lounge Pass&apos;, &apos;valid&apos;,
&apos;invalid&apos;)</expression>
    </formulas>
