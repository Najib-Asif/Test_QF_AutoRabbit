    <decisions>
        <description>Checking the criterias to publish the Platform Event</description>
        <name>Check_Is_Valid_Case_to_Publish_the_PE</name>
        <label>Check Is Valid Case to Publish the PE</label>
        <locationX>506</locationX>
        <locationY>684</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Valid_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Number__r.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case_Number__r.Contact.Frequent_Flyer_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidRecoveryType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseOrigin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseGroup</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isValidCaseCategory</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>valid</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Case_Record.CreatedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Date120DaysBack</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isReponseRequired</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getJsonPayload</targetReference>
            </connector>
            <label>Yes Valid Case</label>
        </rules>
    </decisions>
    <decisions>
        <description>checking is recovery tagged to Child/Parent Cases</description>
        <name>Original_Case_Check</name>
