    <description>CDP2-603:Country to Currency mapping
Added note for Process status update from crcm check cdp2-521
CDP2-990 - populating top case</description>
    <environments>Default</environments>
    <formulas>
        <name>countryCode</name>
        <dataType>String</dataType>
        <expression>LEFT(TEXT({!$Record.Refund_POS_Country__c}), 2)</expression>
    </formulas>
    <formulas>
        <name>currentTime</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(TEXT(NOW()) , &apos;Z&apos;, &apos;&apos;) , &apos;/&apos;,&apos;-&apos;)</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>onlineAddedTrue</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!$Record.Payment_Details_Added_Manually__c}) &amp;&amp; NOT({!$Record.Payment_Details_Added_Online__c})</expression>
    </formulas>
    <formulas>
        <name>TopParentCase</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Case_Number__r.Top_Parent_Case__c})), {!$Record.Case_Number__r.Top_Parent_Case__c} , null)</expression>
    </formulas>
    <formulas>
        <name>varRecoverySystemLog</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;ul&gt;&lt;li&gt;&apos;+
{!currentTime}
+ &apos; (CRCM) &apos; 
+ &apos;&lt;span style=&quot;color:&apos; + &apos;red&apos; +&apos;;&quot;&gt; &apos; + &apos;FAILURE&apos;+&apos;&lt;/span&gt;&apos;
+ &apos; &apos; +{!$Record.CRCM_Message_log__c} 
+ &apos;&lt;/li&gt;&lt;/ul&gt;&apos;
+ {!$Record.Recovery_System_log__c}</expression>
    </formulas>
