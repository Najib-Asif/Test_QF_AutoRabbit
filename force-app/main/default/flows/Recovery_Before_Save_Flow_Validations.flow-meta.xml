    <description>CDP2-619 AC04
CDP2-903 Assigning Payment Details Received for Q.com
CDP2-1009 - update processing status for red app medical case in other recovery
CDP2 - 455 update process status condition
GW - Added exclusion for EFT recoveries created by qccapiintegrationuser for GW</description>
    <environments>Default</environments>
    <formulas>
        <name>capitalName</name>
        <dataType>String</dataType>
        <expression>UPPER({!$Record.Bank_Account_Name__c})</expression>
    </formulas>
    <formulas>
        <name>IsBankDetailsUpdated</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISCHANGED({!$Record.Bank_Account_Number__c}), ISCHANGED({!$Record.Bank_Name__c}), ISCHANGED({!$Record.Refund_POS_Country__c}), ISCHANGED({!$Record.Account_Type__c}), ISCHANGED({!$Record.Branch_Name__c}), ISCHANGED({!$Record.Branch_Number_BSB_Sort_Code__c}), ISCHANGED({!$Record.Branch_Swift_BIC_Code__c}), ISCHANGED({!$Record.IBAN__c}))</expression>
    </formulas>
    <formulas>
        <name>IsCaseClosed</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Case_Number__r.Status}, &apos;Closed&apos;)</expression>
    </formulas>
    <formulas>
        <name>MandatoryBankFieldsBlank</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!$Record.Bank_Account_Number__c}), ISBLANK({!$Record.Bank_Account_Name__c}), ISBLANK(TEXT({!$Record.Refund_POS_Country__c})))</expression>
    </formulas>
    <formulas>
        <name>QComIntegrationUser</name>
        <dataType>String</dataType>
        <expression>{!$CustomMetadata.Recovery_Configs__mdt.DefaultValue.QComIntegrationUser__c}</expression>
    </formulas>
    <formulas>
        <name>varIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
