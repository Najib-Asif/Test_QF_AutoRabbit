    <formulas>
        <name>finalEmail</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE(
      SUBSTITUTE(
        SUBSTITUTE(
          {!finalEmailHeaderFooter},
          &quot;{{{Recovery__c.Parent_Case__c}}}&quot;,
          {!Get_Recovery_Record.Parent_Case__c}
        ),
        &quot;{{{Recovery__c.Case_ReceivedDate__c}}}&quot;,
        TEXT(DAY({!Get_Recovery_Record.Case_ReceivedDate__c})) &amp; &quot; &quot; &amp;
        CASE(MONTH({!Get_Recovery_Record.Case_ReceivedDate__c}),
          1, &quot;January&quot;,
          2, &quot;February&quot;,
          3, &quot;March&quot;,
          4, &quot;April&quot;,
          5, &quot;May&quot;,
          6, &quot;June&quot;,
          7, &quot;July&quot;,
          8, &quot;August&quot;,
          9, &quot;September&quot;,
          10, &quot;October&quot;,
          11, &quot;November&quot;,
          12, &quot;December&quot;,
          &quot;&quot;
        ) &amp; &quot; &quot; &amp;
        TEXT(YEAR({!Get_Recovery_Record.Case_ReceivedDate__c}))
      ),
      &quot;{{{Recovery__c.Value__c}}}&quot;,
     &quot;AUD &quot; &amp;  TEXT({!Get_Recovery_Record.Value__c})
    ),
    &quot;{{{Recovery__c.Contact_First_Name__c}}}&quot;,
    {!Get_Recovery_Record.Contact_First_Name__c}
  ),
  &quot;{{{Recovery__c.Recovery_Reason__c}}}&quot;,
  {!recReason}
)</expression>
    </formulas>
    <formulas>
        <name>replacedEmail</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE(
      {!replacedEmailHeaderFooter},
      &quot;}}}&quot;, &quot;}&quot;
    ),
	&quot;{{{Recovery__c.Value__c&quot;,
  &quot;AUD &quot; &amp; &quot;{{{Recovery__c.Value__c&quot;),
    &quot;{{{Recovery__c&quot;, &quot;{!Get_Recovery_Record&quot;
  )</expression>
    </formulas>
