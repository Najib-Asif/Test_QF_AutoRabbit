    <decisions>
        <name>Criteria_Check</name>
        <label>Criteria Check</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Next_Day</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Is_Completed</name>
            <conditionLogic>1 OR 2 OR 3 OR NOT(4) OR 5</conditionLogic>
            <conditions>
                <leftValueReference>TaskRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TaskRecord.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TaskRecord.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Call Scheduled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PopupUserIds</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>TaskRecord.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TaskRecord.ActivityDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>DueDate</elementReference>
                </rightValue>
            </conditions>
            <label>Status Is Completed</label>
        </rules>
        <rules>
            <name>That_Day</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TaskRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TaskRecord.ActivityDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ThatDay</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Custom_Notification</targetReference>
            </connector>
            <label>That Day</label>
        </rules>
        <rules>
            <name>X1_Day_Before</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TaskRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TaskRecord.ActivityDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Tomorrow</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Custom_Notification_01</targetReference>
            </connector>
            <label>1 Day Before</label>
        </rules>
        <rules>
            <name>Overdue_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TaskRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TaskRecord.ActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>ThatDay</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Custom_Notification_02</targetReference>
            </connector>
            <label>Overdue Task</label>
        </rules>
    </decisions>
    <description>CRM-8105 - Implementation: Pop Up reminders of tasks</description>
