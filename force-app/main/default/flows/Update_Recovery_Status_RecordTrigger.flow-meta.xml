    <environments>Default</environments>
    <formulas>
        <name>currenttime</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE(TEXT(NOW()) , &apos;Z&apos;, &apos;&apos;) , &apos;/&apos;,&apos;-&apos;)</expression>
    </formulas>
    <formulas>
        <name>EFTMessageFormula</name>
        <dataType>String</dataType>
        <expression>IF(
	ISBLANK({!$Record.Claim_Status__c}) &amp;&amp; ISBLANK({!$Record.Findel_Approval_Date__c}),
	{!$Record.Recovery_System_log__c} , 
	&apos;&lt;ul&gt;&lt;li&gt;&apos; +{!currenttime} +&apos;  (EQ) Message: &apos; + {!$Record.Claim_Status__c} +IF(ISBLANK({!$Record.Claim_Status_Message__c}),&apos;&apos;,&apos; - &apos;)
	+{!$Record.Claim_Status_Message__c} 
       +IF(ISBLANK({!$Record.Claim_Status_Date__c}), &apos;&apos; , &apos; Date : &apos;+ TEXT({!$Record.Claim_Status_Date__c}) )
	+ IF(ISBLANK({!$Record.Findel_Approval_Date__c}),&apos;&apos;,&apos; Approval Date: &apos;) 
	+ TEXT({!$Record.Findel_Approval_Date__c}) 
	+IF(ISBLANK({!$Record.Findel_Approver__c}), &apos;&apos;,&apos; Approver Name: &apos;)
	+{!$Record.Findel_Approver__c} 
	+&apos;&lt;/li&gt;&lt;/ul&gt;&apos;+{!$Record.Recovery_System_log__c}
)</expression>
    </formulas>
    <formulas>
        <name>IsBankDetailsUpdated</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISCHANGED({!$Record.Bank_Account_Name__c}), ISCHANGED({!$Record.Bank_Account_Number__c}), ISCHANGED({!$Record.Bank_Name__c}), ISCHANGED({!$Record.Refund_POS_Country__c}), ISCHANGED({!$Record.Account_Type__c}), ISCHANGED({!$Record.Branch_Name__c}), ISCHANGED({!$Record.Branch_Number_BSB_Sort_Code__c}), ISCHANGED({!$Record.Branch_Swift_BIC_Code__c}), ISCHANGED({!$Record.IBAN__c}))</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>OTSProcessStatus</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Type__c}, &apos;Qantas Points&apos;), &apos;Submitted for Finalisation&apos;, IF(OR(ISPICKVAL({!$Record.Type__c}, &apos;QF_HOTEL_voucher&apos;),ISPICKVAL({!$Record.Type__c}, &apos;QF_WINE_voucher&apos;), ISPICKVAL({!$Record.Type__c}, &apos;No Goodwill&apos;)), &apos;Finalised&apos;, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>processstatus</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Claim_Status__c}, &apos;SUCCESS&apos;, &apos;Voucher Created&apos;, &apos;ERROR&apos;, &apos;Rejected&apos;,&apos;Rejected&apos;)</expression>
    </formulas>
    <formulas>
        <name>RecoverySystemLog</name>
        <dataType>String</dataType>
        <expression>&apos;&lt;ul&gt;&lt;li&gt;&apos;+
{!currenttime}
+ &apos; (DGCT) &apos; 
+ &apos;&lt;span style=&quot;color:&apos; + IF({!$Record.Claim_Status__c}= &apos;SUCCESS&apos;,&apos;green&apos;,&apos;red&apos;)+&apos;;&quot;&gt; &apos; + {!$Record.Claim_Status__c}+&apos;&lt;/span&gt;&apos;
+ IF({!$Record.Claim_Status__c}= &apos;SUCCESS&apos;,&apos; Batch Number :&apos;+{!$Record.Batch_Number__c},&apos;&apos;)
+ &apos; &apos; +{!$Record.Claim_Status_Message__c} 
+ &apos;&lt;/li&gt;&lt;/ul&gt;&apos;
+ {!$Record.Recovery_System_log__c}</expression>
    </formulas>
    <formulas>
        <name>TermsAndConditionsReplacedText</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Get_Terms_and_Conditions_Custom_Metadata.Text__c}, &apos;&lt;contact_full_name&gt;&apos;, {!$Record.Case_Number__r.First_Name__c} + &apos; &apos; +{!$Record.Case_Number__r.Last_Name__c})</expression>
    </formulas>
