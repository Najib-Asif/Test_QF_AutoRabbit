    <description>To update the auto created &apos;Store-Email&apos; contact when ever the Agency account email ID is changed.</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND( ISCHANGED([Account].Email__c),CONTAINS([Account].RecordType.Name, &quot;Agency&quot;),ISPICKVAL([Account].BillingCountryCode,&quot;AU&quot;))</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND( ISCHANGED({!myVariable_current.Email__c}),CONTAINS({!myVariable_current.RecordType.Name}, &quot;Agency&quot;),ISPICKVAL({!myVariable_current.BillingCountryCode},&quot;AU&quot;))</expression>
    </formulas>
