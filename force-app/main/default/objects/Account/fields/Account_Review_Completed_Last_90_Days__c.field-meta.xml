<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Review_Completed_Last_90_Days__c</fullName>
    <description>Formula to calculate if the account review is done in the last 90 days</description>
    <externalId>false</externalId>
    <formula>IF((DATEVALUE(NOW()) - DATEVALUE(Last_Completed_Account_Review__c))&lt;=90, 1, 0)</formula>
    <label>Account Review Completed Last 90 Days?</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
