<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dom_Incremental__c</fullName>
    <description>For Internal reporting of QIS Only. It uses the MS targets on publicis end.</description>
    <formula>IF (QF_Domestic_Market_Share__c != 0,(((QF_Domestic_Revenue__c / QF_Domestic_Market_Share__c)*0.01*78)-QF_Domestic_Revenue__c),null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Dom Incremental</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
