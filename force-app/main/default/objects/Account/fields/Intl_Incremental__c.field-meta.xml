<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Intl_Incremental__c</fullName>
    <description>For Internal reporting of QIS Only. It uses the MS targets on publicis end.</description>
    <formula>IF (QF_International_Market_Share__c!= 0,(((QF_International_Revenue__c/ QF_International_Market_Share__c)*0.01*65)-QF_International_Revenue__c),null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Intl Incremental</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
