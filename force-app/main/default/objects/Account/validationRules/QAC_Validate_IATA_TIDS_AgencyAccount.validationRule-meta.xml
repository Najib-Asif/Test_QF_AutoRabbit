<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QAC_Validate_IATA_TIDS_AgencyAccount</fullName>
    <active>true</active>
    <description>When entered IATA should contain only 7 digits of numeric characters for Agency Account</description>
    <errorConditionFormula>AND(RecordType.DeveloperName =&apos;Agency_Account&apos;, OR(AND(IF(NOT(ISNUMBER(IATA_Number__c)),true,IF(LEN(IATA_Number__c) &lt;&gt; 7,true,false)),NOT(ISBLANK(IATA_Number__c))),AND(IF(NOT(ISNUMBER(Agency_TIDS_Number__c)),true,IF(LEN(Agency_TIDS_Number__c) &lt;&gt; 7,true,false)),NOT(ISBLANK(Agency_TIDS_Number__c)))))</errorConditionFormula>
    <errorMessage>IATA#/TIDS# field should contain 7 digits Numeric characters</errorMessage>
</ValidationRule>
