<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QCC_Currency_should_be_mandatory</fullName>
    <active>true</active>
    <description>Setting up currency field as mandatory field on passenger</description>
    <errorConditionFormula>AND( 
(RecordType.DeveloperName = &apos;QCC_InsuranceLetter&apos;),
ISBLANK(TEXT(CurrencyIsoCode))

 )</errorConditionFormula>
    <errorMessage>Please enter the value for currency</errorMessage>
</ValidationRule>
