<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_To_Check_If_Status_Not_RevretedBack</fullName>
    <active>true</active>
    <description>To check if the Active Status is not reverted back to Draft Status</description>
    <errorConditionFormula>$Setup.EnableValidationRule__c.VR_To_Check_If_Status_Not_RevretedBack__c &amp;&amp;
(RecordType.DeveloperName =&apos;Public_Scheme&apos; || RecordType.DeveloperName =&apos;Corporate_Scheme&apos; ) &amp;&amp; 
ISPICKVAL(PRIORVALUE(Status) ,&apos;Active&apos;) &amp;&amp; (ISPICKVAL(Status ,&apos;Draft&apos;) || ISPICKVAL(Status ,&apos;Complete – Pending Activation&apos;))</errorConditionFormula>
    <errorMessage>You are not entitled to Change the Status from Active to Draft Status</errorMessage>
</ValidationRule>
