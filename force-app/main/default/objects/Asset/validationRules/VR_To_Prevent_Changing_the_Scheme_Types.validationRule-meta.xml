<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_To_Prevent_Changing_the_Scheme_Types</fullName>
    <active>false</active>
    <description>Validation Check to prevent changing of the scheme Records Types</description>
    <errorConditionFormula>$Setup.EnableValidationRule__c.VR_To_Prevent_Changing_the_Scheme_Types__c &amp;&amp;
ISCHANGED(RecordTypeId) &amp;&amp;  Move_to_Public_Scheme__c != true</errorConditionFormula>
    <errorMessage>You are not Entitled to Change the Scheme Types</errorMessage>
</ValidationRule>
