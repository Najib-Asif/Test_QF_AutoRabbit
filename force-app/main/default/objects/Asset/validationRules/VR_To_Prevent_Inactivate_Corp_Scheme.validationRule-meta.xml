<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_To_Prevent_Inactivate_Corp_Scheme</fullName>
    <active>true</active>
    <description>This will Preven Updating Status to Inactive from Active</description>
    <errorConditionFormula>($Setup.EnableValidationRule__c.VR_To_Prevent_Inactivate_Corp_Scheme__c || $UserRole.Name == &apos;QF_Support_QIC_Member&apos;)  &amp;&amp; RecordType.DeveloperName == &apos;Corporate_Scheme&apos; &amp;&amp; ISPICKVAL( PRIORVALUE(Status), &apos;Active&apos;) &amp;&amp; ISPICKVAL( Status, &apos;Inactive&apos;)</errorConditionFormula>
    <errorMessage>Corporate Scheme can&apos;t be moved to Inactive. Please raise a Corporate Scheme Service Request Case</errorMessage>
</ValidationRule>
