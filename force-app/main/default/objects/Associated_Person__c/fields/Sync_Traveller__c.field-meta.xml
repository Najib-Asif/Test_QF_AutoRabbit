<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sync_Traveller__c</fullName>
    <description>depends on &apos;Override&apos; system as well</description>
    <formula>AND( Active_Profile_Record__c, Active_QBD_Record__c, NOT(ISPICKVAL(QBD_Travel_Arranger__c,&apos;Y&apos;)), OR(Last_Name_Match__c,  Sync_Traveller_Override__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>This flag should be checked to ensure that the traveller record flows across to the downstream system.</inlineHelpText>
    <label>Sync Traveller [System]</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
