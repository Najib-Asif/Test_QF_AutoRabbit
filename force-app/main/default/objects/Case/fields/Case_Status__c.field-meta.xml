<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Status__c</fullName>
    <description>This field has been created to be used in Freight CSU reporting</description>
    <externalId>false</externalId>
    <formula>IF( CONTAINS(Text(Status) , &apos;Close&apos;),&apos;Closed&apos;,  IF( ISPICKVAL(Status, &apos;Open&apos;) , &apos;Open&apos;, &apos;Open&apos;) )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Case Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
