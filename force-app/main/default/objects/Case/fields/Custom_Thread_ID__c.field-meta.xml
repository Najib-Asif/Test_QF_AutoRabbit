<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Custom_Thread_ID__c</fullName>
    <description>Custom Thread ID used to solve issue with Conga Email templates and Email-to-Case responses not being attached to cases</description>
    <externalId>false</externalId>
    <formula>&quot;ref:_&quot; &amp; LEFT($Organization.Id,5) &amp; RIGHT($Organization.Id,5)&amp; &quot;._&quot; &amp; LEFT(Id,5) &amp; SUBSTITUTE(Left(RIGHT(Id,10), 5), &quot;0&quot;, &quot;&quot;) &amp; RIGHT(Id,5) &amp; &quot;:ref&quot;</formula>
    <label>Custom Thread ID</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
