<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>New_TMC_Name__c</fullName>
    <deleteConstraint>SetNull</deleteConstraint>
    <description>To capture the travel manager company name for the related account.</description>
    <inlineHelpText>Please use this to select customer&apos;s TMC, which is relevant for this case. For the required TMC to appear here for selection, it must associated with the customer Account</inlineHelpText>
    <label>New TMC Name Code</label>
    <lookupFilter>
        <active>true</active>
        <filterItems>
            <field>Account_Relation__c.Related_Account__c</field>
            <operation>equals</operation>
            <valueField>$Source.AccountId</valueField>
        </filterItems>
        <filterItems>
            <field>Account_Relation__c.Active__c</field>
            <operation>equals</operation>
            <value>True</value>
        </filterItems>
        <filterItems>
            <field>Account_Relation__c.Relationship__c</field>
            <operation>equals</operation>
            <value>Travel Manager Of</value>
        </filterItems>
        <infoMessage>Please click on &apos;All Fields&apos; option and search with the keyword &quot;travel&quot; to get the list of all TMCs associated with this customer account</infoMessage>
        <isOptional>false</isOptional>
    </lookupFilter>
    <referenceTo>Account_Relation__c</referenceTo>
    <relationshipLabel>Cases</relationshipLabel>
    <relationshipName>Cases</relationshipName>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Lookup</type>
</CustomField>
