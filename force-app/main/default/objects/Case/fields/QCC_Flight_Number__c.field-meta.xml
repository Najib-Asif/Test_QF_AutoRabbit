<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QCC_Flight_Number__c</fullName>
    <description>This field captures the flight number without the carrier code for Qantas Flights.</description>
    <externalId>false</externalId>
    <formula>VALUE(TRIM(IF (TEXT(Airline__c) =&apos;Qantas&apos;,SUBSTITUTE(SUBSTITUTE(UPPER(Flight_Number__c),&quot;QF&quot;,&quot;&quot;),&quot;A&quot;,&quot;&quot;),&apos;&apos;)))</formula>
    <label>QCC_Flight_Number</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
