<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Freight_Resolve_Reason_Subtype_Required</fullName>
    <active>false</active>
    <description>Freight - Resolve Reason is mandatory when Case Status is &quot;Resolved&quot; or &quot;Closed&quot;</description>
    <errorConditionFormula>AND(CONTAINS(RecordType.DeveloperName,&apos;Freight&apos;),  OR(ISPICKVAL(Status, &quot;Resolved&quot;), ISPICKVAL(Status, &quot;Closed&quot;)), 
ISPICKVAL(Resolved_Reasons_Sub_Type__c,&quot;&quot;),FCR__c = FALSE)</errorConditionFormula>
    <errorMessage>Please select a Resolve Reason and Resolved Reasons Sub Type</errorMessage>
</ValidationRule>
