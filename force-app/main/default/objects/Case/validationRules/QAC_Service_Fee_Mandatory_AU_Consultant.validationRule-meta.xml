<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QAC_Service_Fee_Mandatory_AU_Consultant</fullName>
    <active>false</active>
    <description>Make Service Fee and Service Fee Reason mandatory for AU based Consultants</description>
    <errorConditionFormula>AND(RecordType.DeveloperName ==&quot;QIC_Service_request&quot;, ISPICKVAL(Account.BillingCountryCode,&quot;AU&quot;),
NOT(ISPICKVAL (Service_Fee_Applies__c, &quot;Yes - Apply&quot;)),NOT(ISPICKVAL(Origin, &quot;QAC Website&quot;)),
$Setup.EnableValidationRule__c.VR_QAC_Mandate_Service_Fee__c =False,
OR(ISBLANK(TEXT(Service_Fee_Applies__c)),ISBLANK(TEXT( Service_Fee_Reason__c)),ISBLANK(TEXT(Travel_Type__c))))</errorConditionFormula>
    <errorDisplayField>ABN_Tax_Reference__c</errorDisplayField>
    <errorMessage>Travel Type, Service Fee and Service Fee Reason are mandatory for the AU Consultants!</errorMessage>
</ValidationRule>
