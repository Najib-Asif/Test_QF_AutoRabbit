<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QCC_Received_Date_Validation</fullName>
    <active>true</active>
    <description>QCC: received Date Cannot be in future</description>
    <errorConditionFormula>Received_Date__c &gt; NOW()</errorConditionFormula>
    <errorDisplayField>Received_Date__c</errorDisplayField>
    <errorMessage>Received Date Cannot be a Future Date</errorMessage>
</ValidationRule>
