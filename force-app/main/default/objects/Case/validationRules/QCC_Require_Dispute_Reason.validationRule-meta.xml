<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QCC_Require_Dispute_Reason</fullName>
    <active>false</active>
    <errorConditionFormula>QCC_Disputed_Recovery__c = TRUE 
&amp;&amp; 
LEN(QCC_Dispute_Reason__c ) &lt; 1</errorConditionFormula>
    <errorDisplayField>QCC_Dispute_Reason__c</errorDisplayField>
    <errorMessage>Dispute Reason must be complete if the recovery has been disputed.</errorMessage>
</ValidationRule>
