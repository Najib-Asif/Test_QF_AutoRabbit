<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PNR_Alphanumeric_6_Char_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(PNR__c, &quot;^[a-zA-Z0-9]{6}$&quot;))</errorConditionFormula>
    <errorMessage>The PNR field must contain exactly 6 alphanumeric characters.</errorMessage>
</ValidationRule>
