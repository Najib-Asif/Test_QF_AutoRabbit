<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mandatory_Qantas_Club_Discount_Offer</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Qantas_Club_Discount__c , &apos;Yes&apos;),  
OR(ISPICKVAL( Qantas_Club_Discount_Offer__c , &apos;&apos;),
ISPICKVAL(Qantas_Club_Join_Discount_Offer__c,&apos;&apos;)))</errorConditionFormula>
    <errorMessage>Please enter the value for Qantas Club Join Discount Offer,Qantas Club Member Discount Offer</errorMessage>
</ValidationRule>
