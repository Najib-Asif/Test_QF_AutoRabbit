<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mandatory_if_Group_ofer_is_yes</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL( Group_Travel_Offer__c , &quot;Yes&quot;) ,( ISBLANK( Forecast_Group_Booking_Expenditure__c )))</errorConditionFormula>
