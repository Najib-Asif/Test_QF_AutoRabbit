<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Entering_Upgrade_Offer</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL( Frequent_Flyer_Status_Upgrade__c , &apos;No&apos;), NOT(ISBLANK( Frequent_Flyer_Status_Upgrade_Offer__c )) )</errorConditionFormula>
    <errorDisplayField>Frequent_Flyer_Status_Upgrade_Offer__c</errorDisplayField>
    <errorMessage>Offer is not allowed</errorMessage>
</ValidationRule>
