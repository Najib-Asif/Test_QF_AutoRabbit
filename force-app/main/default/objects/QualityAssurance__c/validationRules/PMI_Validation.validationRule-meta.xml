<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMI_Validation</fullName>
    <active>true</active>
    <description>PMI Validation</description>
    <errorConditionFormula>Product_Knowledge__c &gt;= 7  || Information_Resources__c  &gt;= 7</errorConditionFormula>
    <errorMessage>One or both of the PMI scoring is wrong, please review the data and correct accordingly.</errorMessage>
</ValidationRule>
