<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EFT_Refund_Required_Account</fullName>
    <active>true</active>
    <description>Used to ensure the Refund Cost Centre field is complete before saving an EFT recovery</description>
    <errorConditionFormula>AND( $Setup.EnableValidationRule__c.VR_EFT_Refund_Required_Fields__c=TRUE, 
RecordType.DeveloperName = &apos;Customer_Connect&apos;,
AND(ISPICKVAL(Type__c, &apos;EFT Refund&apos;), 
								ISPICKVAL(Refund_Account__c, &apos;&apos;)
				    ))</errorConditionFormula>
    <errorDisplayField>Refund_Account__c</errorDisplayField>
    <errorMessage>Please complete this field</errorMessage>
</ValidationRule>
