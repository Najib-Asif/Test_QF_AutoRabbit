<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EFT_Refund_Required_Branch_Number</fullName>
    <active>true</active>
    <description>Used to ensure the Branch Number (BSB/Sort Code) field is complete before saving an EFT recovery</description>
    <errorConditionFormula>AND( $Setup.EnableValidationRule__c.VR_EFT_Refund_Required_Fields__c=TRUE, 
RecordType.DeveloperName = &apos;Customer_Connect&apos;,
AND(ISPICKVAL(Type__c, &apos;EFT Refund&apos;), 
								ISBLANK(Branch_Number_BSB_Sort_Code__c)
				    ))</errorConditionFormula>
    <errorDisplayField>Branch_Number_BSB_Sort_Code__c</errorDisplayField>
    <errorMessage>Please complete this field</errorMessage>
</ValidationRule>
