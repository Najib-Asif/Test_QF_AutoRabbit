<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Recovery_Required_Description</fullName>
    <active>true</active>
    <description>Created to ensure description is filled when Recovery Type = Other</description>
    <errorConditionFormula>AND( ISPICKVAL( Type__c , &apos;Other&apos;), ISBLANK( Description__c ) )</errorConditionFormula>
    <errorDisplayField>Description__c</errorDisplayField>
    <errorMessage>Please complete this field</errorMessage>
</ValidationRule>
