<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QCC_Replacement_Bag_Colour_Complete</fullName>
    <active>true</active>
    <description>Ensuring that Colour of bag is populated when replacement bag is the recovery type</description>
    <errorConditionFormula>IF( ISPICKVAL(Type__c, &apos;Bag Replacement&apos;), 
ISPICKVAL( Colour_of_Bag__c , &apos;&apos;),false 
)</errorConditionFormula>
    <errorDisplayField>Colour_of_Bag__c</errorDisplayField>
    <errorMessage>Complete this field</errorMessage>
</ValidationRule>
