<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QCC_Replacement_Bag_Size_Complete</fullName>
    <active>true</active>
    <description>Ensuring that size of bag is populated when replacement bag is the recovery type</description>
    <errorConditionFormula>IF( ISPICKVAL(Type__c, &apos;Bag Replacement&apos;), 
ISPICKVAL( Size_of_Bag_cm__c ,&apos;&apos;),false 
)</errorConditionFormula>
    <errorDisplayField>Size_of_Bag_cm__c</errorDisplayField>
    <errorMessage>Complete this field</errorMessage>
</ValidationRule>
