<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Department_Mandatory_on_User</fullName>
    <active>false</active>
    <description>Making &quot;Department&quot; field mandatory on user detail page</description>
    <errorConditionFormula>AND( 
ISBLANK( Department ) 
)</errorConditionFormula>
    <errorDisplayField>Department</errorDisplayField>
    <errorMessage>Please enter the value for Department</errorMessage>
</ValidationRule>
