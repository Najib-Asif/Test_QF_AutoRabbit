<apex:form > 
<apex:pageBlock title="AEQCC Rebate (last 3 Periods)">
<apex:pageBlockTable value="{!relatedCustObjRecs1}" var="aer"  columns="6" cellpadding="0" cellspacing="30" width="100%" columnclasses="col1,col2,col3,col4,col5,col6" headerclass="textalign" >
<apex:column width="30" headerClass="col1">              
                <apex:facet name="header" > <font color="blue"> Rebate Year </font> </apex:facet> 
                <apex:outputField value="{!aer.Rebate_Year__c}"> </apex:outputField>    
                <br>  </br> 
</apex:column>

<apex:column width="30" headerClass="col2" >              
                <apex:facet name="header" > <font color="blue"> Rebate Period </font> </apex:facet> 
                <apex:outputField value="{!aer.Rebate_term__c}"> </apex:outputField>    
                <br>  </br> 
</apex:column>

<apex:column width="40" headerClass="col3">              
                <apex:facet name="header" > <font color="blue"> Rebate Tier </font> </apex:facet> 
                <apex:outputField value="{!aer.Rebate_Tier__c}"> </apex:outputField>    
                <br>  </br> 
</apex:column>

<apex:column width="40" headerClass="col4">              
                <apex:facet name="header" > <font color="blue"> Rebate Payment </font> </apex:facet> 
                <apex:outputField value="{!aer.Rebate_Payment__c}"> </apex:outputField>    
                <br>  </br> 
</apex:column>

<apex:column width="40" headerClass="col5">              
                <apex:facet name="header"><font color="blue"> Rebate Cheque Amount </font> </apex:facet> 
                <apex:outputField value="{!aer.Cheque_Amount__c}"> </apex:outputField>    
                <br>  </br>
</apex:column>

<apex:column width="160" headerClass="col6">              
                <apex:facet name="header" > <font color="blue"> Rebate Sent to </font> </apex:facet> 
                 <apex:outputField value="{!aer.Rebate_Sent_to__c}"> </apex:outputField>    
                <br>  </br>
</apex:column>
    </apex:pageBlockTable>                    
  </apex:pageBlock> 
