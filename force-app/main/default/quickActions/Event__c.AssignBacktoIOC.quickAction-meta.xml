<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>QCC: Assign Flight Event To CJM</description>
    <fieldOverrides>
        <field>IsEventReopened__c</field>
        <formula>IF (TEXT(Event__c.Status__c) == &apos;Closed&apos;, TRUE, FALSE)</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>RecoveryPlanCompleted__c</field>
        <formula>False</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Status__c</field>
        <literalValue>Open</literalValue>
    </fieldOverrides>
    <fieldOverrides>
        <field>updateCheckForDelayTime__c</field>
        <formula>IF (TEXT(Event__c.Status__c) == &apos;Closed&apos;, TRUE, FALSE)</formula>
    </fieldOverrides>
    <label>Assign Back to IOC</label>
    <optionsCreateFeedItem>false</optionsCreateFeedItem>
    <quickActionLayout>
        <layoutSectionStyle>TwoColumnsLeftToRight</layoutSectionStyle>
        <quickActionLayoutColumns>
            <quickActionLayoutItems>
                <emptySpace>false</emptySpace>
                <field>ReasonForTakingBackEvent__c</field>
                <uiBehavior>Required</uiBehavior>
            </quickActionLayoutItems>
        </quickActionLayoutColumns>
        <quickActionLayoutColumns/>
    </quickActionLayout>
    <successMessage>Flight Event is Updated.</successMessage>
    <type>Update</type>
</QuickAction>
