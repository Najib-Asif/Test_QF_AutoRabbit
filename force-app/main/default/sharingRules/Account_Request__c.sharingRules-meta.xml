<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>SIP_Exception_Sharing_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Sales Performance Group needs to have access to all SIP Exception regardless of who owns them.</description>
        <label>SIP Exception Sharing Rule</label>
        <sharedTo>
            <group>Sales_Performance_Team</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>SIP Exception</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
