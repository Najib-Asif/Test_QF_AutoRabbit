<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Agency_Payments_shared_with_Account_Managers</fullName>
        <accessLevel>Read</accessLevel>
        <description>Sharing Agency Payment records with account managers</description>
        <label>Agency Payments shared with Account Managers</label>
        <sharedTo>
            <group>Agency_Account_Managers</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Approved Agency Payments,Agency Payments</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
