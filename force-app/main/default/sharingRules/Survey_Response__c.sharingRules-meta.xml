<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Freight_Survey_Response_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <description>This is created as a part of RBAC project. CRM-11026</description>
        <label>Freight Survey Response Sharing Rule</label>
        <sharedTo>
            <roleAndSubordinatesInternal>QF_Freight_Executive</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Freight,Freight Feedback</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
