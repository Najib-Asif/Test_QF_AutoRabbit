    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "DROP_FIELDS0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "RelevantActionedWithCase",
          "label" : "RelevantActionedDateWithCase",
          "formulaExpression" : "case when \"CaseHistory.Id\" is null\r\n\tthen CreatedDate\r\n\telse \"CaseHistory.RelevantActionedDate\"\r\nend",
          "format" : "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "DaysToAction",
          "label" : "DaysToAction",
          "formulaExpression" : "datediff(\"RelevantActionedWithCase\", CreatedDate)",
          "precision" : 3,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "SLAStatus",
          "label" : "SLA Status",
          "formulaExpression" : "case when DaysToAction>7 then 'SLA Unmet'\r\n    when (DaysToAction>=0 and DaysToAction<=7)  then 'SLA Met'\r\n    else 'NA'\r\nend",
          "precision" : 20,
          "defaultValue" : ""
        } ]
      }
    },
