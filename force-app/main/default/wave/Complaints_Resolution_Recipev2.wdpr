        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedBaggage",
          "label" : "CalculatedBaggage",
          "formulaExpression" : "case when contains(Group__c, 'Damaged') then Group__c\nwhen contains(Group__c, 'Delayed') then Group__c\nwhen contains(Category__c, 'Cabin') then Category__c\nelse 'Other Baggage'\nend",
