    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "APPEND1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedCategory",
          "label" : "Calculated Category",
          "formulaExpression" : "case when Group__c is not null then Group__c\nwhen Category__c is not null then Category__c\nwhen CalculatedBaggage is not null then CalculatedBaggage\nelse 'No Category Found'\nend",
