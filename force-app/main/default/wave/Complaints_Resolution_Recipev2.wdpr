    "FORMULA9" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedCategorisationReasoning",
          "label" : "CalculatedCategorisationReasoning",
          "formulaExpression" : "case when (\"ComplaintRefinedCategory.NewCategory\"='Policy' \n            OR \"ComplaintRefinedCategory.NewCategory\"='Product and Physical Environment' \n            OR \"ComplaintRefinedCategory.NewCategory\"='Flight Disruptions' OR \"ComplaintRefinedCategory.NewCategory\"='Loyalty Program') then Category__c\nwhen \"ComplaintRefinedCategory.NewCategory\"='Service Interaction' then Group__c\nwhen \"ComplaintRefinedCategory.NewCategory\"='Critical' then 'Critical Category'\nwhen (\"ComplaintRefinedCategory.NewCategory\"='Baggage' and Group__c='Damaged Baggage') then Group__c\nwhen \"ComplaintRefinedCategory.NewCategory\"='Baggage' and contains(Group__c, 'Delayed') then Group__c\nwhen Category__c is not null then Category__c\nwhen  Group__c is not null then Group__c\nelse 'Non Voice Default Category'\nend",
          "precision" : 100,
          "defaultValue" : ""
        } ]
      }
    },
