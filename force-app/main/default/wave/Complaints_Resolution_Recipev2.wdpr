    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "JOIN0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedCaseReason",
          "label" : "CalculatedCaseReason",
          "formulaExpression" : "case when Group__c is not null then Group__c\nwhen Category__c is not null then Category__c\nwhen contains(Group__c, 'Damaged') then Group__c\nwhen contains(Group__c, 'Delayed') then Group__c\nwhen contains(Category__c, 'Checked') then Category__c\nwhen Category__c is not null then 'Other Baggage'\nelse 'No Category Found'\nend",
          "precision" : 100,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA9" ],
