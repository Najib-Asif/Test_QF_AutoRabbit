    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN1" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ConsolidatedReason",
          "label" : "ConsolidatedReason",
          "formulaExpression" : "case when \"CaseWithORWithoutTasks.CalculatedCallReason\"!='No Reason Specified' then \"CaseWithORWithoutTasks.CalculatedCallReason\"\nwhen CalculatedCaseReason!='No Category Found' then CalculatedCaseReason\nelse \"CaseWithORWithoutTasks.CalculatedCallReason\"\nend",
          "precision" : 50,
          "defaultValue" : "No Reason Specified"
        } ]
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ConsolidatedReasoning2",
          "label" : "ConsolidatedReasoning2",
          "formulaExpression" : "case when \"CaseWithORWithoutTasks.CalculatedCallReason\"!='No Reason Specified' then \"CaseWithORWithoutTasks.CalculatedCallReason\"\nwhen CalculatedCategorisationReasoning!='No Category Found' then CalculatedCategorisationReasoning\nelse \"ComplaintRefinedCategory.NewCategory\"\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
