          "formulaExpression" : "case\r\nWhen contains(TextBody,'Your reference number is') then 'False'\r\nwhen contains(TextBody, '13 13 13') then 'Mention of 131313'\r\nwhen contains(TextBody, '1300 659 161') then 'Mention of 1300659161'\r\nwhen contains(TextBody, '1300 655 758') then 'Mention of 1300 655 758'\r\nwhen contains(TextBody, '1800 062 241') then 'Mention of 1800 062 241'\r\nwhen contains(TextBody, '1800 062 271') then 'Mention of 1800 062 271'\r\nwhen contains(TextBody, '1800 753 968') then 'Mention of 1800 753 968'\r\nwhen contains(TextBody, '1300 041 605') then 'Mention of 1300 041 605'\r\nwhen contains(TextBody, '1300 668 885') then 'Mention of 1300 668 885'\r\nwhen contains(TextBody, '1300 364 986') then 'Mention of 1300 364 986'\r\nwhen contains(TextBody, '1800 316 566') then 'Mention of 1800 316 566'\r\nwhen contains(TextBody, '1300 659 116') then 'Mention of 1300 659 116'\r\nwhen contains(TextBody, '1300 659 115') then 'Mention of 1300 659 115'\r\nwhen contains(TextBody, '1300 659 134') then 'Mention of 1300 659 134'\r\nwhen contains(TextBody, '1300 360 478') then 'Mention of 1300 360 478'\r\nwhen contains(TextBody, '13 74 78') then 'Mention of 137478'\r\nwhen contains(TextBody, '13 12 11') then 'Mention of 131211'\r\nwhen contains(TextBody, '1300 752 801') then 'Mention of 1300 752 801'\r\nwhen contains(TextBody, '1300 171 505') then 'Mention of 1300 171 505'\r\nwhen contains(TextBody, '1300 306 980') then 'Mention of 1300 306 980'\r\nwhen contains(TextBody, '+86 400 819 ') then 'Mention of +86 400 819'\r\nwhen contains(TextBody, '9495') then 'Mention of 9495'\r\nwhen contains(TextBody, '+442036842547') then 'Mention of +442036842547'\r\nwhen contains(TextBody, '+442036844034') then 'Mention of +442036844034'\r\nwhen contains(TextBody, '1300 655 202') then 'Mention of 1300 655 202'\r\nwhen contains(TextBody, '1300 799 798') then 'Mention of 1300 799 798'\r\nwhen contains(TextBody, '1300 659 117') then 'Mention of 1300 659 117'\r\nwhen contains