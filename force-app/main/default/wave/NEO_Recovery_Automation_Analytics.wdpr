          "formulaExpression" : "if(\"Reply_Received_Case_Hours\" = 0, (to_unix_timestamp(CreatedDate) - to_unix_timestamp(Previous_Status_Date))/3600, \"Reply_Received_Case_Hours\")\r\n",
          "precision" : 10,
          "scale" : 2,
          "defaultValue" : ""
        } ]
