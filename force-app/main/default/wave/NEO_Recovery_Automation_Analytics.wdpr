          "type" : "NUMBER",
          "name" : "Reply_Received_Case_Hours",
          "label" : "Reply Received Case Hours",
          "formulaExpression" : "if(\"OldValue\" = 'Reply Received' AND \"Count_History\" = 1, (to_unix_timestamp(CreatedDate) - to_unix_timestamp(\"Case.CreatedDate\"))/3600, 0)\r\n",
