          "name" : "UNIQUE_CaseIDTaskIDConcatenate2",
          "label" : "Unique CaseIDTaskIDConcatenate2"
        } ],
        "groupings" : [ "LatestTaskCreatedDate_extract", "CalculatedPNRContactIdConcat", "CaseOriginForFirstCaseCreated", "FirstCaseAssignedRole" ],
        "pivots" : [ ],
        "nodeType" : "STANDARD"
      }
    },
    "FILTER1" : {
      "action" : "filter",
      "sources" : [ "LOAD_DATASET2" ],
      "parameters" : {
        "filterExpressions" : [ {
          "type" : "DATETIME",
          "field" : "CreatedDate",
          "operator" : "GREATER_OR_EQUAL",
          "operands" : [ "1672531200000" ]
        }, {
          "type" : "TEXT",
          "field" : "Is_QCC_Case__c",
          "operator" : "EQUAL",
          "operands" : [ "true" ]
        }, {
          "type" : "TEXT",
          "field" : "RecordType.Name",
          "operator" : "EQUAL",
          "operands" : [ "CCC Voice" ]
        } ],
        "filterBooleanLogic" : "1 AND (2 OR 3)"
      }
    },
    "FORMULA1" : {
      "action" : "formula",
      "sources" : [ "JOIN0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedPNR",
          "label" : "CalculatedPNR",
          "formulaExpression" : "case when Booking_PNR__c is not null then upper(Booking_PNR__c)\n\t when \"Tasks.QCC_PNR__c\" is not null then upper(\"Tasks.QCC_PNR__c\")\n\telse 'PNR Not Found'\nend",
          "precision" : 20,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "partitionBy" : [ "CalculatedPNR" ],
        "orderBy" : [ {
          "fieldName" : "Tasks.CreatedDate",
          "direction" : "DESC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "DaysBetweenFirstAndLatestInteraction",
          "label" : "Days between First and Latest Interaction",
          "formulaExpression" : "(to_unix_timestamp(first_value(\"Tasks.CreatedDate\"))-to_unix_timestamp(last_value(\"Tasks.CreatedDate\")))/(60*60*24)",
          "precision" : 5,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "partitionBy" : [ "CalculatedPNR" ],
        "orderBy" : [ {
          "fieldName" : "Tasks.CreatedDate",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "FirstTaskCreatedDate",
          "label" : "FirstTaskCreatedDate",
          "formulaExpression" : "first_value(\"Tasks.CreatedDate\")",
          "format" : "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
          "defaultValue" : ""
        } ]
      }
    },
    "EXTRACT1" : {
      "action" : "extractGrains",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "grainExtractions" : [ {
          "source" : "FirstTaskCreatedDate",
          "targets" : [ {
            "name" : "FirstTaskCreatedDate_extract",
            "label" : "FirstTaskCreatedMonth",
            "grainType" : "MONTH"
          } ]
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "partitionBy" : [ "CalculatedPNR" ],
        "orderBy" : [ {
          "fieldName" : "Tasks.CreatedDate",
          "direction" : "DESC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "LatestTaskCreatedDate",
          "label" : "LatestTaskCreatedDate",
          "formulaExpression" : "first_value(\"Tasks.CreatedDate\")",
          "format" : "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
          "defaultValue" : ""
        } ]
      }
    },
    "EXTRACT2" : {
      "action" : "extractGrains",
      "sources" : [ "EXTRACT1" ],
      "parameters" : {
        "grainExtractions" : [ {
          "source" : "LatestTaskCreatedDate",
          "targets" : [ {
            "name" : "LatestTaskCreatedDate_extract",
            "label" : "LatestTaskCreatedMonth",
            "grainType" : "MONTH"
          } ]
        } ]
      }
    },
    "FORMULA5" : {
      "action" : "formula",
      "sources" : [ "EXTRACT2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedChannel",
          "label" : "CalculatedChannel",
          "formulaExpression" : "case \nwhen \"Tasks.CallType\"='Inbound' then 'Voice'\nwhen \"Tasks.CallType\"='Outbound' then 'Voice'\nelse 'Non Voice'\nend",
          "precision" : 10,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA7" : {
      "action" : "formula",
      "sources" : [ "FORMULA5" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedPNRContactIdConcat",
          "label" : "CalculatedPNRContactIdConcat",
          "formulaExpression" : "concat(CalculatedPNR,ContactId)",
          "precision" : 50,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA8" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA7" ],
      "parameters" : {
        "partitionBy" : [ "CalculatedPNRContactIdConcat" ],
        "orderBy" : [ {
          "fieldName" : "CreatedDate",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CaseOriginForFirstCaseCreated",
          "label" : "CaseOriginForFirstCaseCreated",
          "formulaExpression" : "first_value(Origin)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA10" : {
      "action" : "formula",
      "sources" : [ "FORMULA8" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CalculatedCallReason",
          "label" : "CalculatedCallReason",
          "formulaExpression" : "case when \"Tasks.QCC_Call_Reason__c\" is null then 'No Reason Specified' else \"Tasks.QCC_Call_Reason__c\"\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA11" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA10" ],
      "parameters" : {
        "partitionBy" : [ "CalculatedPNR" ],
        "orderBy" : [ {
          "fieldName" : "CreatedDate",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "FirstCaseAssignedRole",
          "label" : "FirstCaseAssignedRole",
          "formulaExpression" : "first_value(Created_by_Role__c)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA12" : {
      "action" : "formula",
      "sources" : [ "FORMULA11" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CaseIDTaskIDConcat",
          "label" : "CaseIDTaskIDConcat",
          "formulaExpression" : "concat(Id, \"Tasks.Id\")",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA13" : {
      "action" : "formula",
      "sources" : [ "FORMULA12" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CaseIDTaskIDConcatenate2",
          "label" : "CaseIDTaskIDConcatenate2",
          "formulaExpression" : "case when \"Tasks.Id\" is null then Id\nelse concat(Id,\"Tasks.Id\")\nend",
          "precision" : 50,
          "defaultValue" : ""
        } ]
