          "source" : "Tasks.Id",
          "name" : "UNIQUE_Tasks.Id",
          "label" : "Unique Activity ID"
        }, {
          "action" : "MAX",
          "source" : "DaysBetweenFirstAndLatestInteraction",
          "name" : "MAX_DaysBetweenFirstAndLatestInteraction",
          "label" : "Maximum Days between First and Latest Interaction"
        }, {
          "action" : "UNIQUE",
          "source" : "Origin",
          "name" : "UNIQUE_Origin",
          "label" : "Unique Case Origin"
        }, {
