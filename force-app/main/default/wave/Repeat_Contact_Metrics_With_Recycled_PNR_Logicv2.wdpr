        "fields" : [ {
          "type" : "TEXT",
          "name" : "LatestTaskCreatedMonthName",
          "label" : "LatestTaskCreatedMonthName",
          "formulaExpression" : "case\nwhen LatestTaskCreatedDate_extract='01' then 'Jan'\nwhen LatestTaskCreatedDate_extract='02' then 'Feb'\nwhen LatestTaskCreatedDate_extract='03' then 'Mar'\nwhen LatestTaskCreatedDate_extract='04' then 'Apr'\nwhen LatestTaskCreatedDate_extract='05' then 'May'\nwhen LatestTaskCreatedDate_extract='06' then 'Jun'\nwhen LatestTaskCreatedDate_extract='07' then 'Jul'\nwhen LatestTaskCreatedDate_extract='08' then 'Aug'\nwhen LatestTaskCreatedDate_extract='09' then 'Sep'\nwhen LatestTaskCreatedDate_extract='10' then 'Oct'\nwhen LatestTaskCreatedDate_extract='11' then 'Nov'\nwhen LatestTaskCreatedDate_extract='12' then 'Dec'\nend",
