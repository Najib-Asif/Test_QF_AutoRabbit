    "FORMULA0" : {
      "action" : "formula",
      "sources" : [ "JOIN0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Id_formula",
          "label" : "Wrap Up time",
          "formulaExpression" : "(to_unix_timestamp(LastModifiedDate)-to_unix_timestamp(CreatedDate))-CallDurationInSeconds",
          "precision" : 5,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
