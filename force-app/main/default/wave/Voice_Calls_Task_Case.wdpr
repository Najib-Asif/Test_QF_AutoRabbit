    "FORMULA2" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Calculated_PNR",
          "label" : "Calculated PNR",
          "formulaExpression" : "Case When \"Case.Booking_PNR__c\" is not null then upper(\"Case.Booking_PNR__c\") \r\n    else upper(\"QCC_PNR__c\")\r\nend",
          "precision" : 15,
          "defaultValue" : ""
        } ]
      }
    },
