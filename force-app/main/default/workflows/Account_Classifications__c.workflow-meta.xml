    <rules>
        <fullName>Uncheck the Joint AA Customer to False when end date is passed</fullName>
        <actions>
            <name>Update_Joint_AA_Customer_to_False</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Account_Classifications__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Account Classifications</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Classifications__c.Classification__c</field>
            <operation>equals</operation>
            <value>Joint Customer</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Classifications__c.Sub_Classification__c</field>
            <operation>equals</operation>
            <value>American Airlines</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Classifications__c.End_Date__c</field>
            <operation>lessOrEqual</operation>
            <value>TODAY</value>
        </criteriaItems>
        <description>Update Joint AA Customer to False when End date is less than today</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
