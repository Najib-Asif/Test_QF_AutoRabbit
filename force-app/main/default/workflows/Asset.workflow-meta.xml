    <rules>
        <fullName>WF_Corporate Scheme Notification to iFly</fullName>
        <actions>
            <name>Update_Ifly_Outbound_Notification_DateTi</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Asset_Corporate_Scheme_Sync_to_iFly</name>
            <type>OutboundMessage</type>
        </actions>
        <active>false</active>
        <description>notification is sent to a LSL system which further handles the request.
Excluded the change of &apos;Active Scheme Member Count&apos; field as part of CRM-5513</description>
        <formula>AND(   OR(ISPICKVAL(Status, &apos;Active&apos;), ISPICKVAL(Status, &apos;Inactive&apos;)),   NOT(ISBLANK(Scheme_Start_Date_f__c)),   OR(RecordType.DeveloperName =&apos;Public_Scheme&apos;, RecordType.DeveloperName =&apos;Corporate_Scheme&apos;),   NOT(ISCHANGED(Scheme_Active_Member_Count__c)) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>WF_To_Deactive Asset</fullName>
        <actions>
            <name>Update_active_to_False</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Asset.Status</field>
            <operation>notEqual</operation>
            <value>Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>Asset.RecordTypeId</field>
            <operation>equals</operation>
            <value>Corporate Scheme,Public Scheme</value>
        </criteriaItems>
        <description>Deactivate the Asset Checkbox when Status is not ACtive</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>WF_Update Mailing Names</fullName>
        <actions>
            <name>Update_Mailing_Name_1</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Mailing_Name_2</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Fulfillment system facilitates customizing the names. User can update the desired names on the packages. Currently a default split is used</description>
        <formula>AND( OR( RecordType.DeveloperName =&apos;Corporate_Scheme&apos;,  RecordType.DeveloperName =&apos;Public_Scheme&apos; ), OR( ISCHANGED( ContactId ), LEN(Mailing_Name_1__c) == 0 ) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>WF_Update Scheme Number</fullName>
        <actions>
            <name>Update_Scheme_Number</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Serial_Number_same_as_Scheme_Numb</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>copy the generated scheme number check digit to an external Id</description>
        <formula>AND( ISBLANK(Scheme_Number__c), OR( RecordType.DeveloperName =&apos;Corporate_Scheme&apos;, RecordType.DeveloperName =&apos;Public_Scheme&apos; ) )</formula>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
