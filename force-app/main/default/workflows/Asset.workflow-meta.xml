    <rules>
        <fullName>WF To Blank Threshold Start Date</fullName>
        <actions>
            <name>Update_Threshold_Date_to_Null</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Asset.Below_Threshold__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Asset.RecordTypeId</field>
            <operation>equals</operation>
            <value>Corporate Scheme,Public Scheme</value>
        </criteriaItems>
        <description>Workflow Rule to Set the Start Date of Threshold to Null when Below Threshold is FALSE</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>WF To Populate Corp Scheme Start Date From Contract</fullName>
        <actions>
            <name>Update_Scheme_StartDate_in_Corp_Scheme</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Rule to Populate the Scheme Start Date to Contract Start Date</description>
        <formula>RecordType.DeveloperName == &apos;Corporate_Scheme&apos; &amp;&amp;  ISPICKVAL(Status , &apos;Complete – Pending Activation&apos;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>WF To Populate Public Scheme Start Date</fullName>
        <actions>
            <name>Update_Scheme_StartDate_in_Public_Scheme</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Asset.RecordTypeId</field>
            <operation>equals</operation>
            <value>Public Scheme</value>
        </criteriaItems>
        <criteriaItems>
            <field>Asset.Status</field>
            <operation>equals</operation>
            <value>Complete – Pending Activation</value>
        </criteriaItems>
        <criteriaItems>
            <field>Asset.Public_Scheme_Start_Date__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>Rule to Populate the Scheme Start Date from Public scheme Start Date</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>WF To Populate Scheme Discount Type</fullName>
        <actions>
            <name>Update_Scheme_Discount_Type_from_Scheme</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>WF Rule to update the Scheme Discount Type when Scheme type Changes</description>
        <formula>AND( OR( RecordType.DeveloperName =&apos;Corporate_Scheme&apos;,  RecordType.DeveloperName =&apos;Public_Scheme&apos; ), OR( ISNEW(), AND(ISCHANGED(Override_Threshold__c),Override_Threshold__c), AND(ISCHANGED(Below_Threshold__c),NOT(Below_Threshold__c)), ISCHANGED(RecordTypeId) ) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>WF To Populate Threshold Start Date</fullName>
        <actions>
            <name>Update_Below_Threshold_Start_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Workflow Rule to Set the Start Date of Threshold to Today, when Below Threshold is TRUE</description>
        <formula>Below_Threshold__c</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>WF To ReCalculate fee on Wavier End Date</fullName>
