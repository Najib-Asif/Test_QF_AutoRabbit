    <rules>
        <fullName>Activate Marketing campaign on Start Date</fullName>
        <actions>
            <name>Update_Campaign_to_Active</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Activate Marketing campaign on Start Date</description>
        <formula>AND ( OR ((RecordType.DeveloperName = &apos;Marketing_Child&apos;),(RecordType.DeveloperName = &apos;Marketing_Parent&apos;)), StartDate &lt;= TODAY(),  EndDate &gt;= TODAY())</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Update_Campaign_to_Inactive</name>
                <type>FieldUpdate</type>
            </actions>
            <offsetFromField>Campaign.EndDate</offsetFromField>
            <timeLength>0</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Deactivate Marketing campaign on End Date</fullName>
        <actions>
            <name>Update_Campaign_to_Inactive</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>De-activate Marketing campaign on End Date</description>
        <formula>AND ( OR ((RecordType.DeveloperName = &apos;Marketing_Child&apos;),(RecordType.DeveloperName = &apos;Marketing_Parent&apos;)), StartDate &lt;= TODAY(), EndDate &gt;= TODAY())</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Email Notification regarding Campaign</fullName>
        <active>true</active>
        <description>Sending Email notification to the user regarding Campaign</description>
        <formula>AND (EndDate != null,$RecordType.DeveloperName=&apos;Loyalty_Commercial&apos;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Campaign_End_Date_Reached</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>Campaign.EndDate</offsetFromField>
            <timeLength>0</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>Total Campaign Budgeted Cost Update</fullName>
        <actions>
            <name>Total_Campaign_Budgeted_Cost_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Campaign.Type</field>
            <operation>equals</operation>
            <value>Incentive Budget</value>
        </criteriaItems>
        <description>When Type is selected to be  Incentive Budget, Total Campaign Budgeted Cost should be updated with value of Incentive Budget x Bounty Incentive Budget (%).</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Update expected reporting date</fullName>
        <actions>
            <name>Update_expected_reporting_date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Campaign.EndDate</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Campaign.Expected_Reporting_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>To set expected reporting date to 2 months from campaign end date</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update the Actual</fullName>
        <actions>
            <name>update_the_standard_Actual_field</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Campaign.RecordTypeId</field>
            <operation>equals</operation>
            <value>Marketing - Child</value>
        </criteriaItems>
        <description>To update the standard Actual field.</description>
        <triggerType>onAllChanges</triggerType>
    </rules>
