    <rules>
        <fullName>AU - Update Revenue Details</fullName>
        <actions>
            <name>Update_Latest_Period_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_QF_Domestic_Share</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_QF_International_Share</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_QF_Revenue</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>CampaignMember.Account_Name__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>CampaignMember.RecordTypeId</field>
            <operation>equals</operation>
            <value>Marketing - Event</value>
        </criteriaItems>
        <description>To update Revenue Details from Account to Campaign Member</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Campaign Member Status</fullName>
        <actions>
            <name>Member_Status_Last_Changed_By_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>status_change_update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND(Campaign.RecordType.Name = &quot;SME Campaigns&quot;,    ISCHANGED(Status) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>No of calls count</fullName>
        <actions>
            <name>No_of_calls_update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>CampaignMember.No_of_Calls__c</field>
            <operation>equals</operation>
            <value>0,1,2,3,4</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
