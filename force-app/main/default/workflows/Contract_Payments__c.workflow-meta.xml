<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>Update_Payment_Amount</fullName>
        <field>Payment_Amount__c</field>
        <formula>Amount__c</formula>
        <name>Update Payment Amount</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>CP_Automated notification for Contract Payments</fullName>
        <actions>
            <name>CP_Automated_notification_for_Contract_Payments</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <description>Automated notification for Contract Payments</description>
        <formula>AND( RecordType.DeveloperName = &apos;Corporate_Contract_Payments&apos;, ISPICKVAl(Contract_Agreement__r.Status__c,&apos;Signed by Customer&apos;), ISPICKVAL(Paid_As__c,&apos;Cash&apos;) )</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Payment Amount</fullName>
        <actions>
            <name>Update_Payment_Amount</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>To copy the Contract Payment:Amount to this field when the status is Draft,Approval required internal</description>
        <formula>AND( RecordType.DeveloperName = &apos;Corporate_Contract_Payments&apos;, OR( ISPICKVAL(Proposal__r.Status__c ,&apos;Draft&apos;), ISPICKVAL(Proposal__r.Status__c ,&apos;Approval Required - Internal&apos;) ) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <tasks>
        <fullName>CP_Automated_notification_for_Contract_Payments</fullName>
        <assignedToType>owner</assignedToType>
        <description>Reminder to setup customer as a supplier. Bank account details are required. Contact Sales Support for setup procedures.</description>
        <dueDateOffset>1</dueDateOffset>
        <notifyAssignee>false</notifyAssignee>
        <offsetFromField>Contract_Payments__c.CreatedDate</offsetFromField>
        <priority>Normal</priority>
        <protected>false</protected>
        <status>Not Started</status>
        <subject>Update the Invoice Details</subject>
    </tasks>
</Workflow>
