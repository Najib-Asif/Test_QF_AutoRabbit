    <rules>
        <fullName>Updating flight event status</fullName>
        <actions>
            <name>Set_status_to_Open</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>Update_Flight_Event_Owner</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>update_flight_info_to_open</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Event__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Flight Event - Active</value>
        </criteriaItems>
        <criteriaItems>
            <field>Event__c.Status__c</field>
            <operation>equals</operation>
            <value>Closed</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
