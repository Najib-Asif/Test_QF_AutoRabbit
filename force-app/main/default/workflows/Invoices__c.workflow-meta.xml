    <rules>
        <fullName>CP_Automated notification for Contract Payments</fullName>
        <actions>
            <name>CP_Update_the_Invoice_Details</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>Invoices__c.Payment_Due_Date_System__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Invoices__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>New Corporate Payments,Approved Corporate Payments</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>CP_Make Readonly upon Payment Processed</fullName>
        <actions>
            <name>CP_Make_Readonly_upon_Payment_Processed</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Invoices__c.Status__c</field>
            <operation>equals</operation>
            <value>Payment Processed</value>
        </criteriaItems>
        <criteriaItems>
            <field>Invoices__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>New Corporate Payments</value>
        </criteriaItems>
        <description>Make the layout as readonly once the payment has been processed</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
