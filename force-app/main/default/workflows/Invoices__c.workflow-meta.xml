    <rules>
        <fullName>QP Reminder for NAM Approved Invoices</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Invoices__c.RecordTypeId</field>
            <operation>equals</operation>
            <value>Agency Payments,Approved Agency Payments</value>
        </criteriaItems>
        <criteriaItems>
            <field>Invoices__c.Status__c</field>
            <operation>equals</operation>
            <value>NAM Approved</value>
        </criteriaItems>
        <description>Sales Performance Manager will be reminded to action approved Invoices 7 days after Payment Due Date</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>QP_NAM_Approved_Reminder</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>Invoices__c.Payment_Due_Date_System__c</offsetFromField>
            <timeLength>7</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
