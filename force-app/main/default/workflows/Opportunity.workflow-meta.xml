    <rules>
        <fullName>Opportunity Stage Update</fullName>
        <actions>
            <name>Opportunity_Stage_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Opportunity.Number_of_Proposals__c</field>
            <operation>equals</operation>
