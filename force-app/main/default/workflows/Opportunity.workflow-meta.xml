    <fieldUpdates>
        <fullName>Calculated_Amount_Update</fullName>
        <description>This updates the Amount field when the values used to calculated &quot;Annualised Deal Values&quot; are all inputted. e.g. customer base, Tag rate, price per point, point per $ , avg customer spend and probability adjustment</description>
        <field>Amount</field>
        <formula>(( Customer_Base__c * Assumed_Tag_Rate_at_Maturity__c )* ( Price_Per_Point__c * Points_Per__c * Average_Spend_Per_Customer__c ))*  Probability</formula>
        <name>Loyalty Calculated Amount Update</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
