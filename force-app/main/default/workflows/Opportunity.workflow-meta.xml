    </rules>
    <rules>
        <fullName>Loyalty Annualised Deal Check</fullName>
        <actions>
            <name>Calculated_Amount_Update</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Workflow to check that all values to calculate deal value is present, if so update the revenue amount with it</description>
        <formula>AND( $RecordType.DeveloperName = &quot;Loyalty_Commercial&quot;,  AND( NOT(ISBLANK( Customer_Base__c )), NOT(ISBLANK( Assumed_Tag_Rate_at_Maturity__c )),  NOT(ISBLANK( Price_Per_Point__c )),  NOT(ISBLANK( Points_Per__c )),  NOT(ISBLANK( Average_Spend_Per_Customer__c )),  NOT(ISBLANK(  Probability  )) ), OR( ISCHANGED(Customer_Base__c),  ISCHANGED(Assumed_Tag_Rate_at_Maturity__c), ISCHANGED(Price_Per_Point__c), ISCHANGED(Points_Per__c),  ISCHANGED(Average_Spend_Per_Customer__c),  NOT(ISBLANK( Probability )   )) )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
