        </actions>
        <active>true</active>
        <description>To Add ABN Detail from Account on Product registration creation</description>
        <formula>RecordType.DeveloperName = &apos;AMEX_Registration&apos; &amp;&amp;  (ISNEW() || Account__r.ABN_Tax_Reference__c !=  ABN__c)</formula>
