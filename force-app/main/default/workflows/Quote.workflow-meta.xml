    <alerts>
        <fullName>Quote_Approval_outcome</fullName>
        <description>Quote Approval outcome</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>All_email_templates_LD/Quote_approval_outcome</template>
    </alerts>
    <fieldUpdates>
        <fullName>Approval_submission</fullName>
        <description>Approval Submission date on quote</description>
        <field>Approval_Submission__c</field>
        <formula>TODAY ()</formula>
        <name>Approval submission</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Approved</fullName>
        <field>Status</field>
        <literalValue>Approved</literalValue>
        <name>Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Chatter_Post_approval_post_quote</fullName>
